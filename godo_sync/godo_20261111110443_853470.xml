<style>\r\n    /* DJI Premium Dynamic Theme - Terra x Modify Combo */\r\n    .dji-wrap { \r\n        width: 100%; max-width: 1000px; margin: 0 auto; \r\n        background-color: #000000; color: #ffffff; \r\n        font-family: \'Pretendard\', \'Malgun Gothic\', sans-serif; \r\n        word-break: keep-all; line-height: 1.6; overflow-x: hidden;\r\n    }\r\n\r\n    /* 1. Trust Badge */\r\n    .dji-badge { \r\n        background: #111111; border-bottom: 1px solid #333333; padding: 25px 20px; \r\n        display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 20px; \r\n    }\r\n    .dji-badge-title { font-size: 30px; font-weight: 900; letter-spacing: -1px; }\r\n    .dji-badge-sub { font-size: 16px; font-weight: 600; color: #888888; vertical-align: middle; margin-left: 8px; }\r\n    .dji-badge-desc { color: #bbbbbb; font-size: 14px; line-height: 1.5; max-width: 600px; }\r\n    .dji-badge-desc strong { color: #ffffff; font-size: 16px; }\r\n\r\n    /* 2. Hero Combo Section */\r\n    .dji-hero-combo { position: relative; width: 100%; height: 80vh; min-height: 600px; overflow: hidden; background-color: #000; }\r\n    .dji-hero-combo video { width: 100%; height: 100%; object-fit: cover; opacity: 0.5; }\r\n    .dji-hero-overlay {\r\n        position: absolute; top: 0; left: 0; width: 100%; height: 100%;\r\n        display: flex; flex-direction: column; justify-content: center; align-items: center;\r\n        background: linear-gradient(to top, #000000 0%, transparent 60%);\r\n        text-align: center; padding: 0 20px; animation: fadeInUp 1.5s ease-out forwards;\r\n    }\r\n    .dji-hero-title { font-size: 52px; font-weight: 900; letter-spacing: -2px; margin-bottom: 15px; text-shadow: 0 4px 20px rgba(0,0,0,0.8); line-height: 1.2; }\r\n    .dji-hero-sub { font-size: 20px; font-weight: 700; color: #10b981; letter-spacing: 1px; margin-bottom: 20px; }\r\n    .dji-hero-logos { display: flex; align-items: center; justify-content: center; gap: 20px; margin-bottom: 20px; }\r\n    .dji-hero-logos img { height: 40px; }\r\n    .dji-hero-logos span { font-size: 24px; color: #555; }\r\n\r\n    /* 3. Section Titles */\r\n    .dji-section-header { padding: 100px 20px 40px; text-align: center; border-top: 1px solid #222; background: #080808; }\r\n    .dji-section-sub { color: #10b981; font-size: 18px; font-weight: 700; margin-bottom: 10px; letter-spacing: 1px; text-transform: uppercase; }\r\n    .dji-section-title { font-size: 38px; font-weight: 900; margin-bottom: 20px; letter-spacing: -1px; }\r\n    .dji-section-desc { color: #aaaaaa; font-size: 17px; max-width: 800px; margin: 0 auto; }\r\n\r\n    /* 4. Features Grid */\r\n    .dji-features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; padding: 0 20px 60px; background: #080808; }\r\n    .dji-feature-card { \r\n        background: #141414; padding: 35px 25px; border-radius: 12px; border: 1px solid #2a2a2a; \r\n        text-align: left; transition: all 0.4s ease; box-shadow: 0 10px 30px rgba(0,0,0,0.3);\r\n    }\r\n    .dji-feature-card:hover { transform: translateY(-5px); border-color: #10b981; background: #1a1a1a; }\r\n    .dji-feature-title { font-size: 20px; font-weight: 800; margin-bottom: 12px; color: #ffffff; display: flex; align-items: center; gap: 10px; }\r\n    .dji-feature-title span { color: #10b981; font-size: 24px; }\r\n    .dji-feature-desc { color: #999999; font-size: 15px; margin: 0; line-height: 1.6; }\r\n\r\n    /* 5. Synergy Split Content */\r\n    .dji-split { display: flex; flex-wrap: wrap; align-items: center; padding: 80px 20px; gap: 50px; background: #000; border-top: 1px solid #222; }\r\n    .dji-split-img { flex: 1 1 400px; overflow: hidden; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.6); }\r\n    .dji-split-img video { width: 100%; display: block; border-radius: 16px; }\r\n    .dji-split-text { flex: 1 1 400px; }\r\n    .dji-split-text h4 { color: #10b981; font-size: 18px; margin-bottom: 10px; font-weight: 800; }\r\n    .dji-split-text h2 { font-size: 34px; font-weight: 900; margin-bottom: 20px; line-height: 1.3; }\r\n    .dji-split-text p { color: #bbbbbb; font-size: 16px; line-height: 1.7; margin-bottom: 15px; }\r\n\r\n    /* 6. Videos Double */\r\n    .dji-videos-sec { padding: 80px 20px; background: #0a0a0a; border-top: 1px solid #222; }\r\n    .dji-videos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; max-width: 960px; margin: 0 auto; }\r\n    .dji-video-box { text-align: center; }\r\n    .dji-video-box h3 { font-size: 20px; color: #fff; margin-bottom: 15px; }\r\n    .dji-video-wrap { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; border: 1px solid #333; }\r\n    .dji-video-wrap iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\r\n\r\n    /* 7. License Plan Tables */\r\n    .dji-plan-sec { padding: 80px 20px; background: #000; border-top: 1px solid #222; }\r\n    .dji-plan-title { font-size: 34px; font-weight: 900; text-align: center; margin-bottom: 10px; letter-spacing: -1px; }\r\n    .dji-plan-desc { text-align: center; color: #888; font-size: 15px; margin-bottom: 40px; }\r\n    \r\n    .dji-table-wrap { overflow-x: auto; margin: 0 auto 60px; max-width: 1000px; }\r\n    .dji-plan-table { width: 100%; min-width: 700px; border-collapse: collapse; font-size: 14px; text-align: center; }\r\n    .dji-plan-table caption { font-size: 22px; font-weight: 800; color: #10b981; text-align: left; margin-bottom: 15px; padding-left: 5px; }\r\n    .dji-plan-table th, .dji-plan-table td { padding: 14px; border-bottom: 1px solid #222; }\r\n    .dji-plan-table th { background: #111; color: #fff; font-weight: 700; font-size: 15px; border-bottom: 2px solid #333; }\r\n    .dji-plan-table td.feature-name { background: #0a0a0a; text-align: left; font-weight: 600; color: #ccc; width: 26%; }\r\n    .dji-plan-table th.highlight { color: #10b981; }\r\n    .dji-plan-table td .check { color: #10b981; font-weight: bold; font-size: 16px; }\r\n    .dji-plan-table td .cross { color: #666; font-weight: bold; font-size: 16px; }\r\n    .dji-plan-table tr:hover td { background: #141414; }\r\n\r\n    @keyframes fadeInUp { 0% { opacity: 0; transform: translateY(40px); } 100% { opacity: 1; transform: translateY(0); } }\r\n\r\n    /* Mobile Responsive */\r\n    @media (max-width: 768px) {\r\n        .dji-features, .dji-videos-grid { grid-template-columns: 1fr; }\r\n        .dji-split { gap: 40px; padding: 60px 20px; }\r\n        .dji-split-text h2 { font-size: 28px; }\r\n        .dji-hero-title { font-size: 40px; }\r\n        .dji-hero-logos img { height: 30px; }\r\n    }\r\n</style>\r\n\r\n<div class=\"dji-wrap\">\r\n\r\n    <div class=\"dji-badge\">\r\n        <div class=\"dji-badge-title\">DJI <span class=\"dji-badge-sub\">AUTHORIZED DEALER</span></div>\r\n        <div class=\"dji-badge-desc\">\r\n            <strong>DJI 공식 파트너 드론박스</strong><br>\r\n            본 온라인 공식 판매점에서 구입하신 제품은 DJI 코리아에서 제공하는 100% 정품입니다.\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-hero-combo\">\r\n        <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\">\r\n            <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/c582d481-bd80-43bd-80f9-3743fe63eb4b.mp4\" type=\"video/mp4\">\r\n        </video>\r\n        <div class=\"dji-hero-overlay\">\r\n            <h2 class=\"dji-hero-sub\">최강의 3D 매핑 &amp; 편집 콤보 패키지</h2>\r\n            <div class=\"dji-hero-logos\">\r\n                <img src=\"https://www-cdn.djiits.com/dps/6433a8b3683eb405c214b4533c38ee38.svg\" alt=\"DJI Terra\">\r\n                <span>✕</span>\r\n                <img src=\"https://www-cdn.djiits.com/dps/a52097010ae2b602af5e7b7cf76fc314.svg\" alt=\"DJI Modify\">\r\n            </div>\r\n            <h1 class=\"dji-hero-title\">항공 측량 워크플로우의<br>완벽한 마스터피스</h1>\r\n            <p style=\"color: #ccc; font-size: 18px; font-weight: 600; margin-top: 10px; max-width: 700px;\">\r\n                데이터 수집, 재구성, 후처리 편집, 그리고 클라우드 공유까지.<br>엔터프라이즈 산업을 위한 완벽한 원스톱 솔루션을 경험하십시오.\r\n            </p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-section-header\">\r\n        <h3 class=\"dji-section-sub\">Step 1. Reconstruction</h3>\r\n        <h2 class=\"dji-section-title\">DJI Terra : 세상을 디지털 자산으로</h2>\r\n        <p class=\"dji-section-desc\">\r\n            3D 가우시안 스플래팅 기술과 정밀 사진 측량, LiDAR 데이터 융합을 통해 압도적인 속도로 고정밀 2D 및 3D 모델을 구축합니다.\r\n        </p>\r\n    </div>\r\n    <div class=\"dji-features\">\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\"><span>🌟</span> 실사 수준 가우시안 스플래팅</h4>\r\n            <p class=\"dji-feature-desc\">투명한 유리, 식생 등 기존 사진 측량으로 어려웠던 미세 구조까지 사진급 퀄리티의 3D 모델로 렌더링합니다.</p>\r\n        </div>\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\"><span>🎯</span> 센티미터급 사진 및 LiDAR 측량</h4>\r\n            <p class=\"dji-feature-desc\">GCP 없이도 1:500 매핑 정확도를 달성하며, LiDAR 데이터와 가시광선 데이터를 유기적으로 연동합니다.</p>\r\n        </div>\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\"><span>⚡</span> 클러스터 재구성 (대규모 처리)</h4>\r\n            <p class=\"dji-feature-desc\">여러 컴퓨터를 연결해 초대형 매핑 데이터를 처리합니다. 30,000장의 사진을 단 21시간 만에 3D로 재구성합니다.</p>\r\n        </div>\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\"><span>🌾</span> 농업용 다중 스펙트럼 분석</h4>\r\n            <p class=\"dji-feature-desc\">NDVI, NDRE 등 식생 지수 지도를 생성하여 농작물의 생장을 분석하고 가변율 살포 처방 지도를 추출합니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-split\">\r\n        <div class=\"dji-split-img\">\r\n            <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\">\r\n                <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/7275b777-920a-4319-bea2-79c5ba326b30.mp4\" type=\"video/mp4\">\r\n            </video>\r\n        </div>\r\n        <div class=\"dji-split-text\">\r\n            <h4>Seamless Workflow</h4>\r\n            <h2>Terra에서 Modify로<br>매끄러운 원클릭 연동</h2>\r\n            <p>DJI Terra에서 3D 모델링 프로젝트를 완료한 후, 단 한 번의 클릭만으로 DJI Modify를 실행할 수 있습니다. 번거로운 파일 변환이나 내보내기 과정 없이 즉시 모델 처리 파일이 생성되어 후편집 작업으로 매끄럽게 넘어갑니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-section-header\">\r\n        <h3 class=\"dji-section-sub\">Step 2. Editing &amp; Sharing</h3>\r\n        <h2 class=\"dji-section-title\">DJI Modify : 지능형 3D 모델 편집</h2>\r\n        <p class=\"dji-section-desc\">\r\n            복잡하고 어려웠던 3D 메쉬와 포인트 클라우드 편집을 직관적이고 쉽게. 수정된 모델은 지형 데이터(DEM)로 출력하거나 클라우드로 즉시 공유됩니다.\r\n        </p>\r\n    </div>\r\n    <div class=\"dji-features\">\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\"><span>🧹</span> 포인트 클라우드 스마트 분류</h4>\r\n            <p class=\"dji-feature-desc\">머신러닝 알고리즘으로 지면, 식생, 건물, 전선 등을 자동 분류하며, 노이즈 제거 및 다운샘플링을 빠르게 수행합니다.</p>\r\n        </div>\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\"><span>🕳️</span> 3D 메쉬 결함 원클릭 복원</h4>\r\n            <p class=\"dji-feature-desc\">부유물, 모델의 구멍, 불필요한 차량 등을 자동으로 식별합니다. 버튼 한 번으로 평탄화하고 텍스처를 자연스럽게 채웁니다.</p>\r\n        </div>\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\"><span>🗺️</span> 지형 결과(DEM) 즉시 생성</h4>\r\n            <p class=\"dji-feature-desc\">편집이 완료된 지면 데이터를 바탕으로 디지털 고도 모델(DEM), 등고선, 불규칙 삼각망(TIN)을 추출해 GIS 및 CAD로 전송합니다.</p>\r\n        </div>\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\"><span>☁️</span> 클라우드 공유 및 빠른 배급</h4>\r\n            <p class=\"dji-feature-desc\">처리된 모델을 DJI 클라우드로 신속히 공유합니다. 공유 링크를 통해 모바일이나 웹에서 소프트웨어 설치 없이 열람 가능합니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-videos-sec\">\r\n        <div class=\"dji-videos-grid\">\r\n            <div class=\"dji-video-box\">\r\n                <h3>DJI Terra 소개</h3>\r\n                <div class=\"dji-video-wrap\">\r\n                    <iframe src=\"https://www.youtube.com/embed/NXwoHDmzCxU\" allowfullscreen=\"\"></iframe>\r\n                </div>\r\n            </div>\r\n            <div class=\"dji-video-box\">\r\n                <h3>DJI Modify V1.4 업데이트</h3>\r\n                <div class=\"dji-video-wrap\">\r\n                    <iframe src=\"https://www.youtube.com/embed/dld1Lda-b4o\" allowfullscreen=\"\"></iframe>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-plan-sec\">\r\n        <h2 class=\"dji-plan-title\">솔루션별 라이선스 플랜</h2>\r\n        <p class=\"dji-plan-desc\">운영 환경과 목적에 맞는 최적의 소프트웨어 라이선스를 구성하십시오.</p>\r\n        \r\n        <div class=\"dji-table-wrap\">\r\n            <table class=\"dji-plan-table\">\r\n                <caption>■ DJI Terra 라이선스</caption>\r\n                <thead>\r\n                    <tr>\r\n                        <th>기능 및 버전</th>\r\n                        <th>농업 (Agri)</th>\r\n                        <th>표준 (Std)</th>\r\n                        <th class=\"highlight\">플래그십 (Flagship)</th>\r\n                        <th>교육 (Edu)</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    <tr><td class=\"feature-name\">농업 응용</td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td></tr>\r\n                    <tr><td class=\"feature-name\">2D 지도 (논밭/과수원)</td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td></tr>\r\n                    <tr><td class=\"feature-name\">2D 지도 (도시)</td><td><span class=\"cross\">─</span></td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td></tr>\r\n                    <tr><td class=\"feature-name\">다중 스펙트럼 재구성</td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</s