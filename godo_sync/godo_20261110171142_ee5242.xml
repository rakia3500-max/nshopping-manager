<goodsDescription><![CDATA[<script data-bd="cpanel">(function(){
var D={"intro": "미니급 유일 1인치 50MP 센서의 249.9g 드론. 4K/120fps HDR, 정면 LiDAR 야간 감지, 내장 42GB. RC-N3 조종기·배터리 1개 기본 구성.", "chips": ["1인치 50MP 센서", "4K/120fps HDR", "249.9g", "정면 LiDAR 야간 감지", "O4+ 영상 전송", "내장 42GB", "최대 36분 비행", "RC-N3 조종기"], "badges": [{"text": "DJI 정품"}, {"text": "국내 A/S 접수"}, {"text": "Care Refresh 1·2년 가입 가능", "href": "https://www.drone-box.co.kr/goods/goods_view.php?goodsNo=1000001386"}, {"text": "기관·기업 납품서류 발급"}], "box": ["DJI Mini 5 Pro 기체", "DJI RC-N3 조종기", "RC-N 시리즈 RC 케이블(USB-C/Lightning) (각 1)", "인텔리전트 플라이트 배터리", "예비 프로펠러 (1쌍)", "USB-C 데이터 케이블", "보관 커버"], "ship": ""};
var S_INTRO="font-size:13.5px;color:#333D4B;line-height:1.65;margin:0 0 8px;",
S_CHIPS="display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px;",
S_CHIP="font-size:12px;background:#F2F4F6;color:#333D4B;border-radius:999px;padding:4px 10px;line-height:1.4;",
S_BADGES="display:flex;flex-wrap:wrap;gap:5px;margin:0 0 10px;",
S_BADGE="font-size:11.5px;border:1px solid #D6E4FF;color:#1B64DA;background:#F2F6FF;border-radius:6px;padding:3px 8px;font-weight:600;line-height:1.4;text-decoration:none;white-space:nowrap;",
S_FOLD="font-size:13px;color:#4E5968;border:1px dashed #D1D6DB;border-radius:8px;padding:9px 12px;margin:10px 0 4px;cursor:pointer;line-height:1.6;",
S_FOLD_B="color:#191F28;font-weight:700;";
function el(tag,html){var d=document.createElement(tag);if(html!=null)d.innerHTML=html;return d;}
function introHtml(){var chips=D.chips.map(function(c){return '<span style="'+S_CHIP+'">'+c+'</span>';}).join('');
return '<p data-bdc="intro" style="'+S_INTRO+'">'+D.intro+'</p><div data-bdc="chips" style="'+S_CHIPS+'">'+chips+'</div>';}
function badgesHtml(){return '<div data-bdc="badges" style="'+S_BADGES+'">'+D.badges.map(function(b){return b.href?'<a href="'+b.href+'" style="'+S_BADGE+'">'+b.text+'</a>':'<span style="'+S_BADGE+'">'+b.text+'</span>';}).join('')+'</div>';}
function foldHtml(){return '<div data-bdc="fold" style="'+S_FOLD+'"><span style="'+S_FOLD_B+'">구성품 보기 ▾</span><span data-bdc="foldbody" style="display:none;"> &nbsp;'+D.box.join(' · ')+(D.ship?'<br><span style="color:#8B95A1;">'+D.ship+'</span>':'')+'</span></div>';}
function bindFold(f){if(f.getAttribute('data-bound'))return;f.setAttribute('data-bound','1');f.onclick=function(){var b=f.querySelector('[data-bdc="foldbody"]'),t=f.querySelector('span');var open=b.style.display!=='none';b.style.display=open?'none':'inline';t.textContent=open?'구성품 보기 ▾':'구성품 접기 ▴';};}
var S_ROW=";clear:both;float:left;width:100%;box-sizing:border-box;";
function css(){if(document.querySelector('style[data-bdc="css"]'))return;var s=document.createElement('style');s.setAttribute('data-bdc','css');
s.textContent='.item_detail_list > dl{padding-top:3px !important;} .item_detail_list > dl > dt,.item_detail_list > dl > dd{line-height:20px !important;} .item_detail_list .item_delivery dd .delivery-detail{line-height:20px;} .item_detail_list [data-bdc="fold"]{margin:4px 0 0 !important;padding:6px 12px !important;}';document.head.appendChild(s);}
function pc(){var list=document.querySelector('.item_detail_list');if(!list)return;css();
if(!list.querySelector('[data-bdc="intro"]')){var w=el('div',introHtml()+badgesHtml());w.setAttribute('data-bdc','top');w.style.cssText+=S_ROW;list.insertBefore(w,list.firstChild);}
var dv=list.querySelector('.item_delivery');
if(!list.querySelector('[data-bdc="fold"]')){var f=el('div',foldHtml()).firstChild;f.style.cssText+=S_ROW;if(dv&&dv.nextSibling)dv.parentNode.insertBefore(f,dv.nextSibling);else list.appendChild(f);}
var fd=list.querySelector('[data-bdc="fold"]');if(fd)bindFold(fd);}
function mo(){var top=document.querySelector('.detail_info_top');if(!top)return;
var pb=top.querySelector('.price_box');
if(pb&&!top.querySelector('[data-bdc="intro"]')){var w=el('div',introHtml()+badgesHtml());w.setAttribute('data-bdc','top');w.style.cssText='padding:8px 0 4px;';var sub=pb.querySelector('.detail_sub_info');if(sub)pb.insertBefore(w,sub);else pb.appendChild(w);}
var sub2=document.querySelector('.detail_sub_info');
if(sub2&&!document.querySelector('.detail_info_top [data-bdc="fold"]')){var f=el('div',foldHtml()).firstChild;sub2.parentNode.insertBefore(f,sub2.nextSibling);}
var fd=document.querySelector('.detail_info_top [data-bdc="fold"]');if(fd)bindFold(fd);}
function fix(){try{pc();}catch(e){}try{mo();}catch(e){}}
function start(){fix();try{new MutationObserver(function(){fix();}).observe(document.body,{childList:true,subtree:true});}catch(e){}
var n=0,t=setInterval(function(){fix();if(++n>40)clearInterval(t);},500);}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',start);}else{start();}
})();</script>
<style>\r\n    /* DJI Mini 5 Pro Consumer Theme (Sky Blue) */\r\n    .mini5-wrapper {\r\n        width: 100%; \r\n        max-width: 100%; \r\n        margin: 0 auto;\r\n        background-color: #ffffff; /* 화이트 배경 */\r\n        color: #1d1d1f; /* 짙은 다크 그레이 텍스트 */\r\n        font-family: \'Pretendard\', \'Malgun Gothic\', sans-serif;\r\n        line-height: 1.6;\r\n        word-break: keep-all;\r\n        box-sizing: border-box; \r\n    }\r\n\r\n    /* Layout */\r\n    .mini5-section {\r\n        padding: 80px 20px; \r\n        max-width: 1200px; \r\n        margin: 0 auto; \r\n    }\r\n    .mini5-bg-gray { background-color: #f5f5f7; } /* 섹션 구분용 연한 회색 */\r\n\r\n    /* Typography */\r\n    .mini5-blue { color: #007AFF; } /* Sky Blue Accent */\r\n    .mini5-title {\r\n        font-size: 40px;\r\n        font-weight: 800;\r\n        margin-bottom: 20px;\r\n        letter-spacing: -1px;\r\n        line-height: 1.2;\r\n        color: #1d1d1f;\r\n    }\r\n    .mini5-subtitle {\r\n        font-size: 22px;\r\n        font-weight: 700;\r\n        margin-bottom: 15px;\r\n        color: #007AFF;\r\n        text-transform: uppercase;\r\n        letter-spacing: 1px;\r\n    }\r\n    .mini5-desc {\r\n        font-size: 18px;\r\n        color: #6e6e73;\r\n        margin-bottom: 30px;\r\n        max-width: 800px;\r\n        margin-left: auto;\r\n        margin-right: auto;\r\n    }\r\n\r\n    /* Hero Section */\r\n    .mini5-hero {\r\n        text-align: center;\r\n        padding: 100px 20px 60px;\r\n        background: #ffffff;\r\n    }\r\n\r\n    /* Video Container */\r\n    .mini5-video-container {\r\n        position: relative;\r\n        padding-bottom: 56.25%; \r\n        height: 0;\r\n        border-radius: 20px;\r\n        overflow: hidden;\r\n        margin-top: 30px;\r\n        box-shadow: 0 10px 30px rgba(0,0,0,0.1);\r\n    }\r\n    .mini5-video-container iframe {\r\n        position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;\r\n    }\r\n\r\n    /* Grid Layout */\r\n    .mini5-grid {\r\n        display: grid;\r\n        grid-template-columns: repeat(2, 1fr);\r\n        gap: 24px;\r\n        margin-top: 40px;\r\n    }\r\n    .mini5-card {\r\n        background: #ffffff;\r\n        border-radius: 20px;\r\n        padding: 40px 30px;\r\n        transition: 0.3s;\r\n        box-shadow: 0 4px 20px rgba(0,0,0,0.05);\r\n        border: 1px solid #eee;\r\n    }\r\n    .mini5-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,122,255,0.15); }\r\n    \r\n    .mini5-card h4 { font-size: 22px; font-weight: 700; margin-bottom: 10px; color: #1d1d1f; }\r\n    .mini5-card p { font-size: 16px; color: #86868b; }\r\n\r\n    /* Images */\r\n    .mini5-img { width: 100%; height: auto; border-radius: 20px; margin: 40px 0; box-shadow: 0 5px 20px rgba(0,0,0,0.08); }\r\n\r\n    /* Table (구성품 표) */\r\n    .mini5-table {\r\n        width: 100%;\r\n        border-collapse: separate;\r\n        border-spacing: 0;\r\n        margin-top: 40px;\r\n        font-size: 13px;\r\n        background: #ffffff;\r\n        border-radius: 12px;\r\n        border: 1px solid #e1e1e1;\r\n        overflow: hidden;\r\n    }\r\n    .mini5-table th {\r\n        background: #f5f5f7;\r\n        padding: 15px 10px;\r\n        color: #1d1d1f;\r\n        font-weight: 700;\r\n        border-bottom: 1px solid #e1e1e1;\r\n        text-align: center;\r\n        vertical-align: middle;\r\n    }\r\n    .mini5-table td {\r\n        padding: 15px 10px;\r\n        border-bottom: 1px solid #e1e1e1;\r\n        text-align: center;\r\n        color: #424245;\r\n        border-right: 1px solid #f0f0f0;\r\n    }\r\n    .mini5-table td:last-child { border-right: none; }\r\n    .mini5-table tr:last-child td { border-bottom: none; }\r\n    .mini5-table-item { text-align: left !important; padding-left: 20px !important; font-weight: 600; background: #fff; }\r\n    \r\n    /* Highlight Column */\r\n    .mini5-col-highlight { background-color: #f0f8ff; color: #007AFF; font-weight: bold; }\r\n\r\n    @media (max-width: 768px) {\r\n        .mini5-title { font-size: 32px; }\r\n        .mini5-grid { grid-template-columns: 1fr; }\r\n        .mini5-table { font-size: 11px; }\r\n        .mini5-table th, .mini5-table td { padding: 10px 5px; }\r\n    }\r\n</style>\r\n\r\n<div class=\"mini5-wrapper\">\r\n\r\n    <section class=\"mini5-hero\">\r\n        <p style=\"letter-spacing: 2px; color: #007AFF; font-weight:700; margin-bottom:10px;\">PRO PERFORMANCE. MINI SIZE.</p>\r\n        <h1 class=\"mini5-title\">DJI <span class=\"mini5-blue\">MINI 5 PRO</span></h1>\r\n        <p class=\"mini5-desc\">\r\n            올인원 16mm(1\") 대형 CMOS 미니 카메라 드론.<br>\r\n            한계를 넘어선 화질과 성능을 경험하세요.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/mini%205%20pro/1.jpg\" class=\"mini5-img\" style=\"margin-top:20px; box-shadow:none;\" alt=\"Mini 5 Pro Main\">\r\n    </section>\r\n\r\n    <section class=\"mini5-section mini5-bg-gray\">\r\n        <h3 class=\"mini5-subtitle\" style=\"text-align:center;\">OFFICIAL INTRODUCTION</h3>\r\n        <div class=\"mini5-video-container\">\r\n            <iframe src=\"https://www.youtube.com/embed/jRzpagPx6uY?rel=0&amp;modestbranding=1\" title=\"DJI Mini 5 Pro Video\" allowfullscreen=\"\"></iframe>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"mini5-section\">\r\n        <h2 class=\"mini5-title\" style=\"text-align:center;\">DJI Mini 5 Pro를<br>선택해야 하는 <span class=\"mini5-blue\">6가지 이유</span></h2>\r\n        \r\n        <div class=\"mini5-grid\">\r\n            <div class=\"mini5-card\">\r\n                <h4>가벼운 무게, 뛰어난 휴대성</h4>\r\n                <p>249g 미만의 가벼운 무게와 접이식 디자인으로 어디든 손쉽게 휴대하세요.</p>\r\n            </div>\r\n            <div class=\"mini5-card\">\r\n                <h4>16mm(1\") 대형 CMOS 카메라</h4>\r\n                <p>프로급 이미지 성능. 더 넓은 다이내믹 레인지와 저조도 성능을 제공합니다.</p>\r\n            </div>\r\n            <div class=\"mini5-card\">\r\n                <h4>업그레이드된 ActiveTrack 360°</h4>\r\n                <p>피사체를 놓치지 않는 정교한 추적과 다양한 촬영 시나리오를 지원합니다.</p>\r\n            </div>\r\n            <div class=\"mini5-card\">\r\n                <h4>더 길어진 배터리 사용 시간</h4>\r\n                <p>최대 52분의 비행 시간으로 배터리 걱정 없이 마음껏 비행하세요.</p>\r\n            </div>\r\n            <div class=\"mini5-card\">\r\n                <h4>트루 버티컬 촬영 &amp; 225° 회전</h4>\r\n                <p>소셜 미디어에 딱 맞는 세로 모드 촬영과 유연한 짐벌 회전을 지원합니다.</p>\r\n            </div>\r\n            <div class=\"mini5-card\">\r\n                <h4>야경 전방위 장애물 감지</h4>\r\n                <p>밤에도 안전하게. 전면 LiDAR와 센서로 야간에도 장애물을 감지합니다.</p>\r\n            </div>\r\n        </div>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/mini%205%20pro/2.jpg\" class=\"mini5-img\" alt=\"Key Features\">\r\n    </section>\r\n\r\n    <section class=\"mini5-section mini5-bg-gray\">\r\n        <h3 class=\"mini5-subtitle\">IMAGING SYSTEM</h3>\r\n        <h2 class=\"mini5-title\">미니 드론의 <span class=\"mini5-blue\">프로급 이미지 성능</span></h2>\r\n        <p class=\"mini5-desc\">\r\n            1인치 센서와 f/1.8 조리개는 선명한 풍경과 뛰어난 인물 표현을 보장합니다.<br>\r\n            4K/60fps HDR 및 4K/120fps 슬로 모션으로 영화 같은 영상을 담아보세요.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/mini%205%20pro/3.jpg\" class=\"mini5-img\" alt=\"Camera Specs\">\r\n    </section>\r\n\r\n    <section class=\"mini5-section\">\r\n        <h3 class=\"mini5-subtitle\">CREATIVITY</h3>\r\n        <h2 class=\"mini5-title\">안정적이며, <span class=\"mini5-blue\">언제든 촬영 가능</span></h2>\r\n        <p class=\"mini5-desc\">\r\n            225° 회전하는 짐벌은 다이내믹한 앵글을, 트루 버티컬 촬영은 <br>\r\n            자르지 않고 꽉 찬 세로 영상을 선사합니다.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/mini%205%20pro/4.jpg\" class=\"mini5-img\" alt=\"Gimbal Features\">\r\n    </section>\r\n\r\n    <section class=\"mini5-section mini5-bg-gray\">\r\n        <h3 class=\"mini5-subtitle\">SAFETY &amp; FLIGHT</h3>\r\n        <h2 class=\"mini5-title\">경로 기억, <span class=\"mini5-blue\">야경 전방위 감지</span></h2>\r\n        <p class=\"mini5-desc\">\r\n            전방위 비전 감지 시스템과 스마트 RTH로 초보자도 안심하고 비행할 수 있습니다.<br>\r\n            O4+ 전송 시스템은 최대 20km까지 끊김 없는 영상을 전송합니다.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/mini%205%20pro/5.jpg\" class=\"mini5-img\" alt=\"Safety Features\">\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/mini%205%20pro/6.jpg\" class=\"mini5-img\" alt=\"ActiveTrack\">\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/mini%205%20pro/7.jpg\" class=\"mini5-img\" alt=\"Performance\">\r\n    </section>\r\n\r\n    <section class=\"mini5-section\">\r\n        <h3 class=\"mini5-subtitle\">INTELLIGENT MODES</h3>\r\n        <h2 class=\"mini5-title\">프로처럼 <span class=\"mini5-blue\">손쉽게 창작</span></h2>\r\n        <p class=\"mini5-desc\">MasterShot, QuickShot, 파노라마 등 탭 한 번으로 전문가 수준의 영상을 완성하세요.</p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/mini%205%20pro/8.jpg\" class=\"mini5-img\" alt=\"Intelligent Modes\">\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/mini%205%20pro/9.jpg\" class=\"mini5-img\" alt=\"Accessories\">\r\n    </section>\r\n\r\n    <section class=\"mini5-section mini5-bg-gray\">\r\n        <h3 class=\"mini5-subtitle\">IN THE BOX</h3>\r\n        <h2 class=\"mini5-title\">구성품 비교</h2>\r\n        <p class=\"mini5-desc\">나에게 맞는 패키지를 확인하세요.</p>\r\n        \r\n        <div style=\"overflow-x:auto;\">\r\n            <table class=\"mini5-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th style=\"width:25%;\">아이템</th>\r\n                        <th style=\"width:15%;\">Mini 5 Pro<br>(기체 단품)</th>\r\n                        <th style=\"width:20%;\">플라이 모어 콤보<br>(RC-N3 포함)</th>\r\n                        <th style=\"width:20%;\">플라이 모어 콤보<br>(RC 2 포함)</th>\r\n                        <th style=\"width:2