<goodsDescription><![CDATA[<style>\r\n    /* DJI Mic 3 Premium Dark Theme */\r\n    .mic3-wrapper {\r\n        width: 100%; \r\n        max-width: 100%; \r\n        margin: 0 auto;\r\n        background-color: #080808; /* 깊은 블랙 배경 */\r\n        color: #f0f0f0;\r\n        font-family: \'Pretendard\', \'Malgun Gothic\', sans-serif;\r\n        line-height: 1.6;\r\n        word-break: keep-all;\r\n        box-sizing: border-box; \r\n    }\r\n\r\n    /* 공통 레이아웃 */\r\n    .mic3-section {\r\n        padding: 80px 20px; \r\n        border-bottom: 1px solid #1a1a1a;\r\n        max-width: 1200px; \r\n        margin: 0 auto; \r\n    }\r\n\r\n    /* 텍스트 스타일 */\r\n    .mic3-blue { color: #409EFF; } /* Tech Blue 포인트 컬러 */\r\n    .mic3-gray { color: #999; font-size: 15px; margin-top: 10px; }\r\n    \r\n    .mic3-title {\r\n        font-size: 42px;\r\n        font-weight: 800;\r\n        margin-bottom: 20px;\r\n        letter-spacing: -1px;\r\n        line-height: 1.2;\r\n    }\r\n    \r\n    .mic3-subtitle {\r\n        font-size: 24px;\r\n        font-weight: 700;\r\n        margin-bottom: 15px;\r\n        color: #409EFF;\r\n    }\r\n\r\n    .mic3-desc {\r\n        font-size: 17px;\r\n        color: #ccc;\r\n        margin-bottom: 30px;\r\n        max-width: 800px;\r\n        margin-left: auto;\r\n        margin-right: auto;\r\n    }\r\n\r\n    /* 인트로 섹션 */\r\n    .mic3-hero {\r\n        text-align: center;\r\n        padding: 80px 20px 40px;\r\n        max-width: 1200px;\r\n        margin: 0 auto;\r\n    }\r\n\r\n    /* 유튜브 반응형 */\r\n    .mic3-video-container {\r\n        position: relative;\r\n        padding-bottom: 56.25%; \r\n        height: 0;\r\n        overflow: hidden;\r\n        max-width: 100%;\r\n        background: #000;\r\n        border-radius: 16px;\r\n        border: 1px solid #333;\r\n        margin-top: 40px;\r\n        box-shadow: 0 20px 50px rgba(0,0,0,0.6);\r\n    }\r\n    .mic3-video-container iframe {\r\n        position: absolute;\r\n        top: 0;\r\n        left: 0;\r\n        width: 100%;\r\n        height: 100%;\r\n        border: 0;\r\n    }\r\n\r\n    /* 그리드 레이아웃 (8가지 이유) */\r\n    .mic3-grid-container {\r\n        display: grid;\r\n        grid-template-columns: repeat(2, 1fr);\r\n        gap: 20px;\r\n        margin-top: 50px;\r\n    }\r\n\r\n    .mic3-card {\r\n        background: #121212;\r\n        border: 1px solid #2a2a2a;\r\n        border-radius: 16px;\r\n        padding: 40px 30px;\r\n        text-align: center;\r\n        transition: transform 0.3s, border-color 0.3s;\r\n    }\r\n\r\n    .mic3-card:hover {\r\n        transform: translateY(-5px);\r\n        border-color: #409EFF;\r\n        background: #1a1a1a;\r\n    }\r\n\r\n    .mic3-card-title { font-size: 20px; font-weight: bold; margin-bottom: 10px; color: #fff; }\r\n    .mic3-card-desc { font-size: 14px; color: #888; }\r\n\r\n    /* 이미지 스타일 */\r\n    .mic3-full-img {\r\n        width: 100%;\r\n        height: auto;\r\n        border-radius: 16px;\r\n        margin: 40px 0;\r\n        border: 1px solid #222;\r\n    }\r\n\r\n    /* 구성품 표 스타일 */\r\n    .mic3-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 40px;\r\n        font-size: 14px;\r\n        background: #121212;\r\n        border-radius: 16px;\r\n        overflow: hidden;\r\n        border: 1px solid #333;\r\n    }\r\n    .mic3-table th {\r\n        background-color: #1f1f1f;\r\n        color: #fff;\r\n        padding: 18px;\r\n        border-bottom: 1px solid #333;\r\n        text-align: center;\r\n        font-weight: 700;\r\n    }\r\n    .mic3-table td {\r\n        padding: 18px;\r\n        border-bottom: 1px solid #333;\r\n        color: #ddd;\r\n        text-align: center;\r\n        border-right: 1px solid #2a2a2a;\r\n    }\r\n    .mic3-table td:last-child { border-right: none; }\r\n    .mic3-table td:first-child { text-align: left; padding-left: 25px; font-weight: 600; color: #fff; }\r\n    .mic3-highlight { color: #409EFF; font-weight: bold; }\r\n\r\n    /* 호환성 버튼 */\r\n    .compat-btn {\r\n        display: inline-block;\r\n        background: #1a1a1a;\r\n        color: #fff;\r\n        padding: 12px 25px;\r\n        border-radius: 30px;\r\n        text-decoration: none;\r\n        border: 1px solid #444;\r\n        margin: 5px;\r\n        font-size: 14px;\r\n        transition: 0.3s;\r\n    }\r\n    .compat-btn:hover { background: #409EFF; border-color: #409EFF; color: #fff; }\r\n\r\n    /* 모바일 반응형 */\r\n    @media screen and (max-width: 768px) {\r\n        .mic3-section { padding: 50px 15px; }\r\n        .mic3-title { font-size: 30px; }\r\n        .mic3-subtitle { font-size: 22px; }\r\n        .mic3-grid-container { grid-template-columns: 1fr; }\r\n        .mic3-table { font-size: 12px; }\r\n        .mic3-table th, .mic3-table td { padding: 12px 5px; }\r\n        .mic3-table td:first-child { padding-left: 10px; }\r\n    }\r\n</style>\r\n\r\n<div class=\"mic3-wrapper\">\r\n\r\n    <section class=\"mic3-hero\">\r\n        <p style=\"color: #888; font-weight: 600; letter-spacing: 2px; margin-bottom: 10px;\">DJI MIC 3</p>\r\n        <h1 class=\"mic3-title\">오디오의 새로운 차원<br><span class=\"mic3-blue\">고급 미니 무선 마이크</span></h1>\r\n        <p class=\"mic3-desc\">\r\n            가볍고 강력한 올인원 디자인. 32-bit Float 내부 레코딩과<br>\r\n            노이즈 캔슬링으로 언제 어디서나 스튜디오급 사운드를 완성하세요.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Mic%203/1.jpg\" class=\"mic3-full-img\" alt=\"DJI Mic 3 Main\">\r\n    </section>\r\n\r\n    <section class=\"mic3-section\">\r\n        <h3 class=\"mic3-subtitle\" style=\"text-align: center;\">MEET DJI MIC 3</h3>\r\n        <div class=\"mic3-video-container\">\r\n            <iframe src=\"https://www.youtube.com/embed/IYQ9rWGMzI4?rel=0&amp;modestbranding=1\" title=\"DJI Mic 3 Introduction\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\">\r\n            </iframe>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"mic3-section\">\r\n        <h2 class=\"mic3-title\" style=\"text-align: center;\">선택해야 하는 <span class=\"mic3-blue\">8가지 이유</span></h2>\r\n        \r\n        <div class=\"mic3-grid-container\">\r\n            <div class=\"mic3-card\">\r\n                <div class=\"mic3-card-title\">가볍고 간편한 일체형 수납</div>\r\n                <div class=\"mic3-card-desc\">케이스 하나로 충전과 보관을 동시에</div>\r\n            </div>\r\n            <div class=\"mic3-card\">\r\n                <div class=\"mic3-card-title\">자동 게인 조절</div>\r\n                <div class=\"mic3-card-desc\">어떤 환경에서도 균형 잡힌 음량 제공</div>\r\n            </div>\r\n            <div class=\"mic3-card\">\r\n                <div class=\"mic3-card-title\">4TX + 8RX 기능</div>\r\n                <div class=\"mic3-card-desc\">최대 4채널 출력으로 확장된 연결성</div>\r\n            </div>\r\n            <div class=\"mic3-card\">\r\n                <div class=\"mic3-card-title\">2단계 노이즈 캔슬링</div>\r\n                <div class=\"mic3-card-desc\">세 가지 음성 톤 프리셋 지원</div>\r\n            </div>\r\n            <div class=\"mic3-card\">\r\n                <div class=\"mic3-card-title\">듀얼 밴드 간섭 방지</div>\r\n                <div class=\"mic3-card-desc\">끊김 없는 무손실 오디오 전송</div>\r\n            </div>\r\n            <div class=\"mic3-card\">\r\n                <div class=\"mic3-card-title\">32-bit Float 내부 레코딩</div>\r\n                <div class=\"mic3-card-desc\">후편집이 자유로운 듀얼 파일 저장</div>\r\n            </div>\r\n            <div class=\"mic3-card\">\r\n                <div class=\"mic3-card-title\">통합 타임코드</div>\r\n                <div class=\"mic3-card-desc\">여러 대의 카메라 싱크를 완벽하게</div>\r\n            </div>\r\n            <div class=\"mic3-card\">\r\n                <div class=\"mic3-card-title\">더욱 길어진 작동 시간</div>\r\n                <div class=\"mic3-card-desc\">빠른 충전과 하루 종일 지속되는 배터리</div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"mic3-section\">\r\n        <h3 class=\"mic3-subtitle\">DESIGN</h3>\r\n        <h2 class=\"mic3-title\">스타일리시한 디자인,<br>스마트한 저장</h2>\r\n        <p class=\"mic3-desc\" style=\"margin: 0;\">\r\n            단 16g의 무게. 마그네틱 클립으로 옷깃에 가볍게 부착하세요.<br>\r\n            투명한 블랙 디자인이 당신의 스타일을 완성합니다.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Mic%203/JPG_3.jpg\" class=\"mic3-full-img\" alt=\"Compact Design\">\r\n    </section>\r\n\r\n    <section class=\"mic3-section\">\r\n        <h3 class=\"mic3-subtitle\">PERFORMANCE</h3>\r\n        <h2 class=\"mic3-title\">강력한 성능,<br>무한한 가능성</h2>\r\n        <p class=\"mic3-desc\">\r\n            400m 전송 거리와 24-bit 48kHz 무손실 오디오.<br>\r\n            전문가를 위한 4채널 출력과 유연한 채널 설정을 지원합니다.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Mic%203/JPG_4.jpg\" class=\"mic3-full-img\" alt=\"Performance Features\">\r\n    </section>\r\n\r\n    <section class=\"mic3-section\">\r\n        <h3 class=\"mic3-subtitle\">AUDIO QUALITY</h3>\r\n        <h2 class=\"mic3-title\">프리미엄 오디오,<br>더 스마트한 경험</h2>\r\n        <p class=\"mic3-desc\">\r\n            일반/리치/브라이트 3가지 톤 프리셋으로 분위기를 연출하세요.<br>\r\n            2단계 노이즈 캔슬링이 주변 소음을 완벽하게 제어합니다.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Mic%203/JPG_5.jpg\" class=\"mic3-full-img\" alt=\"Audio Quality\">\r\n    </section>\r\n\r\n    <section class=\"mic3-section\">\r\n        <h3 class=\"mic3-subtitle\">BATTERY LIFE</h3>\r\n        <h2 class=\"mic3-title\">하루 종일 지속되는 배터리</h2>\r\n        <div style=\"background: #121212; padding: 30px; border-radius: 16px; margin-bottom: 20px; border: 1px solid #222;\">\r\n            <h4 style=\"font-size: 24px; color: #fff; margin-bottom: 10px;\">최대 28시간 사용</h4>\r\n            <p class=\"mic3-gray\">송신기 단독 8시간, 케이스 포함 시 최대 28시간. 5분 충전으로 2시간 사용 가능한 급속 충전 지원.</p>\r\n        </div>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Mic%203/JPG_6.jpg\" class=\"mic3-full-img\" alt=\"Battery Life\">\r\n    </section>\r\n\r\n    <section class=\"mic3-section\">\r\n        <h3 class=\"mic3-subtitle\">CONNECTIVITY</h3>\r\n        <h2 class=\"mic3-title\">즉시 연결, 자유로운 창작</h2>\r\n        <p class=\"mic3-desc\">\r\n            수신기 없이 Osmo Action 5 Pro, Pocket 3에 블루투스로 바로 연결.<br>\r\n            아이폰과 갤럭시 등 스마트폰과도 완벽하게 호환됩니다.\r\n        </p>\r\n        \r\n        <div style=\"text-align: center; margin: 40px 0;\">\r\n            <p style=\"color: #fff; margin-bottom: 15px; font-weight: bold;\">▼ 내 스마트폰 호환성 확인하기</p>\r\n            <a href=\"https://dl.djicdn.com/downloads/DJI%20Mic%203/20250828/COMPATIBILITY_LIST/DJI_Mic_3_Mobile_Phone%20&amp;Tablet_Compatibility_List_EN.pdf\" target=\"_blank\" class=\"compat-btn\">📱 모바일 기기 호환 리스트 (Apple/Samsung)</a>\r\n            <a href=\"https://dl.djicdn.com/downloads/DJI%20Mic%203/20251230/DJI_Mic_3_ThirdParty_App_Compatibility_List_EN_202512.pdf\" target=\"_blank\" class=\"compat-btn\">🎥 타사 앱 호환 리스트</a>\r\n        </div>\r\n\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Mic%203/7.jpg\" class=\"mic3-full-img\" alt=\"Connectivity\">\r\n    </section>\r\n\r\n    <section class=\"mic3-section\">\r\n        <h3 class=\"mic3-subtitle\">ACCESSORIES</h3>\r\n        <h2 class=\"mic3-title\">실용적인 액세서리</h2>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Mic%203/8.jpg\" class=\"mic3-full-img\" alt=\"Accessories\">\r\n    </section>\r\n\r\n    <section class=\"mic3-section\" style=\"border-bottom: none;\">\r\n        <h3 class=\"mic3-subtitle\">IN THE BOX</h3>\r\n        <h2 class=\"mic3-title\">구성품 비교</h2>\r\n        \r\n        <table class=\"mic3-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"width: 40%;\">아이템</th>\r\n                    <th style=\"width: 30%; color: #409EFF;\">2 TX + 1 RX + 케이스</th>\r\n                    <th style=\"width: 30%;\">1 TX + 1 RX</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                <tr>\r\n                    <td>DJI Mic 3 송신기</td>\r\n                    <td class=\"mic3-highlight\">2</td>\r\n                    <td>1</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>DJI Mic 3 수신기</td>\r\n                    <td class=\"mic3-highlight\">1</td>\r\n                    <td>1</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>DJI Mic 3 충전 케이스</td>\r\n                    <td class=\"mic3-highlight\">1</td>\r\n                    <td>-</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>카메라 오디오 케이블 (3.5mm TRS)</td>\r\n                    <td class=\"mic3-highlight\">1</td>\r\n                    <td>1</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>스마트폰 어댑터 (Type-C)</td>\r\n                    <td class=\"mic3-highlight\">1</td>\r\n                    <td>1</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>스마트폰 어댑터 (Lightning)</td>\r\n                    <td class=\"mic3-highlight\">1</td>\r\n                    <td>1</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>윈드스크린</td>\r\n                    <td class=\"mic3-highlight\">2</td>\r\n                    <td>1</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>마그넷 클립</td>\r\n                    <td class=\"mic3-highlight\">2</td>\r\n                    <td>1</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>운반 백</td>\r\n                    <td class=\"mic3-highlight\">1</td>\r\n                    <td>-</td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n    </section>\r\n\r\n    <div style=\"text-align: center; padding: 40px; color: #666; font-size: 12px;\">\r\n        ※ 본 페이지의 이미지는 연출된 장면이며, 실제 제품 스펙은 펌웨어 업데이트에 따라 달라질 수 있습니다.<br>\r\n        DJI 정품판매점 <strong>드론박스</strong>\r\n    </div>\r\n\r\n</div>]]></goodsDescription>
