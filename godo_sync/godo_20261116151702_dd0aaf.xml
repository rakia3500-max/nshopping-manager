<!-- ============================================================\r\n  DJI Matrice 4 시리즈 프로펠러 상세페이지 | 드론박스\r\n  * 공식 원문 보존 + 저소음/일반 비교표 포함\r\n============================================================ -->\r\n<div style=\"max-width:1100px;margin:0 auto;background:#ffffff;font-family:\'Pretendard\',\'Apple SD Gothic Neo\',\'Malgun Gothic\',sans-serif;color:#1a1a1a;\">\r\n\r\n  <!-- 헤더 -->\r\n  <div style=\"padding:56px 28px 40px;text-align:center;border-bottom:1px solid #ececec;\">\r\n    <p style=\"font-size:14px;font-weight:600;color:#888;letter-spacing:3px;margin:0 0 10px;\">DJI MATRICE 4 SERIES</p>\r\n    <h2 style=\"font-size:36px;font-weight:700;color:#111;margin:0 0 16px;\">DJI Matrice 4 시리즈 프로펠러</h2>\r\n    <p style=\"font-size:17px;color:#555;line-height:1.8;margin:0;\">정밀한 동적 균형 테스트를 거친 표준 프로펠러로,<br>DJI Matrice 4 시리즈의 일상 임무를 위한 기본 교체 구성입니다.</p>\r\n  </div>\r\n\r\n  <!-- ═══════ 자세히 살펴보기 (공식 원문) ═══════ -->\r\n  <div style=\"padding:56px 28px;\">\r\n    <h3 style=\"font-size:30px;font-weight:700;color:#111;text-align:center;margin:0 0 44px;\">자세히 살펴보기</h3>\r\n    <div style=\"display:flex;gap:32px;padding:26px 0;border-top:1px solid #ececec;border-bottom:1px solid #ececec;\">\r\n      <div style=\"flex-shrink:0;width:110px;font-size:16px;font-weight:600;color:#888;\">개요</div>\r\n      <p style=\"font-size:16px;color:#333;margin:0;line-height:1.9;\">각 프로펠러 블레이드는 정교한 다이내믹 균형 테스트를 거쳐 비행 시간 증가 및 소음 감소, 공기역학적 효율성 향상, 전력 소비 감소를 이뤄냈습니다. 사고 발생 시, 사람 또는 다른 물체에 손상을 줄일 수 있도록 새로운 안전 디자인을 채택했습니다.</p>\r\n    </div>\r\n    <div style=\"display:flex;gap:32px;padding:26px 0;border-bottom:1px solid #ececec;\">\r\n      <div style=\"flex-shrink:0;width:110px;font-size:16px;font-weight:600;color:#888;\">특징</div>\r\n      <p style=\"font-size:16px;color:#333;margin:0;line-height:1.9;\">각 프로펠러 블레이드는 정밀한 동적 균형 테스트를 거쳐 비행 시간을 늘리고 안전성을 높입니다.</p>\r\n    </div>\r\n    <div style=\"display:flex;gap:32px;padding:26px 0;border-bottom:1px solid #ececec;\">\r\n      <div style=\"flex-shrink:0;width:110px;font-size:16px;font-weight:600;color:#888;\">유의</div>\r\n      <p style=\"font-size:16px;color:#333;margin:0;line-height:1.9;\">1. 반드시 사용자 매뉴얼에 따라 프로펠러를 올바르게 장착합니다.<br>2. 손상된 프로펠러는 최대한 빨리 바로 교체해야 합니다.</p>\r\n    </div>\r\n    <div style=\"display:flex;gap:32px;padding:26px 0;border-bottom:1px solid #ececec;\">\r\n      <div style=\"flex-shrink:0;width:110px;font-size:16px;font-weight:600;color:#888;\">구성품</div>\r\n      <p style=\"font-size:16px;color:#333;margin:0;line-height:1.9;\">프로펠러(1쌍) × 1</p>\r\n    </div>\r\n    <div style=\"display:flex;gap:32px;padding:26px 0;border-bottom:1px solid #ececec;\">\r\n      <div style=\"flex-shrink:0;width:110px;font-size:16px;font-weight:600;color:#888;\">사양</div>\r\n      <p style=\"font-size:16px;color:#333;margin:0;line-height:1.9;\">직경 × 나사산 피치: 10.8 × 5.7인치<br>무게 (1개당): 10.8 g</p>\r\n    </div>\r\n    <div style=\"display:flex;gap:32px;padding:26px 0;border-bottom:1px solid #ececec;\">\r\n      <div style=\"flex-shrink:0;width:110px;font-size:16px;font-weight:600;color:#888;\">호환 제품</div>\r\n      <p style=\"font-size:16px;color:#333;margin:0;line-height:1.9;\">DJI Matrice 4 시리즈</p>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ═══════ 저소음/일반 프로펠러 비교 ═══════ -->\r\n  <div style=\"padding:48px 28px 56px;background:#fafafa;\">\r\n    <h3 style=\"font-size:28px;font-weight:700;color:#111;text-align:center;margin:0 0 10px;\">저소음 프로펠러 vs 일반 프로펠러</h3>\r\n    <p style=\"font-size:16px;color:#777;text-align:center;margin:0 0 8px;line-height:1.7;\">DJI Matrice 4 시리즈 프로펠러는 임무 환경에 따라 두 가지 구성 중 선택할 수 있습니다.</p>\r\n    <p id=\"prop-hint-st\" style=\"font-size:14px;color:#2b6cff;text-align:center;margin:0 0 28px;display:none;\">👆 제품명을 탭하면 해당 제품 스펙이 강조됩니다</p>\r\n    <div style=\"overflow-x:auto;\">\r\n      <table id=\"prop-table-st\" style=\"width:100%;border-collapse:collapse;font-size:16px;min-width:640px;background:#ffffff;border:1px solid #ececec;\">\r\n        <thead>\r\n          <tr style=\"background:#f4f4f6;\">\r\n            <th style=\"padding:18px 16px;text-align:left;color:#888;font-weight:600;border-bottom:2px solid #ddd;width:22%;font-size:15px;\">구분</th>\r\n            <th id=\"th-ln-st\" class=\"col-ln\" style=\"padding:18px 16px;text-align:center;font-weight:700;font-size:17px;color:#999;border-bottom:2px solid #ddd;transition:color .25s,border-color .25s,background .25s;\">저소음 프로펠러</th>\r\n            <th id=\"th-st-st\" class=\"col-st\" style=\"padding:18px 16px;text-align:center;font-weight:700;font-size:17px;color:#2b6cff;border-bottom:2px solid #2b6cff;background:#eef3ff;transition:color .25s,border-color .25s,background .25s;\">일반 프로펠러</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr style=\"\">\r\n            <td style=\"padding:17px 16px;border-bottom:1px solid #f0f0f0;color:#888;\">직경 × 나사산 피치</td>\r\n            <td class=\"col-ln\" style=\"padding:17px 16px;color:#b0b0b8;border-bottom:1px solid #f0f0f0;text-align:center;transition:color .25s,font-weight .25s;\">10.8 × 5.4인치</td>\r\n            <td class=\"col-st\" style=\"padding:17px 16px;color:#111;font-weight:600;border-bottom:1px solid #f0f0f0;text-align:center;transition:color .25s,font-weight .25s;\">10.8 × 5.7인치</td>\r\n          </tr>\r\n          <tr style=\"background:#fbfbfd;\">\r\n            <td style=\"padding:17px 16px;border-bottom:1px solid #f0f0f0;color:#888;\">무게 (1개당)</td>\r\n            <td class=\"col-ln\" style=\"padding:17px 16px;color:#b0b0b8;border-bottom:1px solid #f0f0f0;text-align:center;transition:color .25s,font-weight .25s;\">13.7 g</td>\r\n            <td class=\"col-st\" style=\"padding:17px 16px;color:#111;font-weight:600;border-bottom:1px solid #f0f0f0;text-align:center;transition:color .25s,font-weight .25s;\">10.8 g</td>\r\n          </tr>\r\n          <tr style=\"\">\r\n            <td style=\"padding:17px 16px;border-bottom:1px solid #f0f0f0;color:#888;\">공식 특징</td>\r\n            <td class=\"col-ln\" style=\"padding:17px 16px;color:#b0b0b8;border-bottom:1px solid #f0f0f0;text-align:center;transition:color .25s,font-weight .25s;\">비행 시간 증가 · <u>소음 감소</u> · 안전성 향상</td>\r\n            <td class=\"col-st\" style=\"padding:17px 16px;color:#111;font-weight:600;border-bottom:1px solid #f0f0f0;text-align:center;transition:color .25s,font-weight .25s;\">비행 시간 증가 · 안전성 향상</td>\r\n          </tr>\r\n          <tr style=\"background:#fbfbfd;\">\r\n            <td style=\"padding:17px 16px;border-bottom:1px solid #f0f0f0;color:#888;\">구성품</td>\r\n            <td class=\"col-ln\" style=\"padding:17px 16px;color:#b0b0b8;border-bottom:1px solid #f0f0f0;text-align:center;transition:color .25s,font-weight .25s;\">프로펠러(1쌍) × 1</td>\r\n            <td class=\"col-st\" style=\"padding:17px 16px;color:#111;font-weight:600;border-bottom:1px solid #f0f0f0;text-align:center;transition:color .25s,font-weight .25s;\">프로펠러(1쌍) × 1</td>\r\n          </tr>\r\n          <tr style=\"\">\r\n            <td style=\"padding:17px 16px;color:#888;\">호환 제품</td>\r\n            <td class=\"col-ln\" style=\"padding:17px 16px;color:#b0b0b8;text-align:center;transition:color .25s,font-weight .25s;\">DJI Matrice 4 시리즈</td>\r\n            <td class=\"col-st\" style=\"padding:17px 16px;color:#111;font-weight:600;text-align:center;transition:color .25s,font-weight .25s;\">DJI Matrice 4 시리즈</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;margin-top:28px;\">\r\n      <div style=\"background:#ffffff;border:1px solid #ececec;border-radius:14px;padding:26px;\">\r\n        <p style=\"font-size:18px;font-weight:700;color:#444;margin:0 0 8px;\">🔇 저소음 프로펠러가 적합한 경우</p>\r\n        <p style=\"font-size:15.5px;color:#555;margin:0;line-height:1.8;\">도심·주거 밀집 지역 임무, 야간 비행, 시설물 안전진단처럼 <strong>비행 소음이 민원·작업 환경에 영향을 주는 현장</strong>에 적합합니다.</p>\r\n      </div>\r\n      <div style=\"background:#ffffff;border:1px solid #dbe6ff;border-radius:14px;padding:26px;\">\r\n        <p style=\"font-size:18px;font-weight:700;color:#2b6cff;margin:0 0 8px;\">⚙️ 일반 프로펠러가 적합한 경우</p>\r\n        <p style=\"font-size:15.5px;color:#555;margin:0;line-height:1.8;\">개당 무게가 더 가벼운 표준 구성으로, <strong>일반적인 측량·순찰·촬영 임무의 기본 교체용</strong>으로 적합합니다.</p></div></div>\r\n\r\n    <script>\r\n    (function() {\r\n      var table = document.getElementById(\'prop-table-st\');\r\n      if (!table) return;\r\n      var hint = document.getElementById(\'prop-hint-st\');\r\n      if (hint) hint.style.display = \'block\';\r\n      function paint(cls, active) {\r\n        var cells = table.querySelectorAll(\'td.\' + cls);\r\n        for (var i = 0; i < cells.length; i++) {\r\n          cells[i].style.color = active ? \'#111111\' : \'#b0b0b8\';\r\n          cells[i].style.fontWeight = active ? \'600\' : \'400\';\r\n        }\r\n        var th = table.querySelector(\'th.\' + cls.split(\' \')[0]);\r\n        th.style.color = active ? \'#2b6cff\' : \'#999999\';\r\n        th.style.borderBottom = active ? \'2px solid #2b6cff\' : \'2px solid #dddddd\';\r\n        th.style.background = active ? \'#eef3ff\' : \'#f4f4f6\';\r\n        th.style.cursor = \'pointer\';\r\n      }\r\n      function activate(which) {\r\n        paint(\'col-ln\', which === \'ln\');\r\n        paint(\'col-st\', which === \'st\');\r\n      }\r\n      document.getElementById(\'th-ln-st\').addEventListener(\'click\', function() { activate(\'ln\'); });\r\n      document.getElementById(\'th-st-st\').addEventListener(\'click\', function() { activate(\'st\'); });\r\n      activate(\'st\');\r\n    })();\r\n    </script>\r\n  </div>\r\n\r\n</div>]]></goodsDescription>
