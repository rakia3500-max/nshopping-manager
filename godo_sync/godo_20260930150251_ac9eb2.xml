dding:52px 16px;}\r\n.pkg-table{width:100%;border-collapse:collapse;font-size:12px;margin-top:24px;border-radius:14px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,.06);}\r\n.pkg-table th{background:var(--navy);color:#fff;padding:12px 10px;text-align:center;font-size:11px;font-weight:600;line-height:1.4;}\r\n.pkg-table th:first-child{text-align:left;}\r\n.pkg-table td{padding:11px 10px;border-bottom:1px solid var(--gray-100);text-align:center;color:var(--gray-600);}\r\n.pkg-table td:first-child{text-align:left;color:var(--black);font-weight:500;}\r\n.pkg-table tr:last-child td{border-bottom:none;}\r\n.pkg-table tr:nth-child(even) td{background:var(--gray-50);}\r\n.chk{color:var(--accent);font-weight:700;}\r\n\r\n/* 사양표 */\r\n.spec-section{background:var(--gray-50);padding:52px 16px;border-top:1px solid var(--gray-100);}\r\n.spec-group{margin-bottom:28px;}\r\n.spec-group-title{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:10px;border-left:3px solid var(--accent);padding-left:10px;}\r\n.spec-table{width:100%;border-collapse:collapse;font-size:12px;}\r\n.spec-table tr:nth-child(even){background:#fff;}\r\n.spec-table tr:nth-child(odd){background:var(--gray-50);}\r\n.spec-table td{padding:10px 12px;border-bottom:1px solid var(--gray-100);color:var(--gray-800);line-height:1.5;vertical-align:top;}\r\n.spec-table td:first-child{font-weight:600;color:var(--navy);white-space:nowrap;width:38%;}\r\n\r\n/* FAQ */\r\n.faq-section{padding:52px 16px;background:#fff;}\r\n.faq-item{border-bottom:1px solid var(--gray-100);padding:18px 0;}\r\n.faq-q{font-size:14px;font-weight:700;color:var(--black);line-height:1.5;display:flex;align-items:flex-start;gap:10px;}\r\n.faq-q::before{content:\'Q\';flex-shrink:0;width:22px;height:22px;background:var(--accent);color:#fff;border-radius:6px;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-top:1px;}\r\n.faq-a{font-size:13px;color:var(--gray-600);line-height:1.8;margin-top:10px;padding-left:32px;}\r\n\r\n/* 주의사항 */\r\n.notice-section{background:var(--gray-50);padding:36px 20px;border-top:1px solid var(--gray-100);}\r\n.notice-section h3{font-size:13px;font-weight:700;color:var(--gray-800);margin-bottom:14px;}\r\n.notice-section ol{padding-left:18px;}\r\n.notice-section li{font-size:11px;color:var(--gray-600);line-height:1.75;margin-bottom:5px;}\r\n</style>\r\n\r\n\r\n\r\n<!-- HERO -->\r\n<section class=\"section hero\">\r\n  <div class=\"hero-badge\">🏪 드론박스 공식 판매처</div>\r\n  <p class=\"hero-eyebrow\">DJI MIC MINI 2</p>\r\n  <h1>찍는 순간,<br><em>프로가 됩니다</em></h1>\r\n  <p class=\"hero-sub\">10g의 무게로 스튜디오급 사운드.<br>유튜버, 크리에이터, 기업 인터뷰까지 하나로.</p>\r\n  <div class=\"hero-img-wrap\">\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1777382295/MIC_MINI2-%E1%84%89%E1%85%A1%E1%86%BC%E1%84%89%E1%85%A6-1_mwqbjq.jpg\" alt=\"DJI Mic Mini 2 다양한 컬러\" onerror=\"this.style.display=\'none\'\">\r\n  </div>\r\n  <div class=\"hero-chips\">\r\n    <div class=\"chip\"><strong>10g</strong> 초경량</div>\r\n    <div class=\"chip\"><strong>48시간</strong> 배터리</div>\r\n    <div class=\"chip\"><strong>2단계</strong> 노이즈 캔슬링</div>\r\n    <div class=\"chip\"><strong>DJI</strong> 정품 보증</div>\r\n    <div class=\"chip\">당일 출고</div>\r\n  </div>\r\n</section>\r\n\r\n<!-- 상세 이미지 2~3 -->\r\n<section class=\"section detail-imgs\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1777382295/MIC_MINI2-%E1%84%89%E1%85%A1%E1%86%BC%E1%84%89%E1%85%A6-2_sqwfew.jpg\" alt=\"DJI Mic Mini 2 선택해야 하는 6가지 이유\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1777382297/MIC_MINI2-%E1%84%89%E1%85%A1%E1%86%BC%E1%84%89%E1%85%A6-3_gv5go5.jpg\" alt=\"미니 사이즈 다채로운 스타일\">\r\n</section>\r\n\r\n<!-- 6가지 이유 -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">Why DJI Mic Mini 2</span>\r\n  <h2>선택해야 하는 <em>6가지 이유</em></h2>\r\n  <p>컴팩트함과 성능, 그 모든 것을 하나에.</p>\r\n</div>\r\n<div class=\"reasons-wrap\">\r\n  <div class=\"reasons-grid\">\r\n    <div class=\"r-card full\">\r\n      <div class=\"r-icon\">🎒</div>\r\n      <div class=\"r-tag\">수납 · 휴대</div>\r\n      <h3>주머니에 쏙, 스튜디오는 내 손 안에</h3>\r\n      <p>업그레이드된 충전 케이스로 오디오 케이블과 마그네틱 클립을 함께 수납. 어디서나 바로 꺼내 녹음할 수 있습니다.</p>\r\n    </div>\r\n    <div class=\"r-card\">\r\n      <div class=\"r-icon\">📱</div>\r\n      <div class=\"r-tag\">호환성</div>\r\n      <h3>스마트폰·카메라·노트북, 연결은 자유롭게</h3>\r\n      <p>iPhone, Android, 카메라, 컴퓨터까지 어떤 기기와도 페어링 가능.</p>\r\n    </div>\r\n    <div class=\"r-card\">\r\n      <div class=\"r-icon\">🛡️</div>\r\n      <div class=\"r-tag\">안정성</div>\r\n      <h3>갑자기 큰 소리에도 녹음이 깨지지 않습니다</h3>\r\n      <p>자동 오디오 클리핑 방지로 예상치 못한 순간도 안심.</p>\r\n    </div>\r\n    <div class=\"r-card\">\r\n      <div class=\"r-icon\">🎛️</div>\r\n      <div class=\"r-tag\">음질</div>\r\n      <h3>장소·목적에 맞게 소리를 내 스타일로</h3>\r\n      <p>3가지 음성 톤 프리셋 + 2단계 노이즈 캔슬링으로 완벽한 사운드.</p>\r\n    </div>\r\n    <div class=\"r-card\">\r\n      <div class=\"r-icon\">🔗</div>\r\n      <div class=\"r-tag\">DJI 생태계</div>\r\n      <h3>오즈모 유저라면 수신기 없이 바로 연결</h3>\r\n      <p>DJI OsmoAudio 직접 연결로 48kHz 24-bit 고품질 오디오 구현.</p>\r\n    </div>\r\n    <div class=\"r-card full\">\r\n      <div class=\"r-icon\">🔋</div>\r\n      <div class=\"r-tag\">배터리</div>\r\n      <h3>하루 종일 촬영해도 배터리 걱정 없음</h3>\r\n      <p>최대 48시간 작동. 5분 충전으로 1시간 녹음 가능한 고속 충전 지원.</p>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- 상세 이미지 4~6 -->\r\n<section class=\"section detail-imgs\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1777382297/MIC_MINI2-%E1%84%89%E1%85%A1%E1%86%BC%E1%84%89%E1%85%A6-4_aucaib.jpg\" alt=\"프로급 오디오 모든 디테일까지 담아내다\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1777382294/MIC_MINI2-%E1%84%89%E1%85%A1%E1%86%BC%E1%84%89%E1%85%A6-5_ugxxud.jpg\" alt=\"범용 호환성 멀티 세대 연결\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1777382294/MIC_MINI2-%E1%84%89%E1%85%A1%E1%86%BC%E1%84%89%E1%85%A6-6_frra0r.jpg\" alt=\"48시간의 작동 시간 및 절전\">\r\n</section>\r\n\r\n<!-- 오디오 기능 -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">Audio Performance</span>\r\n  <h2>프로급 오디오,<br><em>모든 디테일까지</em></h2>\r\n  <p>DJI Mimo 앱으로 상황에 맞는 사운드를 설정하세요.</p>\r\n</div>\r\n<div class=\"audio-wrap\">\r\n  <div class=\"feat-block\">\r\n    <h3>🎵 3가지 음성 톤 프리셋</h3>\r\n    <p>DJI Mimo 앱에서 상황에 맞는 음색을 선택하세요. 스토리텔링에 어울리는 사운드를 완성합니다.</p>\r\n    <div class=\"preset-list\">\r\n      <div class=\"pst\">\r\n        <div class=\"pst-dot\" style=\"background:#e8f4fb;\">🎵</div>\r\n        <div><h4>일반 (Regular)</h4><p>자연스러운 균형 잡힌 오디오. 일상·브이로그에 최적.</p></div>\r\n      </div>\r\n      <div class=\"pst\">\r\n        <div class=\"pst-dot\" style=\"background:#fff4e0;\">🎤</div>\r\n        <div><h4>리치 (Rich)</h4><p>인터뷰·인물 목소리를 더욱 풍부하고 따뜻하게.</p></div>\r\n      </div>\r\n      <div class=\"pst\">\r\n        <div class=\"pst-dot\" style=\"background:#e8faf0;\">☀️</div>\r\n        <div><h4>브라이트 (Bright)</h4><p>야외·활동적인 촬영을 위한 선명하고 경쾌한 음질.</p></div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <div class=\"feat-block\">\r\n    <h3>🛡️ 2단계 노이즈 캔슬링</h3>\r\n    <p>촬영 환경에 따라 기본 / 강함 모드로 선택하여 주변 소음을 효과적으로 차단합니다.</p>\r\n    <div class=\"noise-pair\">\r\n      <div class=\"nc\"><h4>기본 모드</h4><p>주변 소음을 자연스럽게 줄여 음성을 또렷하게 녹음</p></div>\r\n      <div class=\"nc\"><h4>강함 모드</h4><p>시끄러운 환경에서도 주변 소음을 적극 차단</p></div>\r\n    </div>\r\n  </div>\r\n  <div class=\"feat-block\">\r\n    <h3>🎙️ 전방향 무선 오디오 녹음</h3>\r\n    <p>48kHz 24-bit 고음질 포맷으로 녹음. 마이크를 올바른 방향으로 유지하면 최상의 다이렉트 오디오를 얻을 수 있습니다.</p>\r\n  </div>\r\n  <div class=\"feat-block\">\r\n    <h3>📉 자동 오디오 클리핑 방지</h3>\r\n    <p>오디오 입력이 과도할 경우 자동으로 제한해 불필요한 클리핑을 방지하고 안정적인 음질을 유지합니다. 브이로그와 라이브 방송에도 안심.</p>\r\n  </div>\r\n</div>\r\n\r\n<!-- 상세 이미지 7 -->\r\n<section class=\"section detail-imgs\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1777382295/MIC_MINI2-%E1%84%89%E1%85%A1%E1%86%BC%E1%84%89%E1%85%A6-7_ndjcui.jpg\" alt=\"유기적으로 연결된 생태계 매끄러운 창작\">\r\n</section>\r\n\r\n<!-- 배터리 -->\r\n<section class=\"battery-section\">\r\n  <div class=\"sh\" style=\"padding-top:0;\">\r\n    <span class=\"sh-label\">Battery &amp; Power</span>\r\n    <h2 style=\"color:var(--navy);\">48시간,<br><em>끊김 없는 창작</em></h2>\r\n    <p>종일 회의부터 야외 촬영까지, 배터리 걱정 없이 사용하세요.</p>\r\n  </div>\r\n  <div class=\"batt-stats\">\r\n    <div class=\"bst\"><div class=\"bst-num\">11.5h</div><div class=\"bst-label\">송신기<br>단독 사용</div></div>\r\n    <div class=\"bst\"><div class=\"bst-num\">10.5h</div><div class=\"bst-label\">수신기<br>단독 사용</div></div>\r\n    <div class=\"bst full\"><div class=\"bst-num\">48h</div><div class=\"bst-label\">충전 케이스 포함 최대 작동 시간</div></div>\r\n  </div>\r\n  <div class=\"charge-box\">\r\n    <div class=\"charge-title\">⚡ 5분 충전 → 1시간 녹음</div>\r\n    <div class=\"cbar-row\">\r\n      <span class=\"cbar-label\">송신기</span>\r\n      <div class=\"cbar\"><div class=\"cbar-fill\" style=\"width:70%;\"></div></div>\r\n      <span class=\"cbar-val\">70분</span>\r\n    </div>\r\n    <div class=\"cbar-row\">\r\n      <span class=\"cbar-label\">수신기</span>\r\n      <div class=\"cbar\"><div class=\"cbar-fill\" style=\"width:100%;\"></div></div>\r\n      <span class=\"cbar-val\">100분</span>\r\n    </div>\r\n  </div>\r\n  <div class=\"power-grid\">\r\n    <div class=\"pw\"><h4>🔌 자동 절전</h4><p>신호가 끊기면 자동으로 절전 모드 전환, 신호 복귀 시 즉시 활성화</p></div>\r\n    <div class=\"pw\"><h4>⏰ 자동 꺼짐</h4><p>15분 연결이 끊기면 자동으로 전원이 꺼져 배터리 방전 방지</p></div>\r\n    <div class=\"pw\"><h4>📷 카메라 연동</h4><p>3.5mm TRS 연결 시 카메라 전원과 연동해 자동으로 켜고 꺼짐</p></div>\r\n    <div class=\"pw\"><h4>🔋 충전 중 사용</h4><p>스마트폰으로 수신기에 전원 공급하거나 외부 전원 연결 중에도 녹음 가능</p></div>\r\n  </div>\r\n</section>\r\n\r\n<!-- 상세 이미지 8 -->\r\n<section class=\"section detail-imgs\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1777382294/MIC_MINI2-%E1%84%89%E1%85%A1%E1%86%BC%E1%84%89%E1%85%A6-8_b9qysi.jpg\" alt=\"실용적인 액세서리 안정적인 지원\">\r\n</section>\r\n\r\n<!-- 호환성 -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">Compatibility</span>\r\n  <h2>어떤 기기와도<br><em>연결됩니다</em></h2>\r\n  <p>스마트폰, 카메라, 컴퓨터까지 표준 수신기 1대로 모든 기기와 페어링.</p>\r\n</div>\r\n<div class=\"compat-wrap\">\r\n  <div class=\"compat-grid\">\r\n    <div class=\"cc\"><div class=\"cc-icon\">📱</div><h4>모바일 수신기</h4><p>iPhone 15 이상 및 Android (USB-C). DJI Mimo 앱으로 노이즈 캔슬링·프리셋 세밀 설정 가능.</p></div>\r\n    <div class=\"cc\"><div class=\"cc-icon\">📸</div><h4>카메라 수신기</h4><p>3.5mm TRS 포트에 직접 연결. Sony, Canon, Nikon 등 주요 브랜드 지원.</p></div>\r\n    <div class=\"cc full\"><div class=\"cc-icon\">🔗</div><h4>DJI OsmoAudio 직접 연결</h4><p>Osmo Action 6, Osmo Pocket 3, Osmo 360, Osmo Nano에 수신기 없이 직접 연결. 48kHz 24-bit 고품질 오디오 구현.</p></div>\r\n  </div>\r\n  <div class=\"range-box\">\r\n    <div class=\"range-title\">📡 전송 거리</div>\r\n    <div class=\"rr\"><span class=\"rr-label\">표준 수신기</span><div class=\"rbar\"><div class=\"rfill\" style=\"width:100%;\"></div></div><span class=\"rval\">400m</span></div>\r\n    <div class=\"rr\"><span class=\"rr-label\">모바일 수신기</span><div class=\"rbar\"><div class=\"rfill\" style=\"width:75%;\"></div></div><span class=\"rval\">300m</span></div>\r\n  </div>\r\n</div>\r\n\r\n<!-- Osmo 생태계 -->\r\n<section class=\"osmo-section\">\r\n  <div class=\"sh\">\r\n    <span class=\"sh-label\">DJI Ecosystem</span>\r\n    <h2>유기적으로 연결된<br><em>DJI 생태계</em></h2>\r\n    <p>OsmoAudio 지원 기기와 완벽하게 연결됩니다.</p>\r\n  </div>\r\n  <div class=\"osmo-grid\">\r\n    <div class=\"oc\"><div class=\"oc-thumb\">🎬</div><div class=\"oc-body\"><h4>Osmo Action 6</h4><p>자전거, 다이빙, 여행 등 모든 순간을 몰입감 있는 오디오로</p></div></div>\r\n    <div class=\"oc\"><div class=\"oc-thumb\">🎥</div><div class=\"oc-body\"><h4>Osmo Pocket 3</h4><p>고화질 영상에 프로급 오디오를. 브이로그·라이브 스트리밍에 이상적</p></div></div>\r\n    <div class=\"oc\"><div class=\"oc-thumb\">🌐</div><div class=\"oc-body\"><h4>Osmo 360</h4><p>360° 뷰와 야간 도시 풍경. 전방위 완전 몰입형 사운드</p></div></div>\r\n    <div class=\"oc\"><div class=\"oc-thumb\">✨</div><div class=\"oc-body\"><h4>Osmo Nano</h4><p>맑고 선명한 사운드. 스포츠·여행 촬영에 적합</p></div></div>\r\n  </div>\r\n</section>\r\n\r\n<!-- 상세 이미지 9 -->\r\n<section class=\"section detail-imgs\">\r\n