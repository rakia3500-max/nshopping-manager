,180,.08);border:1.5px solid rgba(0,149,218,.12);}\r\n.bst.full{grid-column:1/-1;}\r\n.bst-num{font-family:\'Outfit\',sans-serif;font-size:36px;font-weight:800;color:var(--accent);line-height:1;margin-bottom:6px;}\r\n.bst-label{font-size:12px;color:var(--gray-600);line-height:1.5;}\r\n.charge-box{background:#fff;border-radius:16px;padding:20px;box-shadow:0 4px 16px rgba(0,100,180,.08);border:1.5px solid rgba(0,149,218,.12);max-width:480px;margin:0 auto 20px;}\r\n.charge-title{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:16px;}\r\n.cbar-row{display:flex;align-items:center;gap:10px;margin-bottom:10px;}\r\n.cbar-row:last-child{margin-bottom:0;}\r\n.cbar-label{font-size:12px;color:var(--gray-600);flex:0 0 52px;}\r\n.cbar{height:8px;border-radius:4px;background:var(--gray-100);flex:1;overflow:hidden;}\r\n.cbar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--accent),var(--accent-2));}\r\n.cbar-val{font-size:12px;font-weight:700;color:var(--accent);flex:0 0 36px;text-align:right;}\r\n.power-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:480px;margin:0 auto;}\r\n.pw{background:#fff;border-radius:14px;padding:16px;box-shadow:0 2px 10px rgba(0,0,0,.05);border:1.5px solid var(--gray-100);}\r\n.pw h4{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:5px;}\r\n.pw p{font-size:11px;color:var(--gray-600);line-height:1.6;}\r\n\r\n/* 호환성 */\r\n.compat-wrap{padding:0 16px 52px;}\r\n.compat-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;}\r\n.cc{background:#fff;border:1.5px solid var(--gray-100);border-radius:16px;padding:20px 16px;box-shadow:0 2px 10px rgba(0,0,0,.04);}\r\n.cc.full{grid-column:1/-1;}\r\n.cc-icon{font-size:26px;margin-bottom:10px;}\r\n.cc h4{font-size:14px;font-weight:700;margin-bottom:6px;}\r\n.cc p{font-size:12px;color:var(--gray-600);line-height:1.65;}\r\n.range-box{background:var(--accent-light);border-radius:16px;padding:20px;border:1.5px solid rgba(0,149,218,