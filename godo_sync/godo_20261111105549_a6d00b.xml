0;color:#1f3d52;margin-bottom:8px;}\r\n  .faq .q b::before{content:\"Q. \";color:#5292BF;}\r\n  .faq .q p{font-size:14.5px;color:#566069;}\r\n  .faq .q p::before{content:\"A. \";font-weight:700;color:#8FC8CA;}\r\n\r\n  /* ===== 주석 ===== */\r\n  .notes{padding:40px 32px;background:#0f2740;color:#9fb4c4;}\r\n  .notes h4{font-size:14px;color:#cfe0eb;margin-bottom:14px;font-weight:700;}\r\n  .notes ol{padding-left:18px;}\r\n  .notes li{font-size:11.5px;line-height:1.6;margin-bottom:6px;}\r\n\r\n  /* ===== CTA ===== */\r\n  .cta{background:linear-gradient(135deg,#5292BF 0%,#0f2740 100%);color:#fff;text-align:center;padding:60px 32px;}\r\n  .cta h2{font-size:28px;font-weight:800;margin-bottom:12px;}\r\n  .cta p{font-size:16px;opacity:.9;margin-bottom:26px;}\r\n  .cta a{\r\n    display:inline-block;background:#fff;color:#0f2740;font-weight:700;font-size:16px;\r\n    padding:15px 40px;border-radius:99px;text-decoration:none;transition:transform .15s;\r\n  }\r\n  .cta a:hover{transform:translateY(-2px);}\r\n\r\n  /* ===== 반응형 ===== */\r\n  @media (max-width:768px){\r\n    .hero{padding:54px 22px 48px;}\r\n    .hero h1{font-size:32px;}\r\n    .hero .sub{font-size:17px;}\r\n    .sec{padding:44px 22px;}\r\n    .intro{padding:42px 22px;}\r\n    .intro p{font-size:16px;}\r\n    .sec h2{font-size:25px;}\r\n    .feat{grid-template-columns:1fr;gap:14px;}\r\n    .stats{grid-template-columns:repeat(2,1fr);}\r\n    .reco{grid-template-columns:1fr;}\r\n    .models{grid-template-columns:1fr;}\r\n    .care{grid-template-columns:repeat(2,1fr);}\r\n    .trust .item{flex:1 1 50%;border-bottom:1px solid rgba(255,255,255,.1);}\r\n    .ctable{font-size:13px;}\r\n    .ctable th,.ctable td{padding:11px 8px;}\r\n  }\r\n  @media (max-width:480px){\r\n    .hero h1{font-size:27px;}\r\n    .hero{padding:46px 18px 40px;}\r\n    .sec{padding:38px 18px;}\r\n    .sec h2{font-size:22px;}\r\n    .sec .lead{font-size:14.5px;}\r\n    .stats .s b{font-size:25px;}\r\n    .cta h2{font-size:23px;}\r\n    .care{grid-template-columns:1fr;}\r\n  }\r\n  @media (max-width:360px){\r\n    .hero h1{font-size:24px;}\r\n    .stats{grid-template-columns:1fr;}\r\n    .ctable{font-size:12px;}\r\n    .ctable th,.ctable td{padding:9px 5px;}\r\n  }\r\n</style>\r\n\r\n\r\n<div class=\"wrap\">\r\n\r\n  <!-- HERO -->\r\n  <section class=\"hero\">\r\n    <span class=\"eyebrow\">강력한 광역 전송 시스템</span>\r\n    <h1>DJI O4 Ground Station</h1>\r\n    <div class=\"sub\">신호 한계를 넘어, 더 멀리 닿다</div>\r\n    <div class=\"slogan\">Reach Farther, Stay Aware</div>\r\n  </section>\r\n\r\n  <!-- 신뢰 배너 -->\r\n  <section class=\"trust\">\r\n    <div class=\"item\"><b>DJI 공식 딜러</b><span>드론박스 정품 보증</span></div>\r\n    <div class=\"item\"><b>기업 솔루션 전문</b><span>도입·운영 컨설팅</span></div>\r\n    <div class=\"item\"><b>전국 A/S 지원</b><span>전문가 신속 대응</span></div>\r\n    <div class=\"item\"><b>현장 교육</b><span>운영 매뉴얼 제공</span></div>\r\n  </section>\r\n\r\n  <!-- 인트로 -->\r\n  <section class=\"intro\">\r\n    <p>\r\n      신호 한계를 극복하도록 설계된 <span class=\"hl\">DJI O4 Ground Station</span>은\r\n      <span class=\"hl\">12개 안테나 배열</span>과 <span class=\"hl\">멀티 밴드 자동 전환</span> 기능을 갖추었습니다.\r\n      새로운 <span class=\"hl\">게이트웨이 모드</span>는 FlightHub 2에 직접 연결되어 구축 제약을 줄이고,\r\n      <span class=\"hl\">릴레이 모드</span>는 오프라인 통신을 지원합니다.\r\n      유지 보수가 필요 없도록 설계되어 <span class=\"hl\">24시간 상시 무인 운영</span>을 지원합니다.\r\n    </p>\r\n  </section>\r\n\r\n  <figure style=\"margin:0;\"><img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782266935/image_url_1_kordfl.png\" alt=\"DJI O4 Ground Station 제품 전경\"></figure>\r\n\r\n  <!-- 핵심 기능 -->\r\n  <section class=\"sec sec--alt\">\r\n    <span class=\"label\">KEY FEATURES</span>\r\n    <h2>현장을 지키는 6가지 핵심 역량</h2>\r\n    <div class=\"feat\">\r\n      <div class=\"card\"><span class=\"num\">1</span><h3>향상된 하드웨어, 강력한 전송</h3><p>고성능 RF 유닛과 12개 안테나 배열로 도심 장애물 속에서도 안정적인 연결을 유지합니다.</p></div>\r\n      <div class=\"card\"><span class=\"num\">2</span><h3>게이트웨이 모드, 광범위한 커버리지</h3><p>FlightHub 2에 직접 연결되어 Dock의 근접 제약 없이 최대 30km까지 커버리지를 확장합니다.</p></div>\r\n      <div class=\"card\"><span class=\"num\">3</span><h3>릴레이 모드, 오프라인 통신 지원</h3><p>네트워크가 닿지 않는 계곡·도심에서도 고지대 설치로 전송 범위를 넓힙니다.</p></div>\r\n      <div class=\"card\"><span class=\"num\">4</span><h3>견고한 디자인, 스마트 전원</h3><p>IP67 방수·방진과 -40~55°C 작동, 무유지보수 설계로 혹독한 환경에서도 무인 운영이 가능합니다.</p></div>\r\n      <div class=\"card\"><span class=\"num\">5</span><h3>개방형 생태계, 유연한 통합</h3><p>IP 카메라 연동과 오픈 ESDK로 다양한 산업별 맞춤 솔루션을 구축할 수 있습니다.</p></div>\r\n      <div class=\"card\"><span class=\"num\">6</span><h3>DJI Care Enterprise</h3><p>종합 보상·무료 수리·전문가 서비스로 비행단 전체를 안심하고 운용하세요.</p></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 1. 하드웨어 -->\r\n  <section class=\"sec\">\r\n    <span class=\"label\">ADVANCED HARDWARE</span>\r\n    <h2>향상된 하드웨어<br>강력한 전송</h2>\r\n    <p class=\"lead\">신호 투과율을 높이고 끊김 없는 연결을 보장하는 통신 코어.</p>\r\n    <figure><img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782266935/image_url_2_kjwod7.jpg\" alt=\"고성능 RF 유닛과 안테나 배열\"></figure>\r\n\r\n    <div class=\"stats\">\r\n      <div class=\"s\"><b>12</b><span>내·외부 안테나</span></div>\r\n      <div class=\"s\"><b>40km</b><span>최대 전송 범위<sup>[5]</sup></span></div>\r\n      <div class=\"s\"><b>5계통</b><span>19주파수 GNSS</span></div>\r\n      <div class=\"s\"><b>4밴드</b><span>자동 멀티밴드<sup>[1]</sup></span></div>\r\n    </div>\r\n\r\n    <div class=\"feat\" style=\"margin-top:34px;\">\r\n      <div class=\"card\"><h3>고성능 RF 유닛</h3><p>고출력 RF 유닛이 신호 투과율과 커버리지를 크게 향상시켜, 밀집된 도심의 장애물 사이에서도 안정적인 연결을 보장합니다. 최적화된 SNR로 복잡한 전자기 환경에서도 사용 가능한 신호를 복구합니다.</p></div>\r\n      <div class=\"card\"><h3>전방향 하이 게인 안테나</h3><p>수평·수직 편파의 12개 내·외부 안테나로 전방향 하이 게인 커버리지를 제공합니다. 기체 위치와 관계없이 신호를 안정적으로 수신해 끊김 없는 통신을 유지합니다.</p></div>\r\n      <div class=\"card\"><h3>자동 멀티밴드 선택<sup>[1]</sup></h3><p>Sub2G·2.4GHz·5.2GHz·5.8GHz 대역을 자동 전환해 간섭을 회피합니다. 선명하고 끊김 없는 영상 피드를 제공하며, Matrice 400과 함께라면 최대 40km 전송을 지원합니다.</p></div>\r\n      <div class=\"card\"><h3>5계통 19주파수 GNSS</h3><p>통합 하이 게인 RTK 모듈이 5개 위성 시스템의 19개 주파수를 추적합니다. 도시 협곡·울창한 수관층에서도 센티미터급 위치 데이터를 지속 제공합니다.</p></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 2. 게이트웨이 -->\r\n  <section class=\"sec sec--alt\">\r\n    <span class=\"label\">GATEWAY MODE</span>\r\n    <h2>게이트웨이 모드<sup style=\"font-size:.5em\">[2]</sup><br>광범위한 커버리지</h2>\r\n    <p class=\"lead\">FlightHub 2에 직접 연결해 구축 제약을 줄이는 새로운 운영 방식.</p>\r\n    <figure><img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782266935/image_url_3_qo0ro4.jpg\" alt=\"게이트웨이 모드 네트워크 연결\"></figure>\r\n    <div class=\"feat\">\r\n      <div class=\"card\"><h3>네트워크 직접 연결</h3><p>이더넷 또는 DJI 셀룰러 동글 2를 통해 FlightHub 2에 직접 연결, 저지연·고대역폭 영상을 전송합니다. Dock 3의 근접 제약에서 벗어나 최대 30km까지 커버리지를 확장합니다.</p></div>\r\n      <div class=\"card\"><h3>정밀 배치를 위한 신호 맵<sup>[8]</sup></h3><p>비행 후 FlightHub 2가 비행 데이터로 취약 커버리지 구역을 시각화한 신호 맵을 생성, 지상국을 더 정밀하게 배치하도록 돕습니다.</p></div>\r\n      <div class=\"card\"><h3>민첩한 제어, 버추얼 콕핏<sup>[8]</sup></h3><p>게이트웨이 모드에서 FlightHub 2 버추얼 콕핏으로 기체를 원격 제어합니다. 커버리지 내에서 사전 경로를 수동 변경해 다지점 임무에 빠르게 대응합니다.</p></div>\r\n      <div class=\"card\"><h3>스마트 저전력 모드<sup>[8][14]</sup></h3><p>기체 미연결 시 자동 절전으로 대기 전력 7W만 소비합니다. 전력망이 없는 환경에서는 태양광 솔루션과 연결해 외딴 지역에서도 장기 운영이 가능합니다.</p></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 3. 릴레이 -->\r\n  <section class=\"sec\">\r\n    <span class=\"label\">RELAY MODE</span>\r\n    <h2>릴레이 모드<sup style=\"font-size:.5em\">[4]</sup><br>오프라인 통신 지원</h2>\r\n    <p class=\"lead\">네트워크가 닿지 않는 현장에서 전송 범위를 넓히는 D-RTK 3 릴레이 계승 기능.</p>\r\n    <figure><img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782266935/image_url_4_iwsa9q.jpg\" alt=\"릴레이 모드 고지대 설치\"></figure>\r\n    <div class=\"feat\">\r\n      <div class=\"card\"><h3>장애물 영향을 줄이는 고지대 설치</h3><p>D-RTK 3 릴레이 고정 배치 버전의 기능을 계승합니다. 계곡·신호 차단이 심한 도심처럼 연결이 어려운 지역에서 릴레이 모드로 전환, 고지대에 배치해 기체 동영상 전송 범위를 확장합니다.</p></div>\r\n      <div class=\"card\"><h3>다중 기기 순환 운용<sup>[9][10]</sup></h3><p>신호 범위 내 조종기나 DJI Dock이 O4 Ground Station을 원격 검색·연결합니다. 하나의 스테이션이 여러 기체를 순차 지원해 하드웨어 활용도를 높입니다.</p></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 모드 비교표 -->\r\n  <section class=\"sec sec--alt\">\r\n    <span class=\"label\">MODE COMPARISON</span>\r\n    <h2>게이트웨이 모드 vs 릴레이 모드</h2>\r\n    <p class=\"lead\">운영 환경에 따라 두 가지 모드를 선택해 사용할 수 있습니다.</p>\r\n    <table class=\"ctable\">\r\n      <thead>\r\n        <tr><th>구분</th><th>게이트웨이 모드<sup>[2]</sup></th><th>릴레이 모드<sup>[4]</sup></th></tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr><th>핵심 역할</th><td>FlightHub 2 직접 연결</td><td>오프라인 전송 범위 확장</td></tr>\r\n        <tr><th>연결 방식</th><td>이더넷 / 셀룰러 동글 2</td><td>무선 릴레이(5GHz)</td></tr>\r\n        <tr><th>최대 커버리지</th><td>최대 30km<sup>[7]</sup></td><td>고지대 설치로 확장</td></tr>\r\n        <tr><th>호환 기체</th><td>DJI Dock 3</td><td>Dock 3 · Matrice 400 · 4E/4T · 4D/4TD</td></tr>\r\n        <tr><th>적합 환경</th><td>네트워크 가능 지역, 광역 무인 운영</td><td>계곡·산악·통신 음영 지역</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </section>\r\n\r\n  <!-- 4. 견고한 디자인 -->\r\n  <section class=\"sec\">\r\n    <span class=\"label\">DURABLE DESIGN</span>\r\n    <h2>견고한 디자인<br>스마트 전원</h2>\r\n    <p class=\"lead\">혹독한 야외 환경에서도 무인으로 작동하는 전천후 설계.</p>\r\n    <figure><img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782266935/image_url_5_tn9gzp.jpg\" alt=\"IP67 방수방진 견고한 설계\"></figure>\r\n    <div class=\"feat\">\r\n      <div class=\"card\"><h3>전천후 신뢰성<sup>[11][12]</sup></h3><p>IP67 등급의 방수·방진 성능과 -40~55°C 작동 범위로, 혹독한 야외 기후에서도 지속적인 무인 운영을 지원합니다.</p></div>\r\n      <div class=\"card\"><h3>피뢰 설계<sup>[13]</sup></h3><p>독자적인 낙뢰 보호 구성품과 접지 설계가 EN/IEC 61643-21 Category C 표준을 충족, 산·송전탑 등 고지대 배치 시 낙뢰 위험을 완화합니다.</p></div>\r\n      <div class=\"card\"><h3>무유지보수 설계</h3><p>팬리스 수동 냉각과 자체 복구 메커니즘으로 정전·소프트웨어 이상 후에도 자동 재개합니다. 현장 출장과 운영 비용을 절감합니다.</p></div>\r\n      <div class=\"card\"><h3>스마트 저전력 + 태양광<sup>[14][15]</sup></h3><p>대기 전력은 7W. 전력망이 없는 환경에서는 DJI Power 태양광 솔루션이나 타사 발전 시스템과 연결해 장기 운영이 가능합니다.</p></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 5. 개방형 생태계 -->\r\n  <section class=\"sec sec--alt\">\r\n    <span class=\"label\">OPEN ECOSYSTEM</span>\r\n    <h2>개방형 생태계<br>유연한 통합</h2>\r\n    <p class=\"lead\">IP 카메라 연동과 오픈 SDK로 산업별 맞춤 솔루션을 구축하세요.</p>\r\n    <figure><img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782266935/image_url_6_ezffcp.jpg\" alt=\"IP 카메라 연동 통합 관리\"></figure>\r\n    <div class=\"feat\">\r\n      <div class=\"card\"><h3>통합 시각적 관리</h3><p>최대 4대의 표준 IP 카메라를 ONVIF·GB/T 28181 프로토콜로 연동, FlightHub 2로 실시간 영상을 직접 스트리밍하고 변위 감지 알림을 동기화합니다. 원격 PTZ 제어로 작업 구역을 중앙에서 모니터링합니다.</p></div>\r\n      <div class=\"card\"><h3>오픈 ESDK</h3><p>MQTT 기반 ESDK 2.0 및 Cloud API로 업계별 맞춤 솔루션을 구축합니다. 타사 원격 ID·ADS-B 수신기와 연결해 주변 유·무인기를 실시간 파악, Dock 3 주변 공역을 선제적으로 보호합니다.</p></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 추천 카드 -->\r\n  <section class=\"sec\">\r\n    <span class=\"label\">BEST FOR</span>\r\n    <h2>이런 운영에 적합합니다</h2>\r\n    <p class=\"lead\">광역 무인 운영을 고민하는 현장이라면 O4 Ground Station이 해답입니다.</p>\r\n    <div class=\"reco\">\r\n      <div class=\"r\"><div class=\"tag\">광역 인프라 점검</div><h3>전력·도로·플랜트</h3><p>송전선·고속도로·파이프라인처럼 넓은 구역을 무인으로 순찰해야 하는 현장에 적합합니다.</p></div>\r\n      <div class=\"r\"><div class=\"tag\">통신 음영 지역</div><h3>산악·계곡 현장</h3><p>네트워크가 닿지 않는 지역에서 릴레이 모드로 전송 범위를 확장해 안정적으로 운영합니다.</p></div>\r\n      <div class=\"r\"><div class=\"tag\">24시간 무인 운영</div><h3>Dock 3 기반 자동화</h3><p>FlightHub 2 직접 연결과 무유지보수 설계로 상시 무인 비행 체계를 구축할 수 있습니다.</p></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 지원 모델 -->\r\n  <section class=\"sec sec--alt\">\r\n    <span class=\"label\">SUPPORTED MODELS</span>\r\n    <h2>지원 모델</h2>\r\n    <div class=\"models\">\r\n      <div class=\"m\">\r\n        <h3>게이트웨이 모드</h3>\r\n        <ul><li>DJI Dock 3</li></ul>\r\n      </div>\r\n      <div class=\"m\">\r\n        <h3>릴레이 모드<sup>*</sup></h3>\r\n        <ul>\r\n          <li>DJI Dock 3</li>\r\n          <li>DJI Matrice 400</li>\r\n          <li>DJI Matrice 4E</li>\r\n          <li>DJI Matrice 4T</li>\r\n          <li>DJI Matrice 4D (DJI RC Plus 2 Enterprise)</li>\r\n          <li>DJI Matrice 4TD (DJI RC Plus 2 Enterprise)</li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n    <p style=\"font-size:12px;color:#8a949c;margin-top:14px;text-align:center;\">* 일본·카자흐스탄 등 5GHz 주파수를 지원하지 않는 국가·지역에서는 릴레이 모드를 사용할 수 없습니다. 현지 법률 및 규정을 확인하세요.</p>\r\n  </section>\r\n\r\n  <!-- DJI Care Enterprise -->\r\n  <section class=\"sec\">\r\n    <span class=\"label\">DJI CARE ENTERPRISE</span>\r\n    <h2>DJI Care Enterprise</h2>\r\n    <p class=\"lead\">종합 보상 · 전문 품질 보증 · 독점 서비스 · 3년 차까지 갱신 가능</p>\r\n    <div class=\"care\">\r\n      <div class=\"c\"><b>무료 수리</b><span>보상 한도 내 무제한 지원</span></div>\r\n      <div class=\"c\"><b>비행단 공유 보상</b><span>최대한의 보장 공유 한도</span></div>\r\n      <div class=\"c\"><b>무료 배송</b><span>간편한 택배 수리 서비스</span></div>\r\n      <div class=\"c\"><b>전문가 서비스</b><span>DJI 제품 전문가 신속 대응</span></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 설치·운영 준비사항 (DJI 공식 FAQ 기반) -->\r\n  <section class=\"sec sec--alt\">\r\n    <span class=\"label\">SETUP &amp; DEPLOYMENT</span>\r\n    <h2>설치·운영 준비사항</h2>\r\n    <p class=\"lead\">현장 배치 전 전원·네트워크·앱 환경을 확인하세요. (DJI 공식 FAQ 기준)</p>\r\n    <div class=\"faq\">\r\n      <div class=\"q\"><b>전원은 어떻게 공급하나요?</b><p>DJI Dock 3의 PoE 출력 포트 또는 타사 PoE 전원을 사용합니다. 작동 온도에 따라 등급이 다릅니다. Type 4(PoE++, 52~57V, 포트당 최대 99.9W)는 -40~55°C, Type 3(50~57V, 60W)는 -30~55°C, Type 2(PoE+, 50~57V, 30W)는 -20~55°C입니다. 비표준 PoE나 Type 1은 지원하지 않으며, Type 2는 게이트웨이 모드만 지원합니다.</p></div>\r\n      <div class=\"q\"><b>네트워크 스위치 요구사항은?</b><p>네트워크 연결과 PoE 전원을 동시에 공급할 수 있는 기가비트 PoE 스위치를 권장합니다. 작동 온도 범위에 맞는 PoE 등급인지 확인하세요.</p></div>\r\n      <div class=\"q\"><b>필요한 네트워크 대역폭은?</b><p>최소 100Mbps 이상을 권장합니다. IP 카메라를 함께 배치할 경우 지연을 줄이기 위해 전용 네트워크 구성을 권장합니다.</p></div>\r\n      <div class=\"q\"><b>이더넷 배치 시 거리 제한이 있나요?</b><p>O4 Ground Station과 DJI Dock 3 사이에는 거리 제한이 없습니다. 다만 스테이션과 네트워크 스위치 사이의 최대 배치 거리는 100m입니다.</p></div>\r\n      <div class=\"q\"><b>활성화와 배치는 어떤 앱으로 하나요?</b><p>제공된 USB-C 케이블로 안드로이드폰에 연결한 뒤 DJI Enterprise 앱(안드로이드 전용)으로 활성화·배치·시운전을 진행합니다. 배치 후 운영 검증은 FlightHub 2 등 지원 클라우드에서 수행합니다.</p></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- FAQ (DJI 공식 FAQ 기반) -->\r\n  <section class=\"sec\">\r\n    <span class=\"label\">FAQ</span>\r\n    <h2>자주 하는 질문</h2>\r\n    <div class=\"faq\">\r\n      <div class=\"q\"><b>게이트웨이 모드와 릴레이 모드는 각각 언제 쓰나요?</b><p>게이트웨이 모드는 이더넷 또는 DJI 셀룰러 동글 2로 FlightHub 2에 연결해, Dock 3로 운영하는 기체의 영상 전송 범위를 확장합니다. 릴레이 모드는 인터넷 연결이 필요 없으며, 스테이션을 고지대에 배치해 통신 장애물을 극복하는 중계 역할을 합니다.</p></div>\r\n      <div class=\"q\"><b>호환되는 기체와 도크는 무엇인가요?</b><p>게이트웨이 모드는 DJI Dock 3와 호환됩니다. 릴레이 모드는 DJI Dock 3, Matrice 400, Matrice 4E, Matrice 4T, Matrice 4D/4TD(DJI RC Plus 2 Enterprise)와 호환됩니다. 단, 일본·카자흐스탄 등 5GHz 미지원 지역에서는 릴레이 모드를 쓸 수 없습니다.</p></div>\r\n      <div class=\"q\"><b>신호 커버리지 범위는 얼마인가요?</b><p>Matrice 400과는 최대 40km, 그 외 기체와는 최대 30km입니다(IC 규정, 간섭 없는 개방 환경, 편도·비복귀 비행 기준). 릴레이 모드에서 조종기/Dock 3와 스테이션 사이는 1km 이내 권장, 최대 3km입니다.</p></div>\r\n      <div class=\"q\"><b>PoE 정전 후에도 계속 사용할 수 있나요?</b><p>네. 내장 백업 배터리로 정전 시 게이트웨이 모드 약 45분, 릴레이 모드 약 30분간 계속 작동합니다. PoE 전원이 복구되면 기기가 자동으로 깨어나 재시작합니다(Type 2 이상 PoE 연결 시).</p></div>\r\n      <div class=\"q\"><b>D-RTK 3 릴레이 고정 배치 버전과 무엇이 다른가요?</b><p>D-RTK 3 릴레이 버전은 릴레이 스테이션 모드만 지원하지만, O4 Ground Station은 게이트웨이·릴레이 모드를 모두 지원하고 더 많은 기체와 호환됩니다. 또한 Sub2G 대역, 스마트 저전력 모드(대기 7W), IP 카메라(ONVIF·GB/T 28181) 및 ESDK 2.0 기반 타사 기기 연동을 추가로 지원합니다.</p></div>\r\n      <div class=\"q\"><b>IP 카메라는 어떤 종류가 연동되나요?</b><p>H.264 인코딩의 ONVIF 카메라와 GB/T 28181 카메라를 연동할 수 있으며, 최대 4개 라이브 스트림을 동시 지원합니다. 카메라가 지원할 경우 FlightHub 2에서 PTZ 제어와 움직임·가림 알림 수신이 가능합니다. 단, IP 카메라 연동은 게이트웨이 모드에서만 지원됩니다.</p></div>\r\n      <div class=\"q\"><b>기체에 RTK 측위를 제공하나요?</b><p>네. 게이트웨이·릴레이 모드 모두에서 위치 보정 후 연결된 기체에 센티미터급 RTK 기준 데이터를 제공할 수 있습니다.</p></div>\r\n      <div class=\"q\"><b>구매·견적 문의는 어떻게 하나요?</b><p>드론박스는 DJI 공식 기업 솔루션 딜러입니다. 연락처를 통해 운영 환경에 맞는 구성과 견적, 도입 컨설팅을 받아보실 수 있습니다.</p></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CTA -->\r\n  <section class=\"cta\">\r\n    <h2>Dock 3 운영 범위를 확장하세요</h2>\r\n    <p>제품 시연·체험과 도입 견적은 드론박스 전문가에게 문의하세요.</p>\r\n    <a href=\"#contact\"></a>\r\n  </section>\r\n\r\n  <!-- 주석 -->\r\n  <section class=\"notes\">\r\n    <h4>제품 주석</h4>\r\n    <ol>\r\n      <li>릴레이 비행 시 현지 법률 및 규정을 준수해야 합니다.</li>\r\n      <li>Sub2G 대역 지원과 멀티 밴드 자동 전환은 DJI O4 Ground Station을 Matrice 400과 함께 사용할 때만 제공되며, 일부 국가·지역에서는 사용할 수 없습니다.</li>\r\n      <li>게이트웨이 모드는 DJI Dock 3와 호환됩니다.</li>\r\n      <li>게이트웨이 모드에서 이더넷 또는 DJI 셀룰러 동글 2를 통해 FlightHub 2 공용 클라우드, On-Premises, AIO, Cloud API/FlightHub Sync 기반 타사 시스템에 연결됩니다.</li>\r\n      <li>릴레이 모드는 DJI Dock 3, Matrice 400, 4E, 4T, 4D/4TD(DJI RC Plus 2 Enterprise)와 호환되며, 5GHz 미지원 국가·지역에서는 사용할 수 없습니다.</li>\r\n      <li>간섭 없는 야외 개방 환경 측정. 40km는 IC 규정의 Matrice 400 기준이며 다른 기체는 최대 30km(IC)입니다. 편도·비복귀 비행 기준이며 비행 중 앱 알림에 주의하세요.</li>\r\n      <li>별도 판매. 4G 강화 전송은 일부 국가·지역에서 사용할 수 없습니다.</li>\r\n      <li>30km 전송은 IC 규정 준수 시 특정 기체·모드 조합에서만 달성됩니다. 편도·비복귀 비행 기준입니다.</li>\r\n      <li>해당 기능은 O4 Ground Station이 게이트웨이 모드일 때만 사용할 수 있습니다.</li>\r\n      <li>DJI Dock 3, 기체, 조종기 모두 펌웨어 V13.01.00.04 이상으로 업데이트하고 원격 액세스로 연결해야 합니다.</li>\r\n      <li>해당 기능은 O4 Ground Station이 릴레이 모드일 때만 사용할 수 있습니다.</li>\r\n      <li>IP67 지침의 요구 사항을 준수해야 하며, 통제된 환경에서 측정되었습니다. IP 등급은 영구적이지 않으며 마모로 저하될 수 있습니다.</li>\r\n      <li>-40~-20°C 환경 작동 시 60W 이상의 PoE++ 전원 공급 장치가 필요합니다.</li>\r\n      <li>RJ45 서지 보호 용량 1.5kA(8/20μs)로 EN/IEC 61643-21 Category C를 충족합니다. 성능은 접지 용량·안정성에 따라 달라집니다.</li>\r\n      <li>7W는 O4 Ground Station 자체 소비 전력이며, PoE++ 공급 시 전원 장치 포함 실제 총 소비량은 더 높습니다.</li>\r\n      <li>DJI Power 태양광 솔루션 또는 타사 태양광 발전 시스템은 별도 판매됩니다.</li>\r\n      <li>본 페이지의 사양·수치는 DJI 공식 자료 기준이며, 펌웨어·정책에 따라 변경될 수 있습니다.</li>\r\n    </ol>\r\n  </section>\r\n\r\n</div>\r\n\r\n<!-- Schema.org JSON-LD -->\r\n\r\n\r\n]]></goodsDescription>
