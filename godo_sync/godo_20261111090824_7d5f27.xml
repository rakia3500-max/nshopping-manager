:15px 0;font-size:14px;font-weight:600;color:var(--black);\r\n  cursor:pointer;display:flex;justify-content:space-between;\r\n  align-items:center;gap:10px;line-height:1.5;\r\n  font-family:inherit;-webkit-tap-highlight-color:transparent;\r\n}\r\n.faq-icon{flex-shrink:0;font-size:20px;color:var(--gray-400);transition:transform .2s;}\r\n.faq-item.open .faq-icon{transform:rotate(45deg);color:var(--black);}\r\n.faq-ans{display:none;padding:0 0 14px;font-size:13px;color:var(--gray-600);line-height:1.8;}\r\n.faq-item.open .faq-ans{display:block;}\r\n\r\n/* ── 스펙표 ── */\r\n.spec-wrap{background:var(--gray-50);padding:52px 16px;border-top:1px solid var(--gray-100);}\r\n.spec-group{margin-bottom:24px;}\r\n.spec-group-title{\r\n  font-size:13px;font-weight:700;color:var(--navy);\r\n  margin-bottom:10px;padding-left:10px;border-left:3px solid var(--orange);\r\n}\r\n.spec-tbl{width:100%;border-collapse:collapse;font-size:12px;}\r\n.spec-tbl tr:nth-child(even){background:#fff;}\r\n.spec-tbl tr:nth-child(odd){background:var(--gray-50);}\r\n.spec-tbl td{\r\n  padding:10px 12px;border-bottom:1px solid var(--gray-100);\r\n  color:var(--gray-800);line-height:1.5;vertical-align:top;\r\n}\r\n.spec-tbl td:first-child{font-weight:600;color:var(--navy);white-space:nowrap;width:38%;}\r\n\r\n/* ── 주의사항 ── */\r\n.notice-wrap{background:#fff;padding:36px 20px;border-top:1px solid var(--gray-100);}\r\n.notice-wrap h3{font-size:13px;font-weight:700;color:var(--gray-800);margin-bottom:14px;}\r\n.notice-wrap ol{padding-left:18px;}\r\n.notice-wrap li{font-size:11px;color:var(--gray-600);line-height:1.75;margin-bottom:5px;}\r\n\r\n/* ── 반응형 ── */\r\n@media(max-width:480px){\r\n  .hero h1{font-size:30px;}\r\n  .sh h2{font-size:22px;}\r\n  .target-grid{grid-template-columns:1fr 1fr;}\r\n  .stat-grid{grid-template-columns:1fr 1fr;}\r\n  .trust-grid{grid-template-columns:1fr 1fr;}\r\n  .ft-features{grid-template-columns:1fr 1fr;}\r\n}\r\n@media(max-width:360px){\r\n  .target-grid{grid-template-columns:1fr;}\r\n  .ft-features{grid-template-columns:1fr;}\r\n}\r\n</style>\r\n\r\n\r\n\r\n<!-- ═══ HERO ═══ -->\r\n<section class=\"hero\">\r\n  <div class=\"hero-badge\">🏪 드론박스 공식 판매처</div>\r\n  <p class=\"hero-eyebrow\">DJI OSMO MOBILE 8P</p>\r\n  <h1>찍고 싶은 순간,<br><em>놓치지 않습니다</em></h1>\r\n  <p class=\"hero-sub\">FrameTap이 프레임을 잡고, ActiveTrack 8.0이 피사체를 따라갑니다.<br>촬영에만 집중하세요.</p>\r\n  <div class=\"hero-img\">\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1778198513/1_yj1gi6.jpg\" alt=\"DJI Osmo Mobile 8P — 스마트폰 짐벌\" loading=\"eager\">\r\n  </div>\r\n  <div class=\"hero-chips\">\r\n    <div class=\"hchip\"><strong>FrameTap</strong> 분리형 리모컨</div>\r\n    <div class=\"hchip\"><strong>ActiveTrack 8.0</strong></div>\r\n    <div class=\"hchip\"><strong>10시간</strong> 배터리</div>\r\n    <div class=\"hchip\"><strong>내장</strong> 삼각대·확장로드</div>\r\n    <div class=\"hchip\">스마트폰 충전 지원</div>\r\n    <div class=\"hchip\">당일 출고</div>\r\n  </div>\r\n</section>\r\n\r\n<!-- ═══ FrameTap 강조 배너 ═══ -->\r\n<div class=\"frametap-banner\">\r\n  <div class=\"ft-label\">핵심 차별점</div>\r\n  <h2>Osmo <em>FrameTap</em> —<br>손 안에서 완성되는 구도</h2>\r\n  <p>스마트폰 화면을 그대로 미러링하는 분리형 리모컨.<br>후면 셀피부터 원거리 촬영까지 언제나 선명한 구도 제어.</p>\r\n  <div class=\"ft-features\">\r\n    <div class=\"ft-feat\">\r\n      <div class=\"ft-feat-icon\">📱</div>\r\n      <h4>화면 미러링</h4>\r\n      <p>스마트폰·다기능 모듈 2 화면 실시간 확인</p>\r\n    </div>\r\n    <div class=\"ft-feat\">\r\n      <div class=\"ft-feat-icon\">👆</div>\r\n      <h4>원 탭 추적</h4>\r\n      <p>감지 박스 한 번 탭으로 즉각 피사체 추적 시작</p>\r\n    </div>\r\n    <div class=\"ft-feat\">\r\n      <div class=\"ft-feat-icon\">💡</div>\r\n      <h4>조명 조절</h4>\r\n      <p>필라이트 밝기·색온도 직접 제어</p>\r\n    </div>\r\n    <div class=\"ft-feat\">\r\n      <div class=\"ft-feat-icon\">🕹️</div>\r\n      <h4>조이스틱 제어</h4>\r\n      <p>부드럽고 정밀한 짐벌 조작</p>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ═══ 상세 이미지 2 (8가지 이유) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1778198514/2_tta49a.jpg\" alt=\"DJI Osmo Mobile 8P 선택해야 하는 8가지 이유\" loading=\"lazy\">\r\n  <figcaption>Osmo Mobile 8P를 선택해야 하는 8가지 이유</figcaption>\r\n</figure>\r\n\r\n<hr class=\"divider\">\r\n\r\n<!-- ═══ 유튜브 영상 ═══ -->\r\n<section class=\"yt-section\">\r\n  <div class=\"sh\" style=\"padding-top:0;\">\r\n    <span class=\"sh-label\">공식 영상</span>\r\n    <h2>영상으로 먼저 <em>확인하세요</em></h2>\r\n    <p>DJI Osmo Mobile 8P 공식 소개 영상</p>\r\n  </div>\r\n  <div class=\"yt-wrap\">\r\n    <iframe src=\"https://www.youtube.com/embed/E9oNJrbkiIE\" title=\"DJI Osmo Mobile 8P 공식 소개 영상\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\" loading=\"lazy\">\r\n    </iframe>\r\n  </div>\r\n</section>\r\n\r\n<hr class=\"divider\">\r\n\r\n<!-- ═══ 콤보 3종 비교 ═══ -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">콤보 구성</span>\r\n  <h2>3가지 콤보, <em>내게 맞는 것</em>은?</h2>\r\n  <p>촬영 목적에 따라 최적의 콤보를 선택하세요.</p>\r\n</div>\r\n<div class=\"combo-wrap\">\r\n  <div class=\"combo-grid\">\r\n\r\n    <!-- 스탠더드 -->\r\n    <div class=\"combo-card\">\r\n      <div class=\"combo-head std\">\r\n        <div class=\"combo-tier std\">스탠더드 콤보</div>\r\n        <h3>Osmo Mobile 8P</h3>\r\n        <p>핵심만 담은 기본 구성. 짐벌 입문자나 가볍게 시작하고 싶은 분께.</p>\r\n      </div>\r\n      <div class=\"combo-body\">\r\n        <div class=\"combo-item\"><span class=\"ci-icon\">✅</span>Osmo Mobile 8P 본체</div>\r\n        <div class=\"combo-item\"><span class=\"ci-icon\">✅</span>DJI OM 마그네틱 스마트폰 클램프 5</div>\r\n        <div class=\"combo-item\"><span class=\"ci-icon\">✅</span>Osmo FrameTap (분리형 리모컨)</div>\r\n        <div class=\"combo-item\"><span class=\"ci-icon\">✅</span>전원 케이블 (USB-C to USB-C, 50cm)</div>\r\n        <div class=\"combo-item\"><span class=\"ci-icon\">✅</span>스마트폰 충전 케이블 (USB-C, 15cm)</div>\r\n        <div class=\"combo-item\"><span class=\"ci-icon\">✅</span>보관 파우치</div>\r\n        <div class=\"combo-item\"><span class=\"ci-icon\">—</spa