<style>\r\n    /* DJI Premium Dynamic Theme - BS100 Battery Station (DRONEBOX) */\r\n    .dji-wrap { \r\n        width: 100%; max-width: 1000px; margin: 0 auto; \r\n        background-color: #000000; color: #ffffff; \r\n        font-family: \'Pretendard\', \'Malgun Gothic\', sans-serif; \r\n        word-break: keep-all; line-height: 1.6; overflow-x: hidden;\r\n    }\r\n\r\n    /* 1. Trust Badge */\r\n    .dji-badge { background: #111111; border-bottom: 1px solid #333333; padding: 25px 20px; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 20px; }\r\n    .dji-badge-title { font-size: 30px; font-weight: 900; letter-spacing: -1px; margin: 0; color: #fff; }\r\n    .dji-badge-sub { font-size: 16px; font-weight: 600; color: #10b981; vertical-align: middle; margin-left: 8px; }\r\n    .dji-badge-desc { color: #bbbbbb; font-size: 14px; line-height: 1.5; max-width: 600px; margin: 0; }\r\n    .dji-badge-desc strong { color: #ffffff; font-size: 16px; }\r\n\r\n    /* 2. Hero Section */\r\n    .dji-hero { padding: 120px 20px 80px; text-align: center; background: radial-gradient(circle at center, #1a2a22 0%, #000000 70%); border-bottom: 1px solid #222; }\r\n    .dji-hero-sub { font-size: 20px; font-weight: 700; color: #10b981; letter-spacing: 1px; margin-bottom: 15px; }\r\n    .dji-hero-title { font-size: 48px; font-weight: 900; letter-spacing: -1px; margin-bottom: 25px; color: #ffffff; line-height: 1.2; }\r\n    .dji-hero-desc { color: #e2e8f0; font-size: 18px; max-width: 800px; margin: 0 auto; font-weight: 400; line-height: 1.6; }\r\n    \r\n    .dji-hero-img { margin-top: 50px; text-align: center; }\r\n    .dji-hero-img img { max-width: 100%; height: auto; border-radius: 16px; }\r\n\r\n    /* 3. Features Grid */\r\n    .dji-features-sec { padding: 80px 20px; background: #000000; border-bottom: 1px solid #222; }\r\n    .dji-features-title { text-align: center; font-size: 36px; font-weight: 900; margin-bottom: 50px; color: #ffffff; }\r\n    .dji-features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 900px; margin: 0 auto; }\r\n    .dji-feature-card { background: #111111; padding: 40px 30px; border-radius: 16px; border: 1px solid #2a2a2a; text-align: center; transition: transform 0.3s ease; }\r\n    .dji-feature-card:hover { transform: translateY(-5px); border-color: #10b981; background: #161616; }\r\n    .dji-feature-icon { font-size: 36px; margin-bottom: 20px; display: inline-block; }\r\n    .dji-feature-title { font-size: 20px; font-weight: 800; margin-bottom: 15px; color: #ffffff; }\r\n    .dji-feature-desc { color: #aaaaaa; font-size: 15px; margin: 0; line-height: 1.6; }\r\n\r\n    /* 4. Notice Box */\r\n    .dji-notice-sec { padding: 40px 20px; background: #000; text-align: center; }\r\n    .dji-notice-box { background: rgba(255, 59, 59, 0.1); border: 1px solid #ff3b3b; padding: 25px 30px; border-radius: 12px; max-width: 800px; margin: 0 auto; text-align: left; display: flex; align-items: flex-start; gap: 20px; }\r\n    .dji-notice-icon { font-size: 28px; line-height: 1; }\r\n    .dji-notice-text h4 { color: #ff3b3b; font-size: 18px; font-weight: 800; margin: 0 0 10px 0; }\r\n    .dji-notice-text ul { margin: 0; padding-left: 20px; color: #e2e8f0; font-size: 15px; line-height: 1.6; }\r\n    .dji-notice-text li { margin-bottom: 5px; }\r\n\r\n    /* 5. Video Section */\r\n    .dji-video-sec { padding: 60px 20px 80px; text-align: center; background: #000; border-top: 1px solid #222; }\r\n    .dji-video-title { font-size: 32px; font-weight: 900; margin-bottom: 15px; color: #fff; }\r\n    .dji-video-desc { color: #888; font-size: 16px; margin-bottom: 40px; }\r\n    .dji-video-wrap { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.6); max-width: 900px; margin: 0 auto; border: 1px solid #333; }\r\n    .dji-video-wrap iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\r\n\r\n    /* 6. Specs Table (가독성 100% 보장 패치 적용) */\r\n    .dji-specs-sec { padding: 60px 20px 80px; background: #080808; border-top: 1px solid #222; }\r\n    .dji-specs-title { font-size: 32px; font-weight: 900; text-align: center; margin-bottom: 30px; color: #ffffff; }\r\n    .dji-table-wrap { overflow-x: auto; margin: 0 auto; max-width: 900px; border-radius: 12px; border: 1px solid #333; box-shadow: 0 10px 30px rgba(0,0,0,0.8); }\r\n    \r\n    .dji-spec-table { width: 100%; min-width: 600px; border-collapse: collapse; text-align: left; background: #111111; }\r\n    \r\n    /* ❗ 핵심 조치: th, td의 글자색을 #ffffff !important로 강제 고정 */\r\n    .dji-spec-table th, .dji-spec-table td { \r\n        padding: 16px 25px; \r\n        border-bottom: 1px solid #2a2a2a; \r\n        color: #ffffff !important; \r\n        font-size: 15px !important;\r\n    }\r\n    \r\n    .dji-spec-table th { \r\n        background: #1a1a1a; \r\n        font-weight: 800 !important; \r\n        width: 30%; \r\n        border-right: 1px solid #222;\r\n        color: #10b981 !important; /* 항목명 테마색 포인트 */\r\n    }\r\n    \r\n    .dji-spec-table td {\r\n        font-weight: 400 !important;\r\n        line-height: 1.6;\r\n    }\r\n\r\n    .dji-spec-table ul { padding-left: 20px; margin: 0; }\r\n    .dji-spec-table li { color: #ffffff !important; margin-bottom: 5px; }\r\n    \r\n    .dji-spec-table tr:hover td { background: #181818; }\r\n    .dji-spec-table tr:last-child th, .dji-spec-table tr:last-child td { border-bottom: none; }\r\n\r\n    @media (max-width: 768px) {\r\n        .dji-features-grid { grid-template-columns: 1fr; }\r\n        .dji-hero-title { font-size: 36px; }\r\n        .dji-spec-table th, .dji-spec-table td { padding: 15px; font-size: 14px !important; }\r\n        .dji-notice-box { flex-direction: column; gap: 10px; align-items: center; text-align: center; }\r\n        .dji-notice-text ul { padding-left: 0; list-style: none; }\r\n    }\r\n</style>\r\n\r\n<div class=\"dji-wrap\">\r\n\r\n    <div class=\"dji-badge\">\r\n        <div class=\"dji-badge-title\">DRONEBOX <span class=\"dji-badge-sub\">OFFICIAL DEALER</span></div>\r\n        <div class=\"dji-badge-desc\">\r\n            <strong>드론의 모든 것, 드론박스</strong><br>\r\n            본 판매점에서 구입하신 제품은 DJI 코리아 정품입니다.\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-hero\">\r\n        <h3 class=\"dji-hero-sub\">DJI MATRICE 400 전용</h3>\r\n        <h1 class=\"dji-hero-title\">BS100 인텔리전트 배터리 스테이션</h1>\r\n        <p class=\"dji-hero-desc\">\r\n            배터리 충전, 보관, 운반을 모두 제공하는 완벽한 원스톱 솔루션입니다.<br>\r\n            4가지 스마트 충전 모드와 새로운 360° 회전 휠로 현장에서의 효율성과 이동성을 극대화합니다.\r\n        </p>\r\n        \r\n        <div class=\"dji-hero-img\">\r\n            </div>\r\n    </div>\r\n\r\n    <div class=\"dji-features-sec\">\r\n        <h2 class=\"dji-features-title\">자세히 살펴보기</h2>\r\n        <div class=\"dji-features-grid\">\r\n            <div class=\"dji-feature-card\">\r\n                <div class=\"dji-feature-icon\">⚡</div>\r\n                <h3 class=\"dji-feature-title\">4가지 맞춤형 충전 모드</h3>\r\n                <p class=\"dji-feature-desc\">90% 충전 상태를 유지하는 \'비행 대기 모드\', 100%를 채우는 \'표준 모드\', 빠른 출격을 위한 \'고속 충전 모드\', 그리고 \'저소음 모드\'를 환경에 맞게 지원합니다.</p>\r\n            </div>\r\n            <div class=\"dji-feature-card\">\r\n                <div class=\"dji-feature-icon\">🔌</div>\r\n                <h3 class=\"dji-feature-title\">다중 포트 동시 충전</h3>\r\n                <p class=\"dji-feature-desc\">TB100 배터리 포트 3개, WB37 포트 2개, 조종기용 USB-C 포트 1개를 탑재하여 TB100 1개와 WB37 1개를 동시에 효율적으로 충전합니다.</p>\r\n            </div>\r\n            <div class=\"dji-feature-card\">\r\n                <div class=\"dji-feature-icon\">🧳</div>\r\n                <h3 class=\"dji-feature-title\">뛰어난 보관 및 이동성</h3>\r\n                <p class=\"dji-feature-desc\">충전기이자 완벽한 보호 케이스의 역할을 합니다. 바닥에 새롭게 장착된 360° 회전 휠을 통해 무거운 배터리들을 싣고도 편안하게 이동할 수 있습니다.</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-notice-sec\">\r\n        <div class=\"dji-notice-box\">\r\n            <div class=\"dji-notice-icon\">⚠️</div>\r\n            <div class=\"dji-notice-text\">\r\n                <h4>배터리 스테이션 사용 시 유의사항</h4>\r\n                <ul>\r\n                    <li>발열 관리를 위해 충전 중에는 배터리 스테이션의 덮개를 닫지 마세요.</li>\r\n                    <li>감전 및 제품 손상 방지를 위해 배터리 포트의 금속 단자에는 절대 손을 대지 마세요.</li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-video-sec\">\r\n        <h2 class=\"dji-video-title\">스테이션 및 배터리 사용법</h2>\r\n        <p class=\"dji-video-desc\">BS100 배터리 스테이션의 충전 모드 설정 및 펌웨어 업데이트 방법을 확인하세요.</p>\r\n        <div class=\"dji-video-wrap\">\r\n            <iframe src=\"https://www.youtube.com/embed/DW2VgLXmBmI\" allowfullscreen=\"\"></iframe>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-specs-sec\">\r\n        <h2 class=\"dji-specs-title\">제품 상세 스펙 및 구성품</h2>\r\n        <div class=\"dji-table-wrap\">\r\n            <table class=\"dji-spec-table\">\r\n                <tbody>\r\n                    <tr>\r\n                        <th>호환 기체</th>\r\n                        <td>DJI Matrice 400</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <th>기본 구성품</th>\r\n                        <td>\r\n                            <ul>\r\n                                <li>BS100 인텔리전트 배터리 스테이션 × 1</li>\r\n                                <li>AC 케이블 (유니버설) × 6</li>\r\n                                <li>AC 케이블 (한국 규격) × 1</li>\r\n                                <li>AC 케이블 (중국 규격) × 1</li>\r\n                            </ul>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <th>크기 (L×W×H)</th>\r\n                        <td>605 × 410 × 250 mm</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <th>공차 중량</th>\r\n                        <td>약 11.8 kg (배터리 제외)</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <th>작동 온도</th>\r\n                        <td>-20°C ~ 40°C</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <th>출력 전력 (TB100 포트)</th>\r\n                        <td>\r\n                            <ul>\r\n                                <li>100 V ~ 110 V: 약 1185 W</li>\r\n                                <li>110 V ~ 180 V: 약 1474 W</li>\r\n                                <li>180 V ~ 240 V: 약 2184 W</li>\r\n                            </ul>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <th>출력 전력 (WB37 포트)</th>\r\n                        <td>100 V ~ 240 V: 약 52 W</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <th>출력 전력 (USB-C 포트)</th>\r\n                        <td>5.0V 3.0A / 9.0V 3.0A / 12.0V 3.0A / 15.0V 3.0A / 20.0V 3.25A<br>(최대 65 W 출력 전력 지원)</td>\r\n                    </tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n</div>]]></goodsDescription>
