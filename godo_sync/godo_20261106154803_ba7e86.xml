<goodsDescription><![CDATA[<style>\r\n    /* DJI Premium Dynamic Theme - DJI Modify Only */\r\n    .dji-wrap { \r\n        width: 100%; max-width: 1000px; margin: 0 auto; \r\n        background-color: #000000; color: #ffffff; \r\n        font-family: \'Pretendard\', \'Malgun Gothic\', sans-serif; \r\n        word-break: keep-all; line-height: 1.6; overflow-x: hidden;\r\n    }\r\n\r\n    .dji-badge { background: #111; border-bottom: 1px solid #333; padding: 25px 20px; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 20px; }\r\n    .dji-badge-title { font-size: 30px; font-weight: 900; letter-spacing: -1px; }\r\n    .dji-badge-sub { font-size: 16px; font-weight: 600; color: #888; margin-left: 8px; }\r\n    .dji-badge-desc { color: #bbb; font-size: 14px; line-height: 1.5; max-width: 600px; }\r\n    .dji-badge-desc strong { color: #fff; font-size: 16px; }\r\n\r\n    .dji-hero-video { position: relative; width: 100%; height: 80vh; min-height: 600px; overflow: hidden; background-color: #111; }\r\n    .dji-hero-video video { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; }\r\n    .dji-hero-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; background: linear-gradient(to top, #000 0%, transparent 50%); text-align: center; padding: 0 20px; }\r\n    .dji-hero-title { font-size: 56px; font-weight: 900; letter-spacing: -2px; margin-bottom: 10px; color: #fff; }\r\n    .dji-hero-sub { font-size: 22px; font-weight: 600; color: #10b981; letter-spacing: 1px; margin-bottom: 20px; }\r\n\r\n    .dji-intro { padding: 80px 20px 40px; text-align: center; }\r\n    .dji-intro-sub { color: #10b981; font-size: 18px; font-weight: 700; margin-bottom: 10px; }\r\n    .dji-intro-title { font-size: 42px; font-weight: 900; margin-bottom: 20px; letter-spacing: -1px; }\r\n    .dji-intro-desc { color: #aaa; font-size: 17px; max-width: 800px; margin: 0 auto; }\r\n\r\n    .dji-features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; padding: 0 20px 80px; }\r\n    .dji-feature-card { background: #141414; padding: 40px 30px; border-radius: 12px; border: 1px solid #2a2a2a; text-align: left; transition: all 0.4s ease; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }\r\n    .dji-feature-card:hover { transform: translateY(-8px); border-color: #10b981; background: #1a1a1a; }\r\n    .dji-feature-title { font-size: 20px; font-weight: 800; margin-bottom: 15px; color: #fff; }\r\n    .dji-feature-desc { color: #999; font-size: 15px; margin: 0; line-height: 1.6; }\r\n\r\n    .dji-split { display: flex; flex-wrap: wrap; align-items: center; padding: 80px 20px; gap: 50px; border-top: 1px solid #222; }\r\n    .dji-split-img { flex: 1 1 400px; overflow: hidden; border-radius: 16px; position: relative; }\r\n    .dji-split-img video { width: 100%; display: block; border-radius: 16px; }\r\n    .dji-split-text { flex: 1 1 400px; }\r\n    .dji-split-text h4 { color: #10b981; font-size: 18px; margin-bottom: 10px; font-weight: 800; }\r\n    .dji-split-text h2 { font-size: 36px; font-weight: 900; margin-bottom: 20px; line-height: 1.3; }\r\n    .dji-split-text p { color: #bbb; font-size: 16px; line-height: 1.7; }\r\n\r\n    .dji-video-sec { padding: 100px 20px; text-align: center; background: #111; border-top: 1px solid #222; }\r\n    .dji-video-title { font-size: 32px; font-weight: 900; margin-bottom: 40px; color: #fff; }\r\n    .dji-video-wrap { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); max-width: 900px; margin: 0 auto; }\r\n    .dji-video-wrap iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\r\n\r\n    .dji-plan-sec { padding: 80px 20px; background: #000; border-top: 1px solid #222; }\r\n    .dji-plan-title { font-size: 36px; font-weight: 900; text-align: center; margin-bottom: 15px; }\r\n    .dji-plan-desc { text-align: center; color: #888; margin-bottom: 40px; font-size: 15px; }\r\n    .dji-table-wrap { overflow-x: auto; margin: 0 auto; max-width: 900px; }\r\n    .dji-plan-table { width: 100%; min-width: 600px; border-collapse: collapse; font-size: 14px; text-align: center; }\r\n    .dji-plan-table th, .dji-plan-table td { padding: 15px; border-bottom: 1px solid #222; }\r\n    .dji-plan-table th { background: #111; color: #fff; font-weight: 700; border-bottom: 2px solid #333; }\r\n    .dji-plan-table td.feature-name { background: #0a0a0a; text-align: left; font-weight: 600; color: #ccc; width: 35%; }\r\n    .dji-plan-table th.highlight { color: #10b981; }\r\n\r\n    @media (max-width: 768px) {\r\n        .dji-features { grid-template-columns: 1fr; }\r\n        .dji-split { gap: 40px; padding: 60px 20px; }\r\n        .dji-split-text h2 { font-size: 30px; }\r\n        .dji-hero-title { font-size: 40px; }\r\n    }\r\n</style>\r\n\r\n<div class=\"dji-wrap\">\r\n    <div class=\"dji-badge\">\r\n        <div class=\"dji-badge-title\">DJI <span class=\"dji-badge-sub\">AUTHORIZED DEALER</span></div>\r\n        <div class=\"dji-badge-desc\"><strong>DJI 공식 파트너 드론박스</strong><br>본 판매점에서 구입하신 제품은 DJI 코리아에서 제공하는 100% 정품입니다.</div>\r\n    </div>\r\n\r\n    <div class=\"dji-hero-video\">\r\n        <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\">\r\n            <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/842d705d-f421-4c58-8531-261b54828cd5.mp4\" type=\"video/mp4\">\r\n        </video>\r\n        <div class=\"dji-hero-overlay\">\r\n            <h2 class=\"dji-hero-sub\">인텔리전트 3D 모델 편집 소프트웨어</h2>\r\n            <h1 class=\"dji-hero-title\">DJI Modify</h1>\r\n            <p style=\"color: #ccc; font-size: 18px; font-weight: 600; margin-top: 10px;\">Shaping the World</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-intro\">\r\n        <h3 class=\"dji-intro-sub\">Intelligent 3D Editing</h3>\r\n        <h2 class=\"dji-intro-title\">더 쉽고 강력해진 3D 후처리</h2>\r\n        <p class=\"dji-intro-desc\">\r\n            DJI Modify는 DJI의 첫 인텔리전트 3D 메쉬 및 포인트 클라우드 편집 소프트웨어입니다. 복잡한 설정 없이 3D 모델의 부유물, 구멍, 차량 등의 결함을 원클릭으로 복원합니다. 수정된 모델은 지형 결과로 자동 생성되어 GIS 및 CAD 등 산업 표준 소프트웨어와 완벽하게 연동됩니다.\r\n        </p>\r\n    </div>\r\n\r\n    <div class=\"dji-features\">\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\">포인트 클라우드 노이즈 제거</h4>\r\n            <p class=\"dji-feature-desc\">전체 또는 선택한 포인트 클라우드의 평활화, 노이즈 제거, 다운샘플링 기능을 지원하여 모델의 품질을 효과적으로 개선합니다.</p>\r\n        </div>\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\">스마트 필터 \\u0026 분류</h4>\r\n            <p class=\"dji-feature-desc\">머신러닝 알고리즘을 통해 지면, 식생, 건물, 전선, 차량 등을 자동으로 분류하고, 마법봉 도구로 특정 영역만 빠르게 선택해 편집할 수 있습니다.</p>\r\n        </div>\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\">지형 결과(DEM) 생성</h4>\r\n            <p class=\"dji-feature-desc\">분류된 지면 포인트 클라우드를 기반으로 고정밀 디지털 고도 모델(DEM), 등고선, 불규칙 삼각망(TIN)을 정밀하게 추출합니다.</p>\r\n        </div>\r\n        <div class=\"dji-feature-card\">\r\n            <h4 class=\"dji-feature-title\">클라우드 공유 (웹/모바일)</h4>\r\n            <p class=\"dji-feature-desc\">편집이 완료된 모델은 클라우드로 즉시 내보낼 수 있으며, 공유된 링크를 통해 별도의 프로그램 설치 없이 누구나 열람할 수 있습니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-split\">\r\n        <div class=\"dji-split-img\">\r\n            <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\">\r\n                <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/dc686384-222a-4afe-b8f5-a967d19ac1e4.mp4\" type=\"video/mp4\">\r\n            </video>\r\n        </div>\r\n        <div class=\"dji-split-text\">\r\n            <h4>Point Cloud Processing</h4>\r\n            <h2>효율적인 포인트 클라우드<br>편집 및 복원</h2>\r\n            <p>다양한 디스플레이 모드(RGB, 고도, 강도 등)를 지원합니다. 다각형, 직사각형 선택 툴을 이용해 잘못 분류된 포인트를 수동으로 조정하고, 차량 메쉬를 평탄화한 후 텍스처를 주변과 자연스럽게 블렌딩합니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-split\" style=\"flex-direction: row-reverse;\">\r\n        <div class=\"dji-split-img\">\r\n            <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\">\r\n                <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/6508b0cd-5e44-4536-a0ba-4720bd6929f5.mp4\" type=\"video/mp4\">\r\n            </video>\r\n        </div>\r\n        <div class=\"dji-split-text\">\r\n            <h4>Hole \\u0026 Water Surface Repair</h4>\r\n            <h2>구멍 채우기 및<br>수면 텍스처 자동 수정</h2>\r\n            <p>모델 내의 구멍을 자동으로 인식하여 하이라이트 표시합니다. 원클릭으로 구멍을 메우고 텍스처를 복원합니다. 또한 클릭 몇 번으로 수면을 그리고 사용자 지정 색상이나 주변 패턴으로 물 장면을 사실적으로 최적화합니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-video-sec\">\r\n        <h2 class=\"dji-video-title\">DJI Modify 업데이트 소개</h2>\r\n        <div class=\"dji-video-wrap\">\r\n            <iframe src=\"https://www.youtube.com/embed/dld1Lda-b4o\" allowfullscreen=\"\"></iframe>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-plan-sec\">\r\n        <h2 class=\"dji-plan-title\">DJI Modify 라이선스 플랜</h2>\r\n        <p class=\"dji-plan-desc\">필요한 기능에 맞게 라이선스를 선택하십시오.</p>\r\n        <div class=\"dji-table-wrap\">\r\n            <table class=\"dji-plan-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th>기능 및 버전</th>\r\n                        <th>표준 (Standard)</th>\r\n                        <th class=\"highlight\">플래그십 (Flagship)</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    <tr><td class=\"feature-name\">기기 바인딩 수</td><td>기기 1개</td><td>기기 1개</td></tr>\r\n                    <tr><td class=\"feature-name\">인증 모드</td><td>온라인</td><td>온라인</td></tr>\r\n                    <tr><td class=\"feature-name\">유효 기간</td><td>영구</td><td>영구</td></tr>\r\n                    <tr><td class=\"feature-name\">3D 메쉬 편집</td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td></tr>\r\n                    <tr><td class=\"feature-name\">포인트 클라우드 편집</td><td><span class=\"cross\">✖</span></td><td><span class=\"check\">✔</span></td></tr>\r\n                    <tr><td class=\"feature-name\">지형 결과 생성</td><td><span class=\"cross\">✖</span></td><td><span class=\"check\">✔</span></td></tr>\r\n                    <tr><td class=\"feature-name\">클라우드 공유</td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td></tr>\r\n                    <tr><td class=\"feature-name\">결과 내보내기</td><td><span class=\"check\">✔</span></td><td><span class=\"check\">✔</span></td></tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n</div>]]></goodsDescription>
