<goodsDescription><![CDATA[<script data-bd="cpanel">(function(){
var D={"intro": "자석으로 옷·모자에 붙여 찍는 52g 웨어러블 카메라. 1/1.3인치 센서, 4K/60fps, 카메라 단독 10m 방수, Vision Dock 결합 시 최대 200분. 내장 64GB 모델.", "chips": ["52g 마그네틱 카메라", "1/1.3인치 CMOS", "4K/60fps", "카메라 10m 방수", "다기능 Vision Dock", "독 결합 최대 200분", "1.96인치 터치스크린", "내장 64GB"], "badges": [{"text": "DJI 정품"}, {"text": "국내 A/S 접수"}, {"text": "Care Refresh 가입 문의", "href": "https://www.drone-box.co.kr/board/popup_goods_board_write.php?mode=write&bdId=goodsqa&goodsNo=1000001394&orderGoodsNo=0"}, {"text": "기관·기업 납품서류 발급"}], "box": ["Osmo Nano 카메라 (64GB)", "Osmo Nano 다기능 Vision Dock", "Osmo Nano 마그네틱 모자 클립", "Osmo Nano 마그네틱 스트랩", "Osmo Nano 보호 케이스", "USB-C to USB-C PD 케이블 (USB 3.1)", "Osmo Nano 양방향 마그네틱 볼 조인트 어댑터 마운트"], "ship": ""};
var S_INTRO="font-size:13.5px;color:#333D4B;line-height:1.65;margin:0 0 8px;",
S_CHIPS="display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px;",
S_CHIP="font-size:12px;background:#F2F4F6;color:#333D4B;border-radius:999px;padding:4px 10px;line-height:1.4;",
S_BADGES="display:flex;flex-wrap:wrap;gap:5px;margin:0 0 10px;",
S_BADGE="font-size:11.5px;border:1px solid #D6E4FF;color:#1B64DA;background:#F2F6FF;border-radius:6px;padding:3px 8px;font-weight:600;line-height:1.4;text-decoration:none;white-space:nowrap;",
S_FOLD="font-size:13px;color:#4E5968;border:1px dashed #D1D6DB;border-radius:8px;padding:9px 12px;margin:10px 0 4px;cursor:pointer;line-height:1.6;",
S_FOLD_B="color:#191F28;font-weight:700;";
function el(tag,html){var d=document.createElement(tag);if(html!=null)d.innerHTML=html;return d;}
function introHtml(){var chips=D.chips.map(function(c){return '<span style="'+S_CHIP+'">'+c+'</span>';}).join('');
return '<p data-bdc="intro" style="'+S_INTRO+'">'+D.intro+'</p><div data-bdc="chips" style="'+S_CHIPS+'">'+chips+'</div>';}
function badgesHtml(){return '<div data-bdc="badges" style="'+S_BADGES+'">'+D.badges.map(function(b){return b.href?'<a href="'+b.href+'" style="'+S_BADGE+'">'+b.text+'</a>':'<span style="'+S_BADGE+'">'+b.text+'</span>';}).join('')+'</div>';}
function foldHtml(){return '<div data-bdc="fold" style="'+S_FOLD+'"><span style="'+S_FOLD_B+'">구성품 보기 ▾</span><span data-bdc="foldbody" style="display:none;"> &nbsp;'+D.box.join(' · ')+(D.ship?'<br><span style="color:#8B95A1;">'+D.ship+'</span>':'')+'</span></div>';}
function bindFold(f){if(f.getAttribute('data-bound'))return;f.setAttribute('data-bound','1');f.onclick=function(){var b=f.querySelector('[data-bdc="foldbody"]'),t=f.querySelector('span');var open=b.style.display!=='none';b.style.display=open?'none':'inline';t.textContent=open?'구성품 보기 ▾':'구성품 접기 ▴';};}
var S_ROW=";clear:both;float:left;width:100%;box-sizing:border-box;";
function css(){if(document.querySelector('style[data-bdc="css"]'))return;var s=document.createElement('style');s.setAttribute('data-bdc','css');
s.textContent='.item_detail_list > dl{padding-top:3px !important;} .item_detail_list > dl > dt,.item_detail_list > dl > dd{line-height:20px !important;} .item_detail_list .item_delivery dd .delivery-detail{line-height:20px;} .item_detail_list [data-bdc="fold"]{margin:4px 0 0 !important;padding:6px 12px !important;}';document.head.appendChild(s);}
function pc(){var list=document.querySelector('.item_detail_list');if(!list)return;css();
if(!list.querySelector('[data-bdc="intro"]')){var w=el('div',introHtml()+badgesHtml());w.setAttribute('data-bdc','top');w.style.cssText+=S_ROW;list.insertBefore(w,list.firstChild);}
var dv=list.querySelector('.item_delivery');
if(!list.querySelector('[data-bdc="fold"]')){var f=el('div',foldHtml()).firstChild;f.style.cssText+=S_ROW;if(dv&&dv.nextSibling)dv.parentNode.insertBefore(f,dv.nextSibling);else list.appendChild(f);}
var fd=list.querySelector('[data-bdc="fold"]');if(fd)bindFold(fd);}
function mo(){var top=document.querySelector('.detail_info_top');if(!top)return;
var pb=top.querySelector('.price_box');
if(pb&&!top.querySelector('[data-bdc="intro"]')){var w=el('div',introHtml()+badgesHtml());w.setAttribute('data-bdc','top');w.style.cssText='padding:8px 0 4px;';var sub=pb.querySelector('.detail_sub_info');if(sub)pb.insertBefore(w,sub);else pb.appendChild(w);}
var sub2=document.querySelector('.detail_sub_info');
if(sub2&&!document.querySelector('.detail_info_top [data-bdc="fold"]')){var f=el('div',foldHtml()).firstChild;sub2.parentNode.insertBefore(f,sub2.nextSibling);}
var fd=document.querySelector('.detail_info_top [data-bdc="fold"]');if(fd)bindFold(fd);}
function fix(){try{pc();}catch(e){}try{mo();}catch(e){}}
function start(){fix();try{new MutationObserver(function(){fix();}).observe(document.body,{childList:true,subtree:true});}catch(e){}
var n=0,t=setInterval(function(){fix();if(++n>40)clearInterval(t);},500);}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',start);}else{start();}
})();</script>
<style>\r\n    /* DJI Osmo Nano Detailed Style */\r\n    .nano-full-wrapper {\r\n        width: 100%; \r\n        max-width: 1000px;\r\n        margin: 0 auto;\r\n        background-color: #fff;\r\n        font-family: \'Pretendard\', \'Malgun Gothic\', sans-serif;\r\n        color: #333;\r\n        line-height: 1.6;\r\n    }\r\n    .nano-section { margin-bottom: 60px; text-align: center; padding: 0 20px; }\r\n    .nano-header { font-size: 38px; font-weight: 800; margin-bottom: 20px; color: #111; letter-spacing: -1px; }\r\n    .nano-sub { font-size: 20px; color: #FF7B00; font-weight: 700; margin-bottom: 15px; display: block; text-transform: uppercase; }\r\n    .nano-text { font-size: 17px; color: #555; max-width: 700px; margin: 0 auto 40px; word-break: keep-all; }\r\n    .nano-img { width: 100%; max-width: 100%; height: auto; display: block; margin: 0 auto; border-radius: 12px; }\r\n    .nano-video-box { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; background: #000; border-radius: 12px; margin-bottom: 50px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }\r\n    .nano-video-box iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\r\n    .nano-divider { height: 1px; background: #eee; margin: 60px auto; max-width: 800px; border: none; }\r\n</style>\r\n\r\n<div class=\"nano-full-wrapper\">\r\n\r\n    <div class=\"nano-section\" style=\"margin-top: 50px;\">\r\n        <span class=\"nano-sub\">DJI Osmo Nano</span>\r\n        <h1 class=\"nano-header\">다양한 시점을 위한<br>웨어러블 카메라</h1>\r\n        <p class=\"nano-text\">작지만 강력한 1/1.3인치 센서. 52g의 가벼움.<br>DJI Osmo Nano로 일상의 모든 순간을 영화처럼 기록하세요.</p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_1.jpg\" class=\"nano-img\" alt=\"메인 이미지\">\r\n    </div>\r\n\r\n    <div class=\"nano-section\">\r\n        <div class=\"nano-video-box\">\r\n            <iframe src=\"https://www.youtube.com/embed/yECD9TzmW-A?rel=0&amp;modestbranding=1\" title=\"DJI Osmo Nano Intro\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\"></iframe>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"nano-section\">\r\n        <h2 class=\"nano-header\" style=\"font-size: 30px;\">선택해야 하는 <span style=\"color:#FF7B00;\">8가지 이유</span></h2>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_2.jpg\" class=\"nano-img\" alt=\"8가지 특징\">\r\n    </div>\r\n\r\n    <hr class=\"nano-divider\">\r\n\r\n    <div class=\"nano-section\">\r\n        <h3 class=\"nano-header\" style=\"font-size: 28px;\">초경량 디자인, 자유로운 착용</h3>\r\n        <p class=\"nano-text\">1인칭 시점(POV) 촬영에 최적화되었습니다.<br>자석 마그네틱으로 옷, 가방, 모자 어디든 간편하게 부착하세요.</p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_3.jpg\" class=\"nano-img\" alt=\"착용 샷\">\r\n    </div>\r\n\r\n    <div class=\"nano-section\">\r\n        <h3 class=\"nano-header\" style=\"font-size: 28px;\">컴팩트한 바디, 넓은 화면</h3>\r\n        <p class=\"nano-text\">동급 최강 1/1.3인치 센서가 선사하는 놀라운 야간 화질.<br>4K/60fps의 부드러운 영상미를 경험해보세요.</p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_4.jpg\" class=\"nano-img\" alt=\"화질 성능\">\r\n    </div>\r\n\r\n    <div class=\"nano-section\">\r\n        <h3 class=\"nano-header\" style=\"font-size: 28px;\">어떤 촬영에도 완벽하게 준비</h3>\r\n        <p class=\"nano-text\">최대 200분 촬영(케이스 포함). 방수 기능 탑재로<br>비 오는 날에도, 물놀이 중에도 걱정 없습니다.</p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_5.jpg\" class=\"nano-img\" alt=\"배터리 방수\">\r\n    </div>\r\n\r\n    <div class=\"nano-section\">\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_6.jpg\" class=\"nano-img\" alt=\"액세서리 호환\">\r\n    </div>\r\n\r\n    <hr class=\"nano-divider\">\r\n\r\n    <div class=\"nano-section\">\r\n        <h3 class=\"nano-header\" style=\"font-size: 28px;\">창의적인 순간을 위한 기능</h3>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_7.jpg\" class=\"nano-img\" alt=\"다양한 모드\">\r\n    </div>\r\n\r\n    <div class=\"nano-section\">\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_8.jpg\" class=\"nano-img\" alt=\"액세서리 종류\">\r\n    </div>\r\n\r\n    <hr class=\"nano-divider\">\r\n\r\n    <div class=\"nano-section\">\r\n        <h3 class=\"nano-header\" style=\"font-size: 28px;\">구성품 (In the Box)</h3>\r\n        <p class=\"nano-text\">구매 전 옵션별 구성품을 확인하세요.</p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_9.jpg\" class=\"nano-img\" alt=\"구성품 목록\">\r\n    </div>\r\n\r\n    <div class=\"nano-section\">\r\n        <h3 class=\"nano-header\" style=\"font-size: 24px; color:#888;\">상세 사양</h3>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/Osmo%20nano/JPG_10.jpg\" class=\"nano-img\" alt=\"스펙 테이블\">\r\n    </div>\r\n\r\n    <div style=\"text-align: center; padding: 50px 20px; background-color: #f9f9f9; border-radius: 12px; margin-top: 40px;\">\r\n        <p style=\"color: #666; font-size: 14px; margin-bottom: 10px;\">※ 본 페이지의 제품 사양 및 구성은 제조사의 정책에 따라 예고 없이 변경될 수 있습니다.</p>\r\n        <p style=\"font-weight: bold; font-size: 16px; color: #333;\">DJI 공식 판매점 [드론박스]</p>\r\n    </div>\r\n\r\n</div>]]></goodsDescription>
