<goodsDescription><![CDATA[<style>\r\n    :root {\r\n        --cloud-dark: #084564;\r\n        --cloud-blue: #1e88e5;\r\n        --cloud-green: #2ad463;\r\n        --text-main: #333333;\r\n        --text-muted: #666666;\r\n        --bg-gray: #f9f9f9;\r\n        --border-color: #d6dae0;\r\n    }\r\n\r\n    * { box-sizing: border-box; margin: 0; padding: 0; word-break: keep-all; }\r\n    body { font-family: \'Noto Sans KR\', sans-serif; line-height: 1.6; color: var(--text-main); background: #fff; }\r\n    img { max-width: 100%; height: auto; display: block; }\r\n    \r\n    /* 1. Hero Section */\r\n    .hero {\r\n        position: relative;\r\n        background-color: var(--cloud-dark);\r\n        background-image: url(\'https://images.ctfassets.net/go54bjdzbrgi/1wGZzsN8FdD15aE29LXe4A/0f3a594b3d841ab3e7e6c4e44e5f94fc/HERO_Pix4Dcloud_2023.jpg\');\r\n        background-size: cover;\r\n        background-position: center;\r\n        color: #fff;\r\n        text-align: center;\r\n        padding: 140px 20px;\r\n    }\r\n    .hero::before {\r\n        content: \'\'; position: absolute; top: 0; left: 0; right: 0; bottom: 0;\r\n        background: rgba(8, 69, 100, 0.7); z-index: 1;\r\n    }\r\n    .hero-content { position: relative; z-index: 2; max-width: 900px; margin: 0 auto; }\r\n    .hero-title { font-size: 3.5rem; font-weight: 800; margin-bottom: 20px; }\r\n    .hero-title span { font-weight: 300; }\r\n    .hero-subtitle { font-size: 1.8rem; font-weight: 300; line-height: 1.4; }\r\n\r\n    /* 2. Workflow Section */\r\n    .workflow { padding: 80px 20px; background: #fff; }\r\n    .section-header { text-align: center; margin-bottom: 50px; }\r\n    .section-header h2 { font-size: 2.2rem; color: var(--cloud-dark); font-weight: 700; }\r\n    .workflow-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; max-width: 1200px; margin: 0 auto; }\r\n    .workflow-item { text-align: center; }\r\n    .workflow-icon { width: 80px; height: 80px; margin: 0 auto 20px; }\r\n    .workflow-item h3 { font-size: 1.2rem; color: var(--cloud-dark); margin-bottom: 10px; }\r\n    .workflow-item p { font-size: 0.95rem; color: var(--text-muted); }\r\n\r\n    /* 3. Core Values Section */\r\n    .values { padding: 80px 20px; background: var(--bg-gray); }\r\n    .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; max-width: 1000px; margin: 0 auto; }\r\n    .value-card { background: #fff; padding: 40px 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center; }\r\n    .value-card h3 { font-size: 1.4rem; color: var(--cloud-dark); margin-bottom: 15px; }\r\n    .value-card p { font-size: 1rem; color: var(--text-muted); }\r\n\r\n    /* 4. Features List Section */\r\n    .features { padding: 80px 20px; background: #fff; }\r\n    .features-container { max-width: 1000px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }\r\n    .features-list { flex: 1; min-width: 300px; }\r\n    .features-list h3 { font-size: 1.8rem; color: var(--cloud-dark); margin-bottom: 25px; }\r\n    .features-list ul { list-style: none; }\r\n    .features-list li { font-size: 1.1rem; padding: 12px 0; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; }\r\n    .features-list li::before { content: \'✔\'; color: var(--cloud-green); margin-right: 10px; font-weight: bold; }\r\n    .features-image { flex: 1; min-width: 300px; background: var(--bg-gray); border-radius: 8px; height: 350px; }\r\n\r\n    /* 5. Plans Section */\r\n    .plans { padding: 80px 20px; background: var(--bg-gray); }\r\n    .plans-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; max-width: 1200px; margin: 0 auto; }\r\n    .plan-card { background: #fff; border-radius: 8px; padding: 40px 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border-top: 4px solid var(--cloud-blue); }\r\n    .plan-card h3 { font-size: 1.6rem; color: var(--cloud-dark); margin-bottom: 20px; text-align: center; }\r\n    .plan-desc { font-size: 0.95rem; color: var(--text-main); margin-bottom: 20px; min-height: 45px; }\r\n    .plan-features { list-style: none; }\r\n    .plan-features li { font-size: 0.95rem; color: var(--text-muted); padding-left: 20px; position: relative; margin-bottom: 10px; }\r\n    .plan-features li::before { content: \'▪\'; position: absolute; left: 0; color: var(--cloud-dark); }\r\n\r\n    /* 6. Testimonials Section */\r\n    .testimonials { padding: 80px 20px; background: #fff; }\r\n    .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; max-width: 1200px; margin: 0 auto; }\r\n    .testi-card { padding: 30px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-gray); }\r\n    .testi-quote { font-size: 1rem; color: var(--cloud-dark); font-style: italic; margin-bottom: 20px; line-height: 1.7; }\r\n    .testi-author { font-size: 0.9rem; color: var(--text-muted); font-weight: bold; }\r\n\r\n    /* Responsive */\r\n    @media (max-width: 992px) {\r\n        .workflow-grid { grid-template-columns: repeat(3, 1fr); }\r\n        .values-grid, .plans-grid, .testi-grid { grid-template-columns: repeat(2, 1fr); }\r\n    }\r\n    @media (max-width: 768px) {\r\n        .hero-title { font-size: 2.5rem; }\r\n        .hero-subtitle { font-size: 1.3rem; }\r\n        .workflow-grid, .values-grid, .plans-grid, .testi-grid { grid-template-columns: 1fr; }\r\n        .features-container { flex-direction: column; }\r\n    }\r\n</style>\r\n\r\n\r\n\r\n    <!-- 1. Hero Section -->\r\n    <section class=\"hero\">\r\n        <div class=\"hero-content\">\r\n            <h1 class=\"hero-title\">PIX4D<span>cloud</span></h1>\r\n            <p class=\"hero-subtitle\">지상 및 드론 매핑, 진행 추적 및 현장 문서화를 위한 온라인 플랫폼</p>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- 2. Workflow Section -->\r\n    <section class=\"workflow\">\r\n        <div class=\"section-header\">\r\n            <h2>클라우드 기반 데이터 파이프라인</h2>\r\n        </div>\r\n        <div class=\"workflow-grid\">\r\n            <div class=\"workflow-item\">\r\n                <img class=\"workflow-icon\" src=\"https://images.ctfassets.net/go54bjdzbrgi/5cvJMAaQdsqQI4YJURaCK6/891a4ae59f7ebb7a0f7ca65dd1767920/capture_Crane_Drone.svg\" alt=\"캡처\">\r\n                <h3>캡처</h3>\r\n                <p>PIX4Dcatch, viDoc RTK 로버, PIX4Dcapture Pro를 활용한 정밀 지상/항공 데이터 수집.</p>\r\n            </div>\r\n            <div class=\"workflow-item\">\r\n                <img class=\"workflow-icon\" src=\"https://images.ctfassets.net/go54bjdzbrgi/4SOEbvhYP9zD8YSL53dLt9/d31a14561d854db4c8887ea2bd4dde18/Process.svg\" alt=\"프로세스\">\r\n                <h3>프로세스</h3>\r\n                <p>오소모자이크, 3D 메시, 포인트 클라우드, 고도 모델 자동 변환.</p>\r\n            </div>\r\n            <div class=\"workflow-item\">\r\n                <img class=\"workflow-icon\" src=\"https://images.ctfassets.net/go54bjdzbrgi/5c2mlOfTEygqbLBibh42Q3/9f063f38ba2afa995a5b6b32e4894881/timeline.svg\" alt=\"분석\">\r\n                <h3>분석</h3>\r\n                <p>직관적 인터페이스와 타임라인, 내장 측정 도구를 통한 현장 모니터링.</p>\r\n            </div>\r\n            <div class=\"workflow-item\">\r\n                <img class=\"workflow-icon\" src=\"https://images.ctfassets.net/go54bjdzbrgi/4DMv6tC6gQcIRg0JlZ0b8A/83871934da4606b62875eec5801b2ace/collaborate___share.svg\" alt=\"공유\">\r\n                <h3>공유</h3>\r\n                <p>간편한 URL 생성으로 팀 및 클라이언트와 실시간 프로젝트 협업.</p>\r\n            </div>\r\n            <div class=\"workflow-item\">\r\n                <img class=\"workflow-icon\" src=\"https://images.ctfassets.net/go54bjdzbrgi/4nLdLrquyX7evPGQPV2yvC/0a5ec22f695488d24ff1c88e247be94b/CAD_Integration.svg\" alt=\"통합\">\r\n                <h3>통합</h3>\r\n                <p>Trimble Connect 연동 및 제3자 CAD/BIM 소프트웨어 내보내기 지원.</p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- 3. Core Values Section -->\r\n    <section class=\"values\">\r\n        <div class=\"section-header\">\r\n            <h2>클라우드에서의 전문 포토그래메트리</h2>\r\n        </div>\r\n        <div class=\"values-grid\">\r\n            <div class=\"value-card\">\r\n                <h3>사용이 쉬움</h3>\r\n                <p>사전 교육이 필요 없는 사용자 친화적 플랫폼으로 몇 분 안에 새로운 프로젝트를 즉시 시작할 수 있습니다.</p>\r\n            </div>\r\n            <div class=\"value-card\">\r\n                <h3>직관적인 커뮤니케이션</h3>\r\n                <p>한 번의 클릭으로 현장 프로젝트 상태를 관련 팀 및 이해 관계자들과 원활하게 공유합니다.</p>\r\n            </div>\r\n            <div class=\"value-card\">\r\n                <h3>최신 문서화</h3>\r\n                <p>프로젝트의 영구적이고 최신 상태인 디지털 기록을 유지하여 잠재적 분쟁을 효율적으로 방지하고 해결합니다.</p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- 4. Features Section -->\r\n    <section class=\"features\">\r\n        <div class=\"features-container\">\r\n            <div class=\"features-list\">\r\n                <h3>사이트의 매핑, 측정 및 문서화</h3>\r\n                <ul>\r\n                    <li>타임라인 분석을 통한 시계열 데이터 관리</li>\r\n                    <li>정밀 부피 계산 및 컷/필(Cut/Fill) 비교</li>\r\n                    <li>IFC 파일 시각화 및 BIM 연동</li>\r\n                    <li>설계 도면(CAD)과 실제 매핑 데이터 오버레이</li>\r\n                    <li>2D 및 3D 환경에서의 시간에 따른 변화 비교</li>\r\n                    <li>원격 가상 검사(Virtual Inspection) 수행</li>\r\n                    <li>거리/면적 측정, 커스텀 주석 추가 및 공유</li>\r\n                </ul>\r\n            </div>\r\n            <!-- 영상/이미지 자리표시자 -->\r\n            <div class=\"features-image\"></div>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- 5. Plans Section -->\r\n    <section class=\"plans\">\r\n        <div class=\"section-header\">\r\n            <h2>프로젝트 규모에 맞는 솔루션</h2>\r\n        </div>\r\n        <div class=\"plans-grid\">\r\n            <div class=\"plan-card\">\r\n                <h3>PIX4Dcloud</h3>\r\n                <div class=\"plan-desc\">기본적인 2D/3D 매핑 및 현장 문서화가 필요한 전문가용</div>\r\n                <ul class=\"plan-features\">\r\n                    <li>정확한 2D 지도 및 3D 모델 생성</li>\r\n                    <li>거리, 면적 및 부피 측정</li>\r\n                    <li>주석 추가 및 고도 프로필 생성</li>\r\n                    <li>가상 검사 수행</li>\r\n                    <li>팀 및 이해관계자와 링크 공유</li>\r\n                </ul>\r\n            </div>\r\n            <div class=\"plan-card\">\r\n                <h3>PIX4Dcloud Advanced</h3>\r\n                <div class=\"plan-desc\">모든 PIX4Dcloud 기능 포함 및 고급 측량 옵션 제공</div>\r\n                <ul class=\"plan-features\">\r\n                    <li>시각적 타임라인으로 현장 진행 상황 추적</li>\r\n                    <li>AutoGCPs를 사용하여 절대 정확도 향상</li>\r\n                    <li>시간에 따른 부피 변화량 자동 비교</li>\r\n                    <li>디자인 계획 및 지도 오버레이(CAD/BIM)</li>\r\n                    <li>두 이미지 지도를 비교하여 픽셀 단위 변경 사항 확인</li>\r\n                </ul>\r\n            </div>\r\n            <div class=\"plan-card\">\r\n                <h3>Enterprise</h3>\r\n                <div class=\"plan-desc\">PIX4Dcloud Advanced 기능을 포함한 기업 맞춤형 구축 솔루션</div>\r\n                <ul class=\"plan-features\">\r\n                    <li>PIX4Dengine Cloud API 전체 액세스</li>\r\n                    <li>기존 사내 시스템과의 사용자 정의 통합</li>\r\n                    <li>보안이 강화된 사용자 정의 데이터 저장소</li>\r\n                    <li>프로젝트 처리 사용량 기반 비용 청구</li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- 6. Testimonials Section -->\r\n    <section class=\"testimonials\">\r\n        <div class=\"section-header\">\r\n            <h2>글로벌 도입 사례</h2>\r\n        </div>\r\n        <div class=\"testi-grid\">\r\n            <div class=\"testi-card\">\r\n                <p class=\"testi-quote\">\"Pix4D 솔루션을 통해 실시간 영상과 데이터를 활용하여 정확하고 신중하게 고객 맞춤형 서비스 프로그램을 제공할 수 있습니다. 이는 고객의 특정 현장 조건과 요구에 완벽하게 부합합니다.\"</p>\r\n                <div class=\"testi-author\">Brandon Lanier<br>지점 매니저, LandCare</div>\r\n            </div>\r\n            <div class=\"testi-card\">\r\n                <p class=\"testi-quote\">\"측량사들이 결과물을 수일에 걸쳐 제공하는 반면, 드론 매핑은 몇 시간 만에 완료됩니다. 실시간 데이터를 빠르게 수집하여 현장의 의사 결정을 신속히 내리고, 잠재적 문제를 사전에 식별합니다.\"</p>\r\n                <div class=\"testi-author\">Trygve Almquist<br>측량사, Isachsen</div>\r\n            </div>\r\n            <div class=\"testi-card\">\r\n                <p class=\"testi-quote\">\"PIX4Dcloud가 생성한 포인트 클라우드를 사용하면 디자인 모델과 실제 구축된 오소사진을 빠르고 쉽게 비교할 수 있습니다. 이는 프로젝트 일정에 따른 현장 진행 상황을 효율적으로 모니터링하는 최고의 방법입니다.\"</p>\r\n                <div class=\"testi-author\">Jouni Ojala<br>창립자, Rakennuslordi Oy</div>\r\n            </div>\r\n        </div>\r\n    </section>]]></goodsDescription>
