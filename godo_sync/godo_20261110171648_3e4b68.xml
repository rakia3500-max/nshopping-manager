n  }\r\n\r\n  /* ══════════════════════════════\r\n     7가지 이유 카드\r\n  ══════════════════════════════ */\r\n  .reason-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 16px;\r\n    margin-top: 40px;\r\n  }\r\n  .reason-card {\r\n    background: var(--bg3);\r\n    border: 1px solid var(--border);\r\n    border-radius: 14px;\r\n    padding: 28px 22px;\r\n    transition: border-color .25s, transform .25s;\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n  .reason-card::after {\r\n    content: \'\';\r\n    position: absolute;\r\n    bottom: 0; left: 0; right: 0;\r\n    height: 2px;\r\n    background: linear-gradient(90deg, var(--orange), transparent);\r\n    transform: scaleX(0);\r\n    transform-origin: left;\r\n    transition: transform .3s;\r\n  }\r\n  .reason-card:hover { border-color: var(--orange); transform: translateY(-4px); }\r\n  .reason-card:hover::after { transform: scaleX(1); }\r\n  .reason-num {\r\n    font-family: \'Bebas Neue\', sans-serif;\r\n    font-size: 44px;\r\n    color: rgba(255,107,0,.15);\r\n    line-height: 1;\r\n    margin-bottom: 10px;\r\n  }\r\n  .reason-icon { font-size: 26px; margin-bottom: 12px; display: block; }\r\n  .reason-title { font-size: 15px; font-weight: 700; color: var(--white); margin-bottom: 8px; }\r\n  .reason-desc { font-size: 13px; color: var(--text-muted); line-height: 1.6; }\r\n  .reason-card.span2 { grid-column: span 2; }\r\n\r\n  /* ══════════════════════════════\r\n     트리플 카메라 카드\r\n  ══════════════════════════════ */\r\n  .cam-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 16px;\r\n    margin-top: 40px;\r\n  }\r\n  .cam-card {\r\n    background: var(--bg2);\r\n    border: 1px solid var(--border);\r\n    border-radius: 12px;\r\n    padding: 24px 20px;\r\n    border-top: 3px solid var(--orange);\r\n  }\r\n  .cam-label {\r\n    font-size: 10px;\r\n    letter-spacing: 3px;\r\n    color: var(--orange);\r\n    margin-bottom: 8px;\r\n