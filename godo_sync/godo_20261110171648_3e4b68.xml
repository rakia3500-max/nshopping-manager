<!-- ★ 구조화 데이터 ★ -->\r\n\r\n\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Noto+Sans+KR:wght@300;400;500;700;900&amp;display=swap\" rel=\"stylesheet\">\r\n\r\n<style>\r\n  :root {\r\n    --orange: #FF6B00;\r\n    --orange-light: #FF8C33;\r\n    --bg: #050505;\r\n    --bg2: #0E0E0E;\r\n    --bg3: #161616;\r\n    --border: #2a2a2a;\r\n    --text: #E8E8E8;\r\n    --text-muted: #888;\r\n    --white: #ffffff;\r\n  }\r\n\r\n  * { box-sizing: border-box; }\r\n\r\n  .m4p-page-wrap {\r\n    background: var(--bg);\r\n    color: var(--text);\r\n    font-family: \'Noto Sans KR\', sans-serif;\r\n    line-height: 1.65;\r\n    word-break: keep-all;\r\n    margin: 0;\r\n    padding: 0;\r\n    /* 가로 스크롤 방지 */\r\n    overflow-x: hidden;\r\n  }\r\n\r\n  /* ── 공통 레이아웃 ── */\r\n  .wrap {\r\n    max-width: 1100px;\r\n    margin: 0 auto;\r\n    padding: 0 20px;\r\n  }\r\n  .section {\r\n    padding: 80px 0;\r\n    border-bottom: 1px solid var(--border);\r\n  }\r\n\r\n  .accent { color: var(--orange); }\r\n\r\n  /* ══════════════════════════════\r\n     HERO\r\n  ══════════════════════════════ */\r\n  .hero {\r\n    background: linear-gradient(170deg, #0d0d0d 60%, #1a0c00 100%);\r\n    padding: 80px 20px 60px;\r\n    text-align: center;\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n  .hero::before {\r\n    content: \'\';\r\n    position: absolute;\r\n    inset: 0;\r\n    background: radial-gradient(ellipse 70% 50% at 50% 80%, rgba(255,107,0,.12) 0%, transparent 70%);\r\n    pointer-events: none;\r\n  }\r\n  .hero-eyebrow {\r\n    font-size: 11px;\r\n    letter-spacing: 5px;\r\n    text-transform: uppercase;\r\n    color: var(--orange);\r\n    margin-bottom: 18px;\r\n  }\r\n  .hero-title {\r\n    font-family: \'Bebas Neue\', sans-serif;\r\n    font-size: clamp(40px, 8vw, 88px);\r\n    letter-spacing: 2px;\r\n    line-height: 1.0;\r\n    margin-bottom: 20px;\r\n    color: var(-