<goodsDescription><![CDATA[<!-- ============================================================\r\n  DJI Osmo Pocket 4P 상세페이지 | 드론박스\r\n  구조: 이미지 11장 + AI 검색(GEO) 대응 텍스트 4섹션 하드코딩\r\n  * blind/숨김 처리 없음 — 모든 텍스트 화면 노출\r\n============================================================ -->\r\n<div style=\"max-width:860px;margin:0 auto;background:#0a0a0f;font-family:\'Pretendard\',\'Apple SD Gothic Neo\',\'Malgun Gothic\',sans-serif;color:#e8e8ec;\">\r\n\r\n  <!-- [1] 히어로 -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955073/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_1_azc5fw.jpg\" alt=\"DJI Osmo Pocket 4P 듀얼 렌즈 시네마틱 포켓 짐벌 카메라 블랙 화이트 색상\" style=\"width:100%;display:block;\" loading=\"eager\">\r\n\r\n  <!-- [영상] DJI 공식 소개 영상 (lazy — 스크롤 도달 시 로드) -->\r\n  <div style=\"padding:32px 28px 8px;background:#0a0a0f;\">\r\n    <div style=\"position:relative;width:100%;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:14px;\">\r\n      <iframe src=\"https://www.youtube-nocookie.com/embed/sf7Vi1gWGhk\" title=\"DJI Osmo Pocket 4P 공식 소개 영상 - 듀얼 렌즈 시네마틱 포켓 짐벌 카메라\" style=\"position:absolute;top:0;left:0;width:100%;height:100%;border:0;\" loading=\"lazy\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen=\"\"></iframe>\r\n    </div>\r\n    <p style=\"font-size:12px;color:#6e6e7c;text-align:center;margin:10px 0 0;\">▲ DJI Osmo Pocket 4P 공식 소개 영상</p>\r\n  </div>\r\n\r\n  <!-- [2] 선택해야 하는 9가지 이유 -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955074/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_2_exgobk.jpg\" alt=\"DJI 오즈모 포켓 4P를 선택해야 하는 9가지 이유 광각 중망원 듀얼 카메라 1인치 CMOS 17스톱 다이내믹 레인지\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n  <!-- ═══════ AI 텍스트 섹션 ① 이런 분께 추천합니다 ═══════ -->\r\n  <div style=\"padding:56px 28px;background:#0d0d14;\">\r\n    <h2 style=\"font-size:26px;font-weight:700;color:#ffffff;text-align:center;margin:0 0 10px;\">DJI Osmo Pocket 4P, 이런 분께 추천합니다</h2>\r\n    <p style=\"font-size:15px;color:#9a9aa6;text-align:center;margin:0 0 36px;line-height:1.7;\">Osmo Pocket 4P는 광각과 60mm 중망원 듀얼 렌즈를 탑재한 포켓 짐벌 카메라로, 아래와 같은 촬영 목적을 가진 분들에게 가장 적합합니다.</p>\r\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;\">\r\n      <div style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <p style=\"font-size:16px;font-weight:700;color:#7ab8ff;margin:0 0 8px;\">🎬 여행 브이로거</p>\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">230g 초경량 바디에 3축 기계식 짐벌이 내장되어 있어, 이동 중 한 손 촬영에서도 흔들림 없는 여행 영상을 얻을 수 있습니다.</p>\r\n      </div>\r\n      <div style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <p style=\"font-size:16px;font-weight:700;color:#7ab8ff;margin:0 0 8px;\">👤 인물 중심 크리에이터</p>\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">60mm f/1.8 클래식 중망원 렌즈가 자연스러운 배경 압축과 보케를 만들어, 포켓 카메라에서 프리미엄 인물 사진을 구현합니다.</p>\r\n      </div>\r\n      <div style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <p style=\"font-size:16px;font-weight:700;color:#7ab8ff;margin:0 0 8px;\">🌙 야간·저조도 촬영자</p>\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">16mm(1인치) CMOS와 17스톱 다이내믹 레인지가 도시 야경, 블루 아워 같은 저조도 환경에서도 노이즈를 억제한 선명한 결과물을 제공합니다.</p>\r\n      </div>\r\n      <div style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <p style=\"font-size:16px;font-weight:700;color:#7ab8ff;margin:0 0 8px;\">🎨 색보정하는 전문 편집자</p>\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">10-bit D-Log 2 프로파일로 10억 7천만 개 컬러를 기록해, LUT 적용과 컬러 그레이딩 후반 작업의 자유도가 높습니다.</p>\r\n      </div>\r\n      <div style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <p style=\"font-size:16px;font-weight:700;color:#7ab8ff;margin:0 0 8px;\">🤳 혼자 촬영하는 1인 창작자</p>\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">손바닥 제스처로 ActiveTrack 추적을, V 사인으로 녹화를 시작할 수 있어 삼각대에 두고 혼자서도 촬영 전 과정을 제어합니다.</p>\r\n      </div>\r\n      <div style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <p style=\"font-size:16px;font-weight:700;color:#7ab8ff;margin:0 0 8px;\">⚡ 빠른 워크플로우가 필요한 분</p>\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">103GB 내장 메모리로 SD 카드 없이 즉시 촬영하고, 800MB/s 유선 전송과 18분 80% 급속 충전으로 작업 흐름이 끊기지 않습니다.</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- [3] 듀얼 카메라 시네마틱 (최강 USP) -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955074/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_4_mztghi.jpg\" alt=\"Osmo Pocket 4P 듀얼 카메라 광각 16mm 1인치 CMOS 중망원 60mm 12배 줌 17스톱 다이내믹 레인지 D-Log 2\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n  <!-- ═══════ AI 텍스트 섹션 ② Pocket 4 vs 4P 비교표 (인터랙티브 탭) ═══════ -->\r\n  <div style=\"padding:56px 28px;background:#0d0d14;\">\r\n    <h2 style=\"font-size:26px;font-weight:700;color:#ffffff;text-align:center;margin:0 0 10px;\">Osmo Pocket 4 vs Osmo Pocket 4P 비교</h2>\r\n    <p style=\"font-size:15px;color:#9a9aa6;text-align:center;margin:0 0 8px;line-height:1.7;\">두 모델의 핵심 차이는 <strong style=\"color:#e8e8ec;\">렌즈 구성</strong>입니다. Pocket 4가 단일 광각 구성이라면, Pocket 4P는 광각에 60mm 중망원을 더한 듀얼 렌즈로 인물·줌 촬영 영역을 확장했습니다.</p>\r\n    <p id=\"cmp-hint\" style=\"font-size:13px;color:#4a7dff;text-align:center;margin:0 0 24px;display:none;\">👆 모델명을 탭하면 해당 모델 스펙이 강조됩니다</p>\r\n    <div style=\"overflow-x:auto;\">\r\n      <table id=\"cmp-table\" style=\"width:100%;border-collapse:collapse;font-size:14px;min-width:560px;\">\r\n        <thead>\r\n          <tr style=\"background:#1a1a28;\">\r\n            <th style=\"padding:14px 12px;text-align:left;color:#9a9aa6;font-weight:600;border-bottom:2px solid #33334d;width:26%;\">구분</th>\r\n            <th id=\"th-p4\" class=\"col-p4\" style=\"padding:14px 12px;text-align:center;color:#8a8a9a;font-weight:700;border-bottom:2px solid #33334d;transition:color .25s,border-color .25s,background .25s;\">Osmo Pocket 4</th>\r\n            <th id=\"th-p4p\" class=\"col-p4p\" style=\"padding:14px 12px;text-align:center;color:#7ab8ff;font-weight:700;border-bottom:2px solid #4a7dff;transition:color .25s,border-color .25s,background .25s;\">Osmo Pocket 4P</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr style=\"\">\r\n            <td style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;color:#9a9aa6;\">카메라 구성</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">광각 단일 렌즈</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">광각 + 60mm 중망원 듀얼 렌즈</td>\r\n          </tr>\r\n          <tr style=\"background:#10101a;\">\r\n            <td style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;color:#9a9aa6;\">센서</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">16mm(1\") CMOS</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">광각 16mm(1\") + 중망원 12.5mm(1/1.28\")</td>\r\n          </tr>\r\n          <tr style=\"\">\r\n            <td style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;color:#9a9aa6;\">줌</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">디지털 줌 최대 4×</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">3× 광학 포함 최대 12× 줌</td>\r\n          </tr>\r\n          <tr style=\"background:#10101a;\">\r\n            <td style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;color:#9a9aa6;\">다이내믹 레인지</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">최대 14스톱</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">최대 17스톱</td>\r\n          </tr>\r\n          <tr style=\"\">\r\n            <td style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;color:#9a9aa6;\">색상 프로파일</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">10-bit D-Log</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">10-bit D-Log 2</td>\r\n          </tr>\r\n          <tr style=\"background:#10101a;\">\r\n            <td style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;color:#9a9aa6;\">슬로 모션</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">4K/240fps</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">광각 4K/240fps · 중망원 4K/200fps</td>\r\n          </tr>\r\n          <tr style=\"\">\r\n            <td style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;color:#9a9aa6;\">인물 촬영</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">광각 기반</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">60mm f/1.8 중망원 + 카메라 내 뷰티 효과</td>\r\n          </tr>\r\n          <tr style=\"background:#10101a;\">\r\n            <td style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;color:#9a9aa6;\">내장 메모리</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">107GB</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">103GB</td>\r\n          </tr>\r\n          <tr style=\"\">\r\n            <td style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;color:#9a9aa6;\">무게</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">190.5g</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;border-bottom:1px solid #1f1f30;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">230g</td>\r\n          </tr>\r\n          <tr style=\"background:#10101a;\">\r\n            <td style=\"padding:13px 12px;color:#9a9aa6;\">작동 시간</td>\r\n            <td class=\"col-p4\" style=\"padding:13px 12px;text-align:center;color:#55556a;transition:color .25s,font-weight .25s;\">최대 240분</td>\r\n            <td class=\"col-p4p\" style=\"padding:13px 12px;text-align:center;color:#ffffff;font-weight:600;transition:color .25s,font-weight .25s;\">최대 210분</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n    <p style=\"font-size:13px;color:#6e6e7c;margin:20px 0 0;line-height:1.7;\">※ 요약: 넓은 화각 하나로 가볍게 기록한다면 Pocket 4, 인물·줌·시네마틱 색감까지 욕심낸다면 듀얼 렌즈의 Pocket 4P가 정답입니다. 두 모델 모두 드론박스에서 DJI 정품으로 구매하실 수 있습니다.</p>\r\n    <script>\r\n    (function() {\r\n      var table = document.getElementById(\'cmp-table\');\r\n      if (!table) return;\r\n      var hint = document.getElementById(\'cmp-hint\');\r\n      if (hint) hint.style.display = \'block\';\r\n      var ACTIVE = { color: \'#ffffff\', fontWeight: \'600\' };\r\n      var DIM = { color: \'#55556a\', fontWeight: \'400\' };\r\n      var H_ACTIVE = { color: \'#7ab8ff\', borderBottom: \'2px solid #4a7dff\', background: \'#1e2438\', cursor: \'pointer\' };\r\n      var H_DIM = { color: \'#8a8a9a\', borderBottom: \'2px solid #33334d\', background: \'#1a1a28\', cursor: \'pointer\' };\r\n      function paint(cls, cellStyle, headStyle) {\r\n        var cells = table.querySelectorAll(\'td.\' + cls);\r\n        for (var i = 0; i < cells.length; i++) {\r\n          cells[i].style.color = cellStyle.color;\r\n          cells[i].style.fontWeight = cellStyle.fontWeight;\r\n        }\r\n        var th = table.querySelector(\'th.\' + cls);\r\n        for (var k in headStyle) th.style[k] = headStyle[k];\r\n      }\r\n      function activate(which) {\r\n        if (which === \'p4\') {\r\n          paint(\'col-p4\', ACTIVE, H_ACTIVE);\r\n          paint(\'col-p4p\', DIM, H_DIM);\r\n        } else {\r\n          paint(\'col-p4p\', ACTIVE, H_ACTIVE);\r\n          paint(\'col-p4\', DIM, H_DIM);\r\n        }\r\n      }\r\n      document.getElementById(\'th-p4\').addEventListener(\'click\', function() { activate(\'p4\'); });\r\n      document.getElementById(\'th-p4p\').addEventListener(\'click\', function() { activate(\'p4p\'); });\r\n      activate(\'p4p\');\r\n    })();\r\n    </script>\r\n  </div>\r\n\r\n  <!-- [4] 프리미엄 인물 사진 -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955074/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_5_iy0c4v.jpg\" alt=\"Osmo Pocket 4P 프리미엄 인물 사진 야간 셀피 필라이트 4K 라이브 사진 원격 라이브 뷰 Osmo FrameTap\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n  <!-- [5] 사용 시나리오 -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955074/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_3_rjxsxv.jpg\" alt=\"Osmo Pocket 4P 활용 시나리오 여행 거리 일상 프로급 창작 브이로그 촬영\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n  <!-- [6] 3축 짐벌 · ActiveTrack · 제스처 -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955075/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_6_tfgasw.jpg\" alt=\"Osmo Pocket 4P 3축 짐벌 안정화 ActiveTrack 다중 인물 추적 손바닥 V 제스처 컨트롤\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n  <!-- ═══════ AI 텍스트 섹션 ③ 입문자 구매 가이드 (HowTo) ═══════ -->\r\n  <div style=\"padding:56px 28px;background:#0d0d14;\">\r\n    <h2 style=\"font-size:26px;font-weight:700;color:#ffffff;text-align:center;margin:0 0 10px;\">Osmo Pocket 4P 입문자 구매 가이드</h2>\r\n    <p style=\"font-size:15px;color:#9a9aa6;text-align:center;margin:0 0 36px;line-height:1.7;\">처음 포켓 짐벌 카메라를 구매하신다면, 아래 4단계 순서로 선택하시면 실패가 없습니다.</p>\r\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\r\n      <div style=\"display:flex;gap:18px;background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <div style=\"flex-shrink:0;width:40px;height:40px;border-radius:50%;background:#1e3a6e;color:#7ab8ff;font-weight:700;font-size:18px;display:flex;align-items:center;justify-content:center;\">1</div>\r\n        <div>\r\n          <p style=\"font-size:16px;font-weight:700;color:#ffffff;margin:0 0 6px;\">촬영 목적 정하기</p>\r\n          <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">풍경·여행 중심이면 광각(20mm)을, 인물·줌 촬영 비중이 높다면 60mm 중망원 렌즈를 주력으로 사용하게 됩니다. Pocket 4P는 터치 한 번으로 두 렌즈를 전환하므로 목적이 혼합돼도 하나로 해결됩니다.</p>\r\n        </div>\r\n      </div>\r\n      <div style=\"display:flex;gap:18px;background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <div style=\"flex-shrink:0;width:40px;height:40px;border-radius:50%;background:#1e3a6e;color:#7ab8ff;font-weight:700;font-size:18px;display:flex;align-items:center;justify-content:center;\">2</div>\r\n        <div>\r\n          <p style=\"font-size:16px;font-weight:700;color:#ffffff;margin:0 0 6px;\">콤보 구성 선택하기</p>\r\n          <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">기본 촬영 위주라면 <strong style=\"color:#e8e8ec;\">스탠더드 콤보</strong>(본체·핸들·필라이트·운반 백), 유튜브·브이로그 제작이 목표라면 Osmo FrameTap 원격 컨트롤러, DJI Mic Mini 2 무선 마이크, 미니 삼각대까지 포함된 <strong style=\"color:#e8e8ec;\">브이로그 콤보</strong>가 유리합니다.</p>\r\n        </div>\r\n      </div>\r\n      <div style=\"display:flex;gap:18px;background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <div style=\"flex-shrink:0;width:40px;height:40px;border-radius:50%;background:#1e3a6e;color:#7ab8ff;font-weight:700;font-size:18px;display:flex;align-items:center;justify-content:center;\">3</div>\r\n        <div>\r\n          <p style=\"font-size:16px;font-weight:700;color:#ffffff;margin:0 0 6px;\">저장 공간 계획하기</p>\r\n          <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">내장 103GB만으로도 당일 촬영은 충분하지만, 4K/240fps 슬로 모션이나 D-Log 2 촬영을 자주 한다면 U3 A2 V30 등급 이상의 microSD 카드(최대 1TB 지원)를 함께 준비하세요.</p>\r\n        </div>\r\n      </div>\r\n      <div style=\"display:flex;gap:18px;background:#15151f;border:1px solid #26263a;border-radius:14px;padding:22px;\">\r\n        <div style=\"flex-shrink:0;width:40px;height:40px;border-radius:50%;background:#1e3a6e;color:#7ab8ff;font-weight:700;font-size:18px;display:flex;align-items:center;justify-content:center;\">4</div>\r\n        <div>\r\n          <p style=\"font-size:16px;font-weight:700;color:#ffffff;margin:0 0 6px;\">활용 액세서리 확장하기</p>\r\n          <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.7;\">야간·역광 촬영이 많다면 Osmo Pocket 4 필라이트, 장시간 촬영은 배터리 핸들(+130분), 주간 야외 영상은 ND 필터 세트, 화각 확장은 108° 광각 렌즈를 추가하면 활용 폭이 크게 넓어집니다.</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- [7] 성능 수치 (103GB·800MB/s·18분 충전·37MP) -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955075/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_7_yzb7iq.jpg\" alt=\"Osmo Pocket 4P 103GB 내장 메모리 800MB/s 고속 전송 18분 80% 급속 충전 37MP 고해상도 사진\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n  <!-- [8] 액세서리 -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955075/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_8_ldxnts.jpg\" alt=\"Osmo Pocket 4P 액세서리 필라이트 배터리 핸들 ND 필터 세트 블랙 미스트 필터 광각 렌즈 미니 삼각대\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n  <!-- [9] 구성품 -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955075/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_9_enopic.jpg\" alt=\"Osmo Pocket 4P 스탠더드 콤보 브이로그 콤보 구성품 비교 Osmo FrameTap DJI Mic Mini 2 미니 삼각대\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n  <!-- ═══════ AI 텍스트 섹션 ④ 확장 FAQ (공식 상세이미지 11 기준 / Schema.org) ═══════ -->\r\n  <div style=\"padding:56px 28px;background:#0d0d14;\" itemscope=\"\" itemtype=\"https://schema.org/FAQPage\">\r\n    <h2 style=\"font-size:26px;font-weight:700;color:#ffffff;text-align:center;margin:0 0 36px;\">자주 묻는 질문 (FAQ)</h2>\r\n\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;margin-bottom:12px;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. Osmo Pocket 4P에 방진·방수 기능이 있나요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">Osmo Pocket 4P는 별도의 방진·방수 등급을 갖추고 있지 않습니다. 비, 물가, 모래·먼지가 많은 환경에서는 기기에 액체나 이물질이 유입되지 않도록 주의해서 사용해 주세요.</p>\r\n      </div>\r\n    </details>\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;margin-bottom:12px;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. 두 렌즈 모두 4K/240fps 슬로 모션을 지원하나요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">최대 4K/240fps 슬로 모션 촬영은 광각 렌즈에서 지원되며, 중망원 렌즈는 최대 4K/200fps 슬로 모션 동영상 촬영을 지원합니다. 세로 촬영 모드에서는 4K 슬로 모션이 지원되지 않습니다.</p>\r\n      </div>\r\n    </details>\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;margin-bottom:12px;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. 어떤 microSD 카드를 사용해야 하나요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">최대 1TB microSD 카드를 지원하며, Lexar Silver Plus 및 Kingston CANVAS GO! Plus 시리즈의 U3 A2 V30 등급 microSDXC 카드(64GB~1TB)가 권장 모델입니다. 내장 103GB 메모리만으로도 SD 카드 없이 즉시 촬영이 가능합니다.</p>\r\n      </div>\r\n    </details>\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;margin-bottom:12px;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. 배터리 작동 시간과 충전 시간은 어떻게 되나요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">25°C 상온, 1080p/24fps 동영상 모드, Wi-Fi 꺼짐 조건에서 최대 210분 작동합니다. DJI 65W 휴대용 충전기(별도 판매) 사용 시 18분 만에 80%, 32분 만에 100% 충전됩니다.</p>\r\n      </div>\r\n    </details>\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;margin-bottom:12px;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. D-Log 2는 무엇이고 언제 사용하나요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">10-bit D-Log 2는 최대 17스톱의 다이내믹 레인지로 원본 플랫 영상을 기록하는 색상 프로파일로, 후반 컬러 그레이딩과 LUT 적용 자유도가 필요한 전문 편집 워크플로우에 적합합니다. 10-bit D-Log 2는 1× 줌에서 지원되며, 일반 D-Log 프로필은 최대 14스톱에 도달합니다.</p>\r\n      </div>\r\n    </details>\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;margin-bottom:12px;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. 제스처 컨트롤은 얼마나 먼 거리에서 인식되나요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">제스처 인식 유효 거리는 줌 배율에 따라 달라집니다. 1×~2× 줌에서는 약 3m, 2×~3× 줌에서는 4~7m, 3×~12× 줌에서는 8~15m입니다. 손바닥을 펴면 ActiveTrack이, V 사인을 하면 촬영이 시작·중지되며, 사용 시 손으로 머리를 가리지 않아야 합니다.</p>\r\n      </div>\r\n    </details>\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;margin-bottom:12px;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. ActiveTrack 사용 시 제한 사항이 있나요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">ActiveTrack은 파노라마, 타임랩스, 모션 타임랩스, SpinShot 모드에서는 지원되지 않습니다. 다중 인물 추적 활성화 상태에서는 줌 기능이 지원되지 않으며, 최대 8명까지 추적할 수 있습니다. 최적의 추적 성능을 위해 충분히 밝은 환경에서 사용하는 것이 좋습니다.</p>\r\n      </div>\r\n    </details>\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;margin-bottom:12px;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. 카메라에서 바로 라이브 사진을 촬영할 수 있나요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">네. 기기에서 직접 4K 라이브 사진을 촬영할 수 있어 DJI Mimo 앱에서 클립을 선택하거나 내보낼 필요 없이 하이라이트 순간을 즉시 확인할 수 있습니다. 라이브 사진은 16:9 및 9:16 화면비를 지원하며 최대 해상도는 16:9에서 4K, 9:16에서 3K입니다.</p>\r\n      </div>\r\n    </details>\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;margin-bottom:12px;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. Osmo FrameTap은 무엇인가요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">Osmo FrameTap은 Osmo Pocket 4P와 페어링해 터치스크린 라이브 뷰와 원격 카메라 제어를 제공하는 컨트롤러입니다. 셀피, 단체 사진, 고정 앵글 촬영을 원격으로 제어할 수 있으며, 브이로그 콤보에 마그네틱 충전 케이블과 함께 기본 포함되어 있습니다.</p>\r\n      </div>\r\n    </details>\r\n    <details style=\"background:#15151f;border:1px solid #26263a;border-radius:14px;padding:0;\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <summary style=\"cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#e8e8ec;list-style:none;\" itemprop=\"name\">Q. 800MB/s 고속 전송을 사용하려면 무엇이 필요한가요?</summary>\r\n      <div style=\"padding:0 22px 20px;\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <p style=\"font-size:14px;color:#c4c4d0;margin:0;line-height:1.8;\" itemprop=\"text\">최대 800MB/s 전송 속도는 제공된 USB-C to USB-C PD 케이블(USB 3.1)로 USB 3.1 규격을 지원하는 기기에 연결할 때 내장 저장 장치 기준으로 도달할 수 있습니다. 영상을 몇 초 만에 옮겨 촬영 후 워크플로우 효율을 크게 높일 수 있습니다.</p>\r\n      </div>\r\n    </details>\r\n  </div>\r\n\r\n  <!-- [10] 사양 -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955076/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_10_xqp7p0.jpg\" alt=\"Osmo Pocket 4P 상세 사양 크기 159.5mm 무게 230g 짐벌 카메라 센서 ISO 배터리 1545mAh Wi-Fi 블루투스\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n  <!-- [11] 공식 FAQ -->\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1782955076/Osmo_Pocket_4P_%EC%83%81%EC%84%B8%EC%9D%B4%EB%AF%B8%EC%A7%80_11_u3g48w.jpg\" alt=\"DJI Osmo Pocket 4P 공식 자주 묻는 질문 방수 발열 펌웨어 호환성 안내\" style=\"width:100%;display:block;\" loading=\"lazy\">\r\n\r\n</div>]]></goodsDescription>
