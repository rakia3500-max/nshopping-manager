 top;\r\n}\r\n.spec-tbl td:first-child { font-weight: 600; color: var(--navy); white-space: nowrap; width: 36%; }\r\n\r\n/* ── 반응형 ── */\r\n@media (max-width: 480px) {\r\n  .hero h1 { font-size: 30px; }\r\n  .sh h2 { font-size: 22px; }\r\n  .target-grid { grid-template-columns: 1fr 1fr; }\r\n  .spec-cards { grid-template-columns: 1fr 1fr; }\r\n  .trust-grid { grid-template-columns: 1fr 1fr; }\r\n  .sc-num { font-size: 26px; }\r\n}\r\n@media (max-width: 360px) {\r\n  .target-grid { grid-template-columns: 1fr; }\r\n}\r\n</style>\r\n\r\n\r\n\r\n<!-- ═══ HERO ═══ -->\r\n<section class=\"hero\">\r\n  <div class=\"hero-store-badge\">🏪 드론박스 공식 판매처</div>\r\n  <p class=\"hero-eyebrow\">DJI OSMO 360</p>\r\n  <h1>혼자서도,<br><em>영화 같은 360°</em></h1>\r\n  <p class=\"hero-sub\">셀피 스틱이 사라지는 마법.<br>1인치 360° 이미징으로 담는 8K 360° 세상.</p>\r\n  <div class=\"hero-img\">\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707142/1_frvf19.jpg\" alt=\"DJI Osmo 360 어드벤처 콤보 — 8K 360° 액션캠\" loading=\"eager\">\r\n  </div>\r\n  <div class=\"hero-chips\">\r\n    <div class=\"hchip\"><strong>1인치</strong> 360° 이미징</div>\r\n    <div class=\"hchip\"><strong>8K</strong> 네이티브 360°</div>\r\n    <div class=\"hchip\"><strong>120MP</strong> 사진</div>\r\n    <div class=\"hchip\"><strong>IP68</strong> 수심 10m 방수</div>\r\n    <div class=\"hchip\"><strong>183g</strong> 컴팩트</div>\r\n    <div class=\"hchip\">당일 출고</div>\r\n  </div>\r\n</section>\r\n\r\n<!-- ═══ 어드벤처 콤보 강조 ═══ -->\r\n<div class=\"adv-banner\">\r\n  <h2>🎒 어드벤처 콤보만의 구성</h2>\r\n  <p>스탠더드 콤보 대비 추가 포함 — 하루 종일 촬영에 최적화</p>\r\n  <div class=\"adv-items\">\r\n    <div class=\"adv-item\">🔋 배터리 3개 (약 270분)</div>\r\n    <div class=\"adv-item\">📦 다기능 배터리 케이스 2</div>\r\n    <div class=\"adv-item\">🪄 1.2m 인비저블 셀피 스틱</div>\r\n    <div class=\"adv-item\">🔩 조절식 퀵 릴리즈 마운트</div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ═══ 상세 이미지 2 (8가지 이유) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707142/2_m3eugm.jpg\" alt=\"DJI Osmo 360 선택해야 하는 8가지 이유\" loading=\"lazy\">\r\n  <figcaption>Osmo 360을 선택해야 하는 8가지 이유</figcaption>\r\n</figure>\r\n\r\n<hr class=\"divider\">\r\n\r\n<!-- ═══ 이런 분께 추천 ═══ -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">추천 대상</span>\r\n  <h2>이런 분께 <em>딱 맞습니다</em></h2>\r\n  <p>DJI Osmo 360이 빛나는 6가지 시나리오</p>\r\n</div>\r\n<div class=\"target-wrap\">\r\n  <div class=\"target-grid\">\r\n    <div class=\"tc\">\r\n      <div class=\"tc-icon\">🎬</div>\r\n      <div class=\"tag\">360° 크리에이터</div>\r\n      <h3>유튜브·인스타 360° 영상 제작자</h3>\r\n      <p>8K 해상도로 어느 각도로 잘라내도 화질 유지. 인비저블 스틱으로 편집 없이 완성된 영상.</p>\r\n    </div>\r\n    <div class=\"tc\">\r\n      <div class=\"tc-icon\">🏄</div>\r\n      <div class=\"tag\">액티비티 마니아</div>\r\n      <h3>서핑·스키·클라이밍 촬영자</h3>\r\n      <p>-20°C 혹한, IP68 방수(10m). 360° HorizonSteady로 극한의 흔들림도 부드럽게.</p>\r\n    </div>\r\n    <div class=\"tc\">\r\n      <div class=\"tc-icon\">🚴</div>\r\n      <div class=\"tag\">라이더</div>\r\n      <h3>사이클·모터스포츠 유저</h3>\r\n      <p>Apple Watch·Garmin 데이터를 영상 오버레이로. 블루투스 헤드셋 핸즈프리 제어.</p>\r\n    </div>\r\n    <div class=\"tc\">\r\n      <div class=\"tc-icon\">🌃</div>\r\n      <div class=\"tag\">야경 촬영</div>\r\n      <h3>저조도·야경 전문 촬영자</h3>\r\n      <p>f/1.9 대형 조리개 + 10-bit D-Log M으로 어두운 환경에서도 노이즈 없는 선명한 장면.</p>\r\n    </div>\r\n    <div class=\"tc\">\r\n      <div class=\"tc-icon\">✈️</div>\r\n      <div class=\"tag\">여행·브이로그</div>\r\n      <h3>여행자·브이로거</h3>\r\n      <p>183g 초경량으로 배낭에도 부담 없음. SnapShot으로 꺼내는 즉시 녹화 시작.</p>\r\n    </div>\r\n    <div class=\"tc\">\r\n      <div class=\"tc-icon\">🎙️</div>\r\n      <div class=\"tag\">사운드 크리에이터</div>\r\n      <h3>인터뷰·팟캐스터</h3>\r\n      <p>OsmoAudio™로 DJI 마이크 수신기 없이 직접 연결. 4대 내장 마이크 360° 스테레오 녹음.</p>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ═══ 상세 이미지 3 (화질 센서) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707142/3_bskeky.jpg\" alt=\"DJI Osmo 360 1인치 360° 이미징 — 네이티브 8K, 부스트 4K/120fps, 10-bit D-Log M, 120MP\" loading=\"lazy\">\r\n  <figcaption>차세대 360° 화질 — 1인치 360° 이미징, 네이티브 8K, 10-bit D-Log M, 120MP</figcaption>\r\n</figure>\r\n\r\n<hr class=\"divider\">\r\n\r\n<!-- ═══ 핵심 수치 ═══ -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">핵심 스펙</span>\r\n  <h2>숫자로 보는 <em>Osmo 360</em></h2>\r\n</div>\r\n<div class=\"spec-cards-wrap\">\r\n  <div class=\"spec-cards\">\r\n    <div class=\"sc\"><div class=\"sc-num\">8K</div><div class=\"sc-label\">네이티브 360°<br>비디오 해상도</div></div>\r\n    <div class=\"sc\"><div class=\"sc-num\">120MP</div><div class=\"sc-label\">360° 사진<br>최대 해상도</div></div>\r\n    <div class=\"sc\"><div class=\"sc-num\">100분</div><div class=\"sc-label\">8K/30fps<br>연속 녹화</div></div>\r\n    <div class=\"sc\"><div class=\"sc-num\">270분</div><div class=\"sc-label\">어드벤처 콤보<br>배터리 3개 기준</div></div>\r\n    <div class=\"sc\"><div class=\"sc-num\">10m</div><div class=\"sc-label\">IP68 방수<br>수중 촬영 가능</div></div>\r\n    <div class=\"sc\"><div class=\"sc-num\">183g</div><div class=\"sc-label\">본체 무게<br>한 손에 가볍게</div></div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ═══ 경쟁 제품 비교 ═══ -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">비교</span>\r\n  <h2>경쟁 제품과의 <em>차이</em></h2>\r\n  <p>17개 항목 상세 비교</p>\r\n</div>\r\n<div class=\"compare-wrap\">\r\n  <div class=\"compare-scroll\">\r\n    <table class=\"compare-table\">\r\n      <colgroup><col style=\"width:32%\"><col style=\"width:23%\"><col style=\"width:22%\"><col style=\"width:23%\"></colgroup>\r\n      <thead>\r\n        <tr>\r\n          <th>비교 항목</th>\r\n          <th>DJI Osmo 360</th>\r\n          <th>Insta360 X5</th>\r\n          <th>GoPro MAX 2</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr><td>360° 이미징</td><td class=\"hl\">1인치 (듀얼 렌즈 모듈)</td><td>1/2인치</td><td>1/2.3인치</td></tr>\r\n        <tr><td>360° 최대 해상도</td><td class=\"hl\">네이티브 8K</td><td>8K</td><td>5.6K</td></tr>\r\n        <tr><td>최대 사진 해상도</td><td class=\"hl\">120MP</td><td>72MP</td><td>16.6MP</td></tr>\r\n        <tr><td>단일 렌즈 최대 해상도</td><td class=\"hl\">5K/60fps</td><td>4K/60fps</td><td>4K/60fps</td></tr>\r\n        <tr><td>고속 프레임 (부스트)</td><td class=\"hl\">4K/120fps</td><td>4K/100fps</td><td>2.7K/60fps</td></tr>\r\n        <tr><td>저조도 조리개</td><td class=\"hl\">f/1.9</td><td>f/1.9</td><td>f/2.8</td></tr>\r\n        <tr><td>색상 심도</td><td class=\"hl\">10-bit D-Log M</td><td>10-bit LOG</td><td>10-bit LOG</td></tr>\r\n        <tr><td>연속 녹화 (8K/30fps)</td><td class=\"hl\">100분</td><td>약 75분</td><td>미지원</td></tr>\r\n        <tr><td>내장 메모리</td><td class=\"hl\">128GB (105GB 사용 가능)</td><td>없음</td><td>없음</td></tr>\r\n        <tr><td>본체 무게</td><td>183g</td><td>179g</td><td>약 165g</td></tr>\r\n        <tr><td>방수 등급</td><td class=\"hl\">IP68 (수심 10m)</td><td>IPX8 (수심 10m)</td><td>IPX8 (수심 5m)</td></tr>\r\n        <tr><td>무선 마이크 직접 연결</td><td class=\"ok\">OsmoAudio™ (수신기 불필요)</td><td class=\"no\">별도 수신기 필요</td><td class=\"no\">미지원</td></tr>\r\n        <tr><td>마그네틱 충전</td><td class=\"ok\">지원</td><td class=\"no\">미지원</td><td class=\"no\">미지원</td></tr>\r\n        <tr><td>스포츠 데이터 오버레이</td><td class=\"ok\">Apple Watch·Garmin·FIT</td><td class=\"no\">미지원</td><td class=\"no\">미지원</td></tr>\r\n        <tr><td>음성·제스처 제어</td><td class=\"ok\">지원</td><td class=\"no\">미지원</td><td class=\"no\">미지원</td></tr>\r\n        <tr><td>HorizonSteady 범위</td><td class=\"hl\">360° 전방향</td><td>360° 전방향</td><td>제한적</td></tr>\r\n        <tr><td>Premiere Pro 플러그인</td><td class=\"ok\">DJI Studio 플러그인</td><td class=\"ok\">Insta360 플러그인</td><td class=\"no\">미지원</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n  <p class=\"compare-note\">\r\n    DJI Osmo 360은 두 개의 대형 1인치 360 이미징 렌즈 모듈을 하나의 컴팩트 바디에 담아, 저조도 환경에서도 뚜렷하게 앞서는 화질을 제공합니다. 128GB 내장 메모리, OsmoAudio™ 무선 마이크 직접 연결, 스포츠 데이터 오버레이는 동급 경쟁 제품에서 찾기 어려운 독보적 기능입니다.\r\n  </p>\r\n</div>\r\n\r\n<!-- ═══ 상세 이미지 4 (창의적 촬영) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707142/4_ydzziv.jpg\" alt=\"DJI Osmo 360 인비저블 셀피 스틱, 360° 프레임 설정, 1인치 액션 카메라, 단일 렌즈 브이로그\" loading=\"lazy\">\r\n  <figcaption>인비저블 셀피 스틱, 360° 프레임 자유 설정, 와이드 샷, 단일 렌즈 브이로그 모드</figcaption>\r\n</figure>\r\n\r\n<!-- ═══ 상세 이미지 5 (성능·내구성) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707142/5_zswvjt.jpg\" alt=\"DJI Osmo 360 183g 컴팩트, 100분 8K 연속 녹화, 105GB 사용 가능 내장 메모리, HorizonSteady, RockSteady 3.0, IP68 방수\" loading=\"lazy\">\r\n  <figcaption>183g 컴팩트, 100분 연속 녹화, 105GB 사용 가능 내장 메모리, HorizonSteady, RockSteady 3.0, IP68 방수</figcaption>\r\n</figure>\r\n\r\n<!-- ═══ 상세 이미지 6 (DJI 생태계) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707143/6_qqobxv.jpg\" alt=\"DJI Osmo 360 생태계 호환 — Osmo 마그네틱 퀵 릴리즈, OsmoAudio 직접 연결, 마그네틱 충전\" loading=\"lazy\">\r\n  <figcaption>DJI 생태계와 완벽한 호환 — Osmo 마그네틱 퀵 릴리즈, OsmoAudio™ 직접 연결, 마그네틱 충전</figcaption>\r\n</figure>\r\n\r\n<hr class=\"divider\">\r\n\r\n<!-- ═══ 주요 기능 설명 ═══ -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">주요 기능</span>\r\n  <h2>알아두면 좋은 <em>핵심 기능</em></h2>\r\n</div>\r\n<div class=\"feat-wrap\">\r\n  <div class=\"feat-block\">\r\n    <h3>🪄 인비저블 셀피 스틱 — 나만의 팔로우 카메라</h3>\r\n    <p>Osmo 360을 인비저블 셀피 스틱과 함께 사용하면 360° 영상에서 별도 편집 없이 스틱이 자연스럽게 사라집니다. 완벽한 각도에서 모든 중요한 순간을 혼자서도 놓치지 않습니다. 어드벤처 콤보에는 1.2m 인비저블 셀피 스틱이 기본 포함됩니다.</p>\r\n  </div>\r\n  <div class=\"feat-block\">\r\n    <h3>📐 360° 자유 프레임 설정</h3>\r\n    <p>한 번의 촬영으로 360° 뷰를 모두 담아두세요. 후편집 작업에서 프레임 설정과 자르기를 자유롭게 조정할 수 있어, 촬영 구도를 어떻게 잡을지 몰라도 걱정 없습니다. 와이드 앵글, 타이니 플래닛 등 다양한 뷰로 변환 가능합니다.</p>\r\n  </div>\r\n  <div class=\"feat-block\">\r\n    <h3>🎮 제스처·음성 제어</h3>\r\n    <p>손바닥 제스처로 녹화를 시작하거나 중지할 수 있습니다. 장갑을 착용한 상태에서도 가능합니다. 음성 명령(\"녹화 시작\", \"녹화 중지\", \"사진 촬영\")으로 손을 자유롭게 사용하면서 촬영에 집중할 수 있습니다.</p>\r\n  </div>\r\n  <div class=\"feat-block\">\r\n    <h3>🏃 스포츠 데이터 오버레이</h3>\r\n    <p>Apple Watch, Garmin, FIT 파일에서 사이클링 또는 모터사이클 데이터를 추가해 영상에 대시보드 오버레이로 표시하세요. 속도, 케이던스, 고도 데이터를 영상 위에 멋지게 자랑할 수 있습니다.</p>\r\n  </div>\r\n  <div class=\"feat-block\">\r\n    <h3>🎵 OsmoAudio™ 마이크 직접 연결</h3>\r\n    <p>DJI 마이크 송신기 2대에 직접 연결할 수 있으며, 수신기 없이도 작동합니다. 초고속 샘플링 속도의 오디오와 4대의 내장 마이크로 현장감 넘치는 선명한 소리를 제공합니다.</p>\r\n  </div>\r\n</div>\r\n\r\n<!-- ═══ 상세 이미지 7 (실용 기능) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707143/7_phcbc6.jpg\" alt=\"DJI Osmo 360 제스처 컨트롤, 음성 제어, 스포츠 대시보드, 블루투스 헤드셋 오디오, SnapShot\" loading=\"lazy\">\r\n  <figcaption>제스처·음성 제어, 스포츠 대시보드, 블루투스 헤드셋 오디오, SnapShot 즉시 촬영</figcaption>\r\n</figure>\r\n\r\n<!-- ═══ 상세 이미지 8 (360° 편집) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707143/8_vzykk5.jpg\" alt=\"DJI Osmo 360 360° 편집 — 인텔리전트 추적, 프리 프레임, DJI Mimo 앱, DJI Studio Premiere 플러그인\" loading=\"lazy\">\r\n  <figcaption>360° 편집, 더 쉬워졌습니다 — 인텔리전트 추적, 프리 프레임, 멀티 플랫폼 편집</figcaption>\r\n</figure>\r\n\r\n<hr class=\"divider\">\r\n\r\n<!-- ═══ 입문자 구매 가이드 ═══ -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">구매 가이드</span>\r\n  <h2>360° 카메라 처음이신가요?</h2>\r\n  <p>구매 전 꼭 읽어보세요 — 5가지 핵심 질문</p>\r\n</div>\r\n<div class=\"guide-wrap\">\r\n  <div class=\"guide-item\">\r\n    <div class=\"guide-num\">1</div>\r\n    <div>\r\n      <p class=\"guide-q\">360° 카메라는 일반 액션캠과 어떻게 다른가요?</p>\r\n      <p class=\"guide-a\">일반 액션캠은 전면 한 방향만 촬영하지만, DJI Osmo 360은 듀얼 렌즈로 상하좌우 모든 방향을 동시에 담습니다. 촬영 후 앱에서 원하는 각도로 자유롭게 리프레이밍할 수 있어, \"촬영 후 편집으로 최적 구도를 찾는\" 완전히 새로운 방식을 경험하게 됩니다.</p>\r\n    </div>\r\n  </div>\r\n  <div class=\"guide-item\">\r\n    <div class=\"guide-num\">2</div>\r\n    <div>\r\n      <p class=\"guide-q\">어드벤처 콤보와 스탠더드 콤보 중 어떤 것이 좋을까요?</p>\r\n      <p class=\"guide-a\">스탠더드는 배터리 1개(약 100분), 어드벤처는 배터리 3개(약 270분) + 1.2m 인비저블 셀피 스틱 + 다기능 배터리 케이스 + 조절식 마운트가 포함됩니다. 하루 종일 야외 촬영이나 여행을 계획하신다면 어드벤처 콤보를 강력 추천합니다.</p>\r\n    </div>\r\n  </div>\r\n  <div class=\"guide-item\">\r\n    <div class=\"guide-num\">3</div>\r\n    <div>\r\n      <p class=\"guide-q\">편집이 어렵지 않을까요? 스마트폰으로도 가능한가요?</p>\r\n      <p class=\"guide-a\">DJI Mimo 앱(iOS·Android 무료)과 Wi-Fi 6.0으로 연결하면 스마트폰에서 바로 360° 영상을 편집하고 소셜 미디어에 공유할 수 있습니다. 전문 편집은 DJI Studio 또는 전용 Premiere Pro 플러그인을 활용할 수 있습니다.</p>\r\n    </div>\r\n  </div>\r\n  <div class=\"guide-item\">\r\n    <div class=\"guide-num\">4</div>\r\n    <div>\r\n      <p class=\"guide-q\">기존 DJI 액세서리를 그대로 쓸 수 있나요?</p>\r\n      <p class=\"guide-a\">Osmo 마그네틱 퀵 릴리즈 에코시스템을 채택해 Osmo Action 시리즈 액세서리와 완벽하게 호환됩니다. 6.35mm(1/4\") 표준 나사구멍도 지원해 일반 삼각대, 셀카봉, 마운트 등 범용 장비도 그대로 사용 가능합니다.</p>\r\n    </div>\r\n  </div>\r\n  <div class=\"guide-item\">\r\n    <div class=\"guide-num\">5</div>\r\n    <div>\r\n      <p class=\"guide-q\">메모리 카드를 따로 구매해야 하나요?</p>\r\n      <p class=\"guide-a\">128GB 내장 메모리(105GB 사용 가능)가 기본 탑재되어 있어 별도 메모리 카드 없이도 8K/30fps 고화질 영상을 넉넉하게 저장할 수 있습니다. 더 많은 용량이 필요할 경우 V30 이상 등급의 microSD(최대 1TB)를 추가 장착할 수 있습니다.</p>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ═══ 상세 이미지 9 (액세서리) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707142/9_vfcysi.jpg\" alt=\"DJI Osmo 360 액세서리 라인업 — 배터리 확장 로드, 셀피 스틱, 모터사이클 마운트, 헬멧 마운트 키트\" loading=\"lazy\">\r\n  <figcaption>다양한 액세서리와 안정적인 어시스트 — 배터리 확장 로드, 셀피 스틱, 모터사이클 마운트, 헬멧 마운트</figcaption>\r\n</figure>\r\n\r\n<!-- ═══ 상세 이미지 10 (구성품 표) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707141/10_fqkimi.jpg\" alt=\"DJI Osmo 360 구성품 비교 — 스탠더드 콤보 vs 어드벤처 콤보\" loading=\"lazy\">\r\n  <figcaption>구성품 비교 — 스탠더드 콤보 vs 어드벤처 콤보</figcaption>\r\n</figure>\r\n\r\n<hr class=\"divider\">\r\n\r\n<!-- ═══ 구성품 텍스트 표 ═══ -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">구성품</span>\r\n  <h2>어드벤처 콤보 <em>구성품</em></h2>\r\n  <p>현재 판매 상품: <strong>DJI Osmo 360 어드벤처 콤보 (배터리 3개)</strong></p>\r\n</div>\r\n<div class=\"pkg-wrap\">\r\n  <div class=\"pkg-scroll\">\r\n    <table class=\"pkg-table\">\r\n      <thead>\r\n        <tr>\r\n          <th>아이템</th>\r\n          <th>스탠더드 콤보</th>\r\n          <th>어드벤처 콤보<br>★ 현재 상품</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr><td>Osmo 360 본체</td><td class=\"chk\">× 1</td><td class=\"adv-col\">× 1</td></tr>\r\n        <tr><td>Osmo Action 익스트림 배터리 플러스 (1950mAh)</td><td class=\"chk\">× 1</td><td class=\"adv-col\">× 3 ★</td></tr>\r\n        <tr><td>Osmo Action 다기능 배터리 케이스 2</td><td>—</td><td class=\"adv-col\">× 1 ★</td></tr>\r\n        <tr><td>Osmo 360 카메라 보호 파우치</td><td class=\"chk\">× 1</td><td class=\"adv-col\">× 1</td></tr>\r\n        <tr><td>Osmo 렌즈 클리닝 천</td><td class=\"chk\">× 1</td><td class=\"adv-col\">× 1</td></tr>\r\n        <tr><td>USB-C to USB-C PD 케이블 (USB 3.1)</td><td class=\"chk\">× 1</td><td class=\"adv-col\">× 1</td></tr>\r\n        <tr><td>Osmo 조절식 퀵 릴리즈 어댑터 마운트</td><td>—</td><td class=\"adv-col\">× 1 ★</td></tr>\r\n        <tr><td>Osmo 1.2m 인비저블 셀피 스틱</td><td>—</td><td class=\"adv-col\">× 1 ★</td></tr>\r\n        <tr><td>Osmo 360 고무 렌즈 프로텍터</td><td class=\"chk\">× 1</td><td class=\"adv-col\">× 1</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</div>\r\n\r\n<!-- ═══ 드론박스 신뢰 배너 ═══ -->\r\n<div class=\"trust-wrap\">\r\n  <h2>왜 드론박스에서 구매해야 할까요?</h2>\r\n  <p>DJI 공식 파트너로서 정품과<br>전문 서비스를 함께 제공합니다.</p>\r\n  <div class=\"trust-grid\">\r\n    <div class=\"ti\"><div class=\"ti-icon\">✅</div><h4>DJI 공식 파트너</h4><p>정품 인증 제품만 판매</p></div>\r\n    <div class=\"ti\"><div class=\"ti-icon\">🚀</div><h4>당일 출고</h4><p>오후 2시 이전 주문 시 당일 발송</p></div>\r\n    <div class=\"ti\"><div class=\"ti-icon\">🛠️</div><h4>전문 기술 상담</h4><p>드론·액션캠 전문가 직접 답변</p></div>\r\n    <div class=\"ti\"><div class=\"ti-icon\">🔧</div><h4>A/S 연계 지원</h4><p>구매 후 A/S까지 책임집니다</p></div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ═══ FAQ 아코디언 ═══ -->\r\n<div class=\"sh\">\r\n  <span class=\"sh-label\">FAQ</span>\r\n  <h2>자주 묻는 질문</h2>\r\n</div>\r\n<div class=\"faq-wrap\">\r\n  <div class=\"faq-item\">\r\n    <button class=\"faq-btn\" onclick=\"toggleFaq(this)\">\r\n      <span>어드벤처 콤보와 스탠더드 콤보, 어떤 것을 선택해야 하나요?</span>\r\n      <span class=\"faq-icon\">+</span>\r\n    </button>\r\n    <div class=\"faq-ans\">어드벤처 콤보는 배터리 3개(총 약 270분), 다기능 배터리 케이스 2, 1.2m 인비저블 셀피 스틱, 조절식 퀵 릴리즈 어댑터 마운트가 추가 포함됩니다. 하루 종일 야외 촬영이나 여행, 스포츠 촬영이 주목적이라면 어드벤처 콤보를 권장합니다. 가벼운 일상 촬영이라면 스탠더드 콤보도 충분합니다.</div>\r\n  </div>\r\n  <div class=\"faq-item\">\r\n    <button class=\"faq-btn\" onclick=\"toggleFaq(this)\">\r\n      <span>인비저블 셀피 스틱은 어떻게 작동하나요?</span>\r\n      <span class=\"faq-icon\">+</span>\r\n    </button>\r\n    <div class=\"faq-ans\">DJI Osmo 360을 인비저블 셀피 스틱과 함께 사용하면 360° 영상에서 별도 편집 없이 스틱이 자동으로 사라집니다. 완벽한 각도에서 모든 중요한 순간을 혼자서도 팔로우 카메라 효과로 담을 수 있습니다. 단, 정식 DJI 인비저블 셀피 스틱을 사용하는 것을 권장하며, 타사 셀피 스틱을 사용할 경우 지워지지 않을 수 있습니다.</div>\r\n  </div>\r\n  <div class=\"faq-item\">\r\n    <button class=\"faq-btn\" onclick=\"toggleFaq(this)\">\r\n      <span>스마트폰 없이 단독으로 사용할 수 있나요?</span>\r\n      <span class=\"faq-icon\">+</span>\r\n    </button>\r\n    <div class=\"faq-ans\">후면 2인치 터치스크린(314×556)으로 설정 변경·녹화 시작·촬영 모드 전환이 모두 가능합니다. 손바닥 제스처와 음성 명령으로도 조작할 수 있어 스마트폰 없이도 완전히 독립 사용이 가능합니다.</div>\r\n  </div>\r\n  <div class=\"faq-item\">\r\n    <button class=\"faq-btn\" onclick=\"toggleFaq(this)\">\r\n      <span>메모리 카드를 따로 사야 하나요?</span>\r\n      <span class=\"faq-icon\">+</span>\r\n    </button>\r\n    <div class=\"faq-ans\">128GB 내장 메모리(105GB 사용 가능)가 기본 탑재되어 있어 별도 구매 없이도 충분합니다. 더 많은 용량이 필요하다면 Kingston CANVAS Go! Plus, Lexar SILVER PLUS 등 V30 이상 microSD(최대 1TB)를 추가 장착할 수 있습니다.</div>\r\n  </div>\r\n  <div class=\"faq-item\">\r\n    <button class=\"faq-btn\" onclick=\"toggleFaq(this)\">\r\n      <span>기존 DJI 액세서리와 호환이 되나요?</span>\r\n      <span class=\"faq-icon\">+</span>\r\n    </button>\r\n    <div class=\"faq-ans\">Osmo 마그네틱 퀵 릴리즈 에코시스템을 채택해 Osmo Action 시리즈 액세서리와 완벽하게 호환됩니다. 6.35mm(1/4\") 표준 나사구멍도 지원해 일반 삼각대, 셀카봉 등 범용 장비도 사용 가능합니다.</div>\r\n  </div>\r\n  <div class=\"faq-item\">\r\n    <button class=\"faq-btn\" onclick=\"toggleFaq(this)\">\r\n      <span>DJI 마이크가 있는데 연결이 되나요?</span>\r\n      <span class=\"faq-icon\">+</span>\r\n    </button>\r\n    <div class=\"faq-ans\">OsmoAudio™ 단자로 DJI 마이크 2 송신기를 수신기 없이 직접 연결할 수 있습니다. 기존 DJI 마이크 2 송신기가 있다면 추가 구매 없이 바로 활용됩니다.</div>\r\n  </div>\r\n  <div class=\"faq-item\">\r\n    <button class=\"faq-btn\" onclick=\"toggleFaq(this)\">\r\n      <span>배터리를 비행기에 가지고 탈 수 있나요?</span>\r\n      <span class=\"faq-icon\">+</span>\r\n    </button>\r\n    <div class=\"faq-ans\">Osmo Action 익스트림 배터리 플러스(1950mAh)는 7.5Wh로 기내반입 제한(100Wh 이하) 이내에 해당합니다. 대부분의 항공사 기준에 따라 기내 수하물로 탑승 가능하나, 항공사마다 규정이 다를 수 있으므로 사전 확인을 권장합니다.</div>\r\n  </div>\r\n  <div class=\"faq-item\">\r\n    <button class=\"faq-btn\" onclick=\"toggleFaq(this)\">\r\n      <span>360° 영상 편집은 어떻게 하나요?</span>\r\n      <span class=\"faq-icon\">+</span>\r\n    </button>\r\n    <div class=\"faq-ans\">스마트폰에서는 DJI Mimo 앱(무료)으로, PC에서는 DJI Studio 또는 전용 Adobe Premiere Pro 플러그인으로 편집할 수 있습니다. 프리 프레임 기능을 활용하면 휴대폰을 움직여 원하는 각도를 찾아 한 번의 탭으로 완성된 클립을 만들 수 있습니다.</div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ═══ 상세 이미지 11~12 (스펙, FAQ) ═══ -->\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707143/11_0728_a3ye4x.jpg\" alt=\"DJI Osmo 360 상세 스펙표\" loading=\"lazy\">\r\n  <figcaption>DJI Osmo 360 상세 스펙 — 기체, 카메라, 배터리, 연결</figcaption>\r\n</figure>\r\n<figure class=\"img-block\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773707143/12_0728_xearmr.jpg\" alt=\"DJI Osmo 360 자주 묻는 질문 FAQ\" loading=\"lazy\">\r\n  <figcaption>DJI Osmo 360 자주 묻는 질문</figcaption>\r\n</figure>\r\n\r\n<hr class=\"divider\">\r\n\r\n<!-- ═══ 상세 스펙표 (dji.com/kr/360/specs 공식 값, 2026-07-22 대조) ═══ -->\r\n<section class=\"spec-full-wrap\">\r\n  <div class=\"sh\" style=\"padding-top:0;\">\r\n    <span class=\"sh-label\">Specifications</span>\r\n    <h2>제품 상세 사양</h2>\r\n  </div>\r\n\r\n  <div class=\"spec-group\">\r\n    <div class=\"spec-group-title\">기체</div>\r\n    <table class=\"spec-tbl\">\r\n      <tbody>\r\n        <tr><td>크기</td><td>61 × 36.3 × 81 mm (L×W×H)</td></tr>\r\n        <tr><td>무게</td><td>183g</td></tr>\r\n        <tr><td>방수</td><td>IP68 — 카메라 본체만 최대 수심 10m (사용 전 배터리 함·USB-C 커버 닫힘 확인. 장시간 수중 촬영 시 본체 단독 사용은 권장되지 않음)</td></tr>\r\n        <tr><td>터치스크린</td><td>2.0인치 / 해상도 314×556 / 밝기 800cd/㎡</td></tr>\r\n        <tr><td>마이크</td><td>4개 내장</td></tr>\r\n        <tr><td>내장 메모리</td><td>128GB (사용 가능 105GB)</td></tr>\r\n        <tr><td>지원 microSD</td><td>최대 1TB (V30 이상 권장)</td></tr>\r\n        <tr><td>동영상 파일 형식</td><td>OSV, MP4 (HEVC)</td></tr>\r\n        <tr><td>최대 동영상 비트전송률</td><td>170Mbps</td></tr>\r\n        <tr><td>사진 파일 형식</td><td>JPEG</td></tr>\r\n        <tr><td>최소 합성(스티칭) 거리</td><td>75cm 이상</td></tr>\r\n        <tr><td>USB</td><td>USB 3.1 Type-C (최대 30W PD 충전)</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n\r\n  <div class=\"spec-group\">\r\n    <div class=\"spec-group-title\">카메라</div>\r\n    <table class=\"spec-tbl\">\r\n      <tbody>\r\n        <tr><td>센서</td><td>15.9mm (1/1.1″) CMOS × 듀얼 (1인치 360° 이미징)</td></tr>\r\n        <tr><td>조리개</td><td>f/1.9</td></tr>\r\n        <tr><td>ISO 범위</td><td>100 ~ 51200</td></tr>\r\n        <tr><td>전자 셔터 속도</td><td>사진: 1/8000 ~ 30초 / 동영상: 1/8000초 ~ 프레임 속도 한계</td></tr>\r\n        <tr><td>파노라마(360°) 동영상</td><td>8K (7680×3840) @ 24/25/30/48/50fps<br>6K (6000×3000) @ 최대 60fps<br>4K (3840×1920) @ 100fps</td></tr>\r\n        <tr><td>단일 렌즈 동영상</td><td>5K (4:3·16:9) @ 최대 60fps<br>4K·2.7K @ 최대 60fps</td></tr>\r\n        <tr><td>부스트 비디오</td><td>4K·2.7K @ 최대 120fps (9:16 세로 포함)</td></tr>\r\n        <tr><td>360° 사진</td><td>최대 120MP (15520×7760)</td></tr>\r\n        <tr><td>색상 심도</td><td>10-bit D-Log M</td></tr>\r\n        <tr><td>안정화 기능</td><td>RockSteady 3.0 / HorizonSteady</td></tr>\r\n        <tr><td>Pre-REC</td><td>5/10/15/30초, 1/2/5분</td></tr>\r\n        <tr><td>지능형 기능</td><td>인텔리전트 추적, 인비저블 셀피 스틱, 프리 프레임, SnapShot</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n\r\n  <div class=\"spec-group\">\r\n    <div class=\"spec-group-title\">배터리 (Osmo Action 익스트림 배터리 플러스)</div>\r\n    <table class=\"spec-tbl\">\r\n      <tbody>\r\n        <tr><td>용량</td><td>1950mAh (Li-ion 1S)</td></tr>\r\n        <tr><td>에너지</td><td>7.5Wh</td></tr>\r\n        <tr><td>전압</td><td>3.87V</td></tr>\r\n        <tr><td>작동 온도</td><td>-20 ~ 45°C</td></tr>\r\n        <tr><td>충전 온도</td><td>5 ~ 40°C</td></tr>\r\n        <tr><td>연속 녹화 시간</td><td>배터리 1개당 최대 100분 (8K/30fps) · 인듀런스 모드 최대 120분 · 6K/24fps 최대 190분 (25°C 실험실 환경 기준)</td></tr>\r\n        <tr><td>어드벤처 콤보 총 녹화 시간</td><td>약 270분 이상 (배터리 3개, 8K/30fps 기준 판매자 추정)</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n\r\n  <div class=\"spec-group\">\r\n    <div class=\"spec-group-title\">연결</div>\r\n    <table class=\"spec-tbl\">\r\n      <tbody>\r\n        <tr><td>Wi-Fi 작동 주파수</td><td>2.400~2.4835 GHz / 5.150~5.250 GHz / 5.725~5.850 GHz</td></tr>\r\n        <tr><td>Wi-Fi 프로토콜</td><td>Wi-Fi 6.0 (802.11 a/b/g/n/ac/ax)</td></tr>\r\n        <tr><td>블루투스 작동 주파수</td><td>2.400~2.4835 GHz</td></tr>\r\n        <tr><td>블루투스 프로토콜</td><td>BLE 5.1</td></tr>\r\n        <tr><td>OsmoAudio™</td><td>DJI 마이크 송신기 2대 직접 연결 (수신기 불필요)</td></tr>\r\n        <tr><td>오디오 녹음</td><td>16-bit 48kHz AAC</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</section>\r\n\r\n<script>\r\nfunction toggleFaq(btn) {\r\n  var item = btn.closest(\'.faq-item\');\r\n  var isOpen = item.classList.contains(\'open\');\r\n  document.querySelectorAll(\'.faq-item.open\').forEach(function(el) {\r\n    el.classList.remove(\'open\');\r\n    el.querySelector(\'.faq-btn\').setAttribute(\'aria-expanded\',\'false\');\r\n  });\r\n  if (!isOpen) {\r\n    item.classList.add(\'open\');\r\n    btn.setAttribute(\'aria-expanded\',\'true\');\r\n  }\r\n}\r\n</script>]]></goodsDescription>
