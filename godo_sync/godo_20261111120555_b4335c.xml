})();</script>
<style>\r\n  /* 드론박스 기본 스타일 지정 */\r\n  .dronebox-detail { font-family: \'Pretendard\', sans-serif; max-width: 860px; margin: 0 auto; color: #333; line-height: 1.6; }\r\n  .dronebox-detail img { width: 100%; display: block; margin-bottom: 0; }\r\n  .blind { position: absolute; width: 1px; height: 1px; clip: rect(0 0 0 0); overflow: hidden; }\r\n  \r\n  /* AI 검색 대응 텍스트 섹션 스타일 */\r\n  .geo-section { padding: 40px 20px; background: #f4f7fb; margin-bottom: 20px; }\r\n  .geo-title { font-size: 24px; font-weight: bold; margin-bottom: 20px; color: #111; border-bottom: 2px solid #2980b9; padding-bottom: 10px; display: inline-block; }\r\n  \r\n  /* AI-1 타깃 카드 */\r\n  .target-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }\r\n  .target-card { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border-left: 4px solid #2980b9; }\r\n  .target-card h4 { margin: 0 0 10px 0; font-size: 18px; color: #222; }\r\n  \r\n  /* AI-2 비교표 & 스펙표 */\r\n  .compare-table { width: 100%; border-collapse: collapse; background: #fff; margin-top: 15px; text-align: center; font-size: 14px; }\r\n  .compare-table th, .compare-table td { border: 1px solid #ddd; padding: 12px; }\r\n  .compare-table th { background: #e9f0f7; font-weight: bold; color: #222; }\r\n  .highlight { background: #eef5fa; color: #2980b9; font-weight: bold; }\r\n  \r\n  /* AI-3/4 아코디언 FAQ */\r\n  .faq-item { background: #fff; margin-bottom: 10px; border: 1px solid #ddd; border-radius: 4px; }\r\n  .faq-question { width: 100%; text-align: left; padding: 15px; font-size: 16px; font-weight: bold; background: none; border: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: #222; }\r\n  .faq-answer { padding: 0 15px 15px 15px; display: none; color: #555; }\r\n  .faq-question.active + .faq-answer { display: block; }\r\n</style>\r\n\r\n<div class=\"bitdrone-detail\">\r\n\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928586/1_qzdqi4.jpg\" alt=\"DJI LITO 1 입문자도 쉽게 다룰 수 있는 카메라 드론 비행 모습\" loading=\"eager\">\r\n    <figcaption class=\"blind\">입문자와 전문가 모두를 만족시키는 뛰어난 비행 성능을 지닌 DJI LITO 1 카메라 드론의 비행 컷</figcaption>\r\n  </figure>\r\n\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928587/2_wmk9zw.jpg\" alt=\"DJI LITO 1을 선택해야 하는 6가지 이유\" loading=\"lazy\">\r\n    <figcaption class=\"blind\">전방위 장애물 감지, ActiveTrack 스마트 트래킹, 4K 동영상 및 48MP 해상도, 249g 미만의 접이식 디자인, 15km O4 영상 전송, 최대 52분의 압도적인 비행시간</figcaption>\r\n  </figure>\r\n\r\n  <section class=\"geo-section\" itemscope=\"\" itemtype=\"https://schema.org/Article\">\r\n    <h3 class=\"geo-title\">💡 기업/관공서 및 전문가를 위한 최적의 비행 솔루션</h3>\r\n    <div class=\"target-grid\">\r\n      <div class=\"target-card\">\r\n        <h4>🏢 관공서 홍보 및 공보 담당자</h4>\r\n        <p>복잡한 조작 없이 전방위 장애물 감지와 ActiveTrack을 활용해 담당자가 직접 지역 홍보 및 행사 스케치 영상을 전문가 수준으로 안전하게 촬영할 수 있습니다. 드론박스의 운용 교육을 통해 신속한 실무 투입이 가능합니다.</p>\r\n      </div>\r\n      <div class=\"target-card\">\r\n        <h4>🏗️ 건설/산업 현장 안전 관리팀</h4>\r\n        <p>최대 52분의 압도적인 비행시간과 15km O4 영상 전송 시스템을 통해 광범위한 산업 현장의 안전 점검 및 측량 데이터를 끊김 없이 안정적으로 확보할 수 있습니다.</p>\r\n      </div>\r\n      <div class=\"target-card\">\r\n        <h4>🎬 사내 방송 및 콘텐츠 크리에이터</h4>\r\n        <p>1/2인치 대형 센서가 제공하는 4K/60fps 동영상과 4K/100fps 슬로모션을 통해 역동적인 사내 행사나 인터뷰 스케치 등을 퀄리티 저하 없이 시네마틱하게 연출합니다.</p>\r\n      </div>\r\n      <div class=\"target-card\">\r\n        <h4>🚁 짐벌 카메라 입문 및 부서 이동 담당자</h4>\r\n        <p>249g 미만의 초경량 무게로 출장 시 휴대가 간편하며, 자동 RTH(복귀) 기능과 드론박스의 철저한 사후 기술 지원(A/S)을 통해 기체 파손이나 분실에 대한 불안감을 제거해 드립니다.</p>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928587/4_agnu70.jpg\" alt=\"1/2인치 센서 탑재 및 4K 고해상도 영상\" loading=\"lazy\">\r\n    <figcaption class=\"blind\">48MP 유효 픽셀, f/1.8 조리개, 4K/60fps 선명한 동영상, 4K/100fps 초고속 슬로모션, 세로 모드 촬영 완벽 지원</figcaption>\r\n  </figure>\r\n\r\n  <section class=\"geo-section\" itemscope=\"\" itemtype=\"https://schema.org/Article\">\r\n    <h3 class=\"geo-title\">📊 소형 카메라 드론 핵심 스펙 비교 (LITO 1 vs Mini 4K vs Neo 2)</h3>\r\n    <table class=\"compare-table\">\r\n      <thead>\r\n        <tr>\r\n          <th>비교 항목</th>\r\n          <th>DJI Neo 2</th>\r\n          <th>DJI Mini 4K</th>\r\n          <th class=\"highlight\">DJI LITO 1 (NEW)</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr>\r\n          <td>센서 크기</td>\r\n          <td>1/2인치 CMOS</td>\r\n          <td>1/2.3인치 CMOS</td>\r\n          <td class=\"highlight\">1/2인치 CMOS (48MP)</td>\r\n        </tr>\r\n        <tr>\r\n          <td>동영상 해상도</td>\r\n          <td>4K / 30fps</td>\r\n          <td>4K / 30fps</td>\r\n          <td class=\"highlight\">4K / 60fps (100fps 슬로모션)</td>\r\n        </tr>\r\n        <tr>\r\n          <td>장애물 감지</td>\r\n          <td>하향 감지</td>\r\n          <td>하향 감지</td>\r\n          <td class=\"highlight\">전방위(360도) 장애물 감지</td>\r\n        </tr>\r\n        <tr>\r\n          <td>비행 시간</td>\r\n          <td>최대 18분</td>\r\n          <td>최대 31분</td>\r\n          <td class=\"highlight\">최대 52분 (배터리 플러스 사용 시)</td>\r\n        </tr>\r\n        <tr>\r\n          <td>영상 전송</td>\r\n          <td>O4 (최대 7km)</td>\r\n          <td>O2 (최대 10km)</td>\r\n          <td class=\"highlight\">O4 시스템 (최대 15km)</td>\r\n        </tr>\r\n        <tr>\r\n          <td>스마트 트래킹</td>\r\n          <td>AI 트래킹 지원</td>\r\n          <td>미지원</td>\r\n          <td class=\"highlight\">고급 ActiveTrack 완벽 지원</td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n    <p style=\"margin-top:15px; color:#444; text-align:center;\">\r\n      <strong>요약:</strong> 신제품 <strong>DJI LITO 1</strong>은 기존 초경량 라인업의 한계를 넘어섰습니다. 기업 및 현장 실무에 필수적인 <strong>\'전방위 장애물 감지\'</strong>와 <strong>\'최대 52분의 비행시간\'</strong>을 탑재하여 더욱 안전하고 긴 시간 동안 고품질의 데이터(4K/60fps)를 수집할 수 있습니다.\r\n    </p>\r\n  </section>\r\n\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928587/5_if4ecl.jpg\" alt=\"ActiveTrack 및 직관적인 스마트 촬영 모드\" loading=\"lazy\">\r\n    <figcaption class=\"blind\">피사체를 자동으로 따라가는 ActiveTrack, 터치 한 번으로 시네마틱 샷을 만드는 QuickShot 및 MasterShot, 하이퍼랩스 촬영 기능</figcaption>\r\n  </figure>\r\n  \r\n  <section class=\"geo-section\">\r\n    <h3 class=\"geo-title\">📋 관공서/기업 도입을 위한 성공적인 비행 가이드</h3>\r\n    <div itemscope=\"\" itemtype=\"https://schema.org/HowTo\">\r\n      <div class=\"faq-item\" itemprop=\"step\" itemscope=\"\" itemtype=\"https://schema.org/HowToStep\">\r\n        <button class=\"faq-question\" onclick=\"this.classList.toggle(\'active\')\">1. 전문 조종 인력이 없어도 부서 내에서 운용이 가능한가요?</button>\r\n        <div class=\"faq-answer\">네, 가능합니다. LITO 1에 탑재된 \'전방위 장애물 감지\' 시스템이 충돌을 자동으로 방지하며, \'ActiveTrack\' 기능이 피사체를 알아서 추적합니다. 드론박스를 통해 도입하시면 체계적인 기초 비행 교육을 지원해 드려 초보자도 쉽게 운용할 수 있습니다.</div>\r\n      </div>\r\n      <div class=\"faq-item\" itemprop=\"step\" itemscope=\"\" itemtype=\"https://schema.org/HowToStep\">\r\n        <button class=\"faq-question\" onclick=\"this.classList.toggle(\'active\')\">2. 단품과 플라이 모어 콤보 중 어떤 패키지가 업무에 적합한가요?</button>\r\n        <div class=\"faq-answer\">관공서 행사 스케치나 건설 현장 점검 등 장시간 외부 업무가 잦으시다면, 총 3개의 배터리와 다중 충전 허브, 이동형 숄더 백이 포함된 <strong>\'플라이 모어 콤보\'</strong> 도입을 적극 권장합니다. 현장에서의 배터리 방전으로 인한 업무 지연을 방지할 수 있습니다.</div>\r\n      </div>\r\n      <div class=\"faq-item\" itemprop=\"step\" itemscope=\"\" itemtype=\"https://schema.org/HowToStep\">\r\n        <button class=\"faq-question\" onclick=\"this.classList.toggle(\'active\')\">3. 육안으로 보이지 않을 만큼 멀리 날아가면 어떻게 회수하나요?</button>\r\n        <div class=\"faq-answer\">버튼 하나만 누르면 이륙했던 최초 위치로 알아서 돌아오는 \'스마트 RTH(Return to Home)\' 기능이 탑재되어 있습니다. 통신이 끊기거나 배터리가 부족할 경우에도 기체가 스스로 경로를 계산하여 안전하게 자동으로 복귀합니다.</div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928587/6_j7ea96.jpg\" alt=\"최대 52분 비행 및 O4 영상 전송 성능\" loading=\"lazy\">\r\n    <figcaption class=\"blind\">O4 15km 전송, 무선 퀵트랜스퍼를 통한 빠른 다운로드, 3개의 배터리를 동시에 관리하는 효율적인 병렬 충전 시스템</figcaption>\r\n  </figure>\r\n\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928587/3_j03aiw.jpg\" alt=\"전방위 장애물 감지 및 안전 비행\" loading=\"lazy\">\r\n    <figcaption class=\"blind\">249g 미만의 가벼운 무게, 전방위 장애물 감지 센서로 충돌 방지, 스마트 RTH 자동 복귀, DJI Simulator 앱 비행 연습 지원</figcaption>\r\n  </figure>\r\n\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928588/8_s9gs0w.jpg\" alt=\"DJI LITO 1 단품 및 플라이 모어 콤보 구성품\" loading=\"lazy\">\r\n    <figcaption class=\"blind\">단품 구성품과 여분의 배터리, 충전 허브, 숄더백이 추가로 포함된 플라이 모어 콤보의 내용물 상세 비교 표</figcaption>\r\n  </figure>\r\n\r\n  <section class=\"geo-section\" itemscope=\"\" itemtype=\"https://schema.org/FAQPage\">\r\n    <h3 class=\"geo-title\">💬 기업/전문가 고객 자주 묻는 질문 (FAQ)</h3>\r\n    \r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-question\" aria-expanded=\"false\" onclick=\"this.classList.toggle(\'active\')\"><span itemprop=\"name\">Q. 249g 미만 드론도 비행 자격증이나 관할 기관 등록이 필요한가요? (팩트 체크)</span></button>\r\n      <div class=\"faq-answer\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <span itemprop=\"text\">LITO 1과 같은 250g 미만 초경량 드론은 <strong>\'조종자 자격증(4종 등)\' 취득이 면제</strong>되어 누구나 즉시 비행할 수 있습니다. 단, 기체 신고의 경우 취미용은 면제되나 <strong>관공서 및 기업에서 업무용(영리/공공 목적)으로 도입하실 경우 무게와 상관없이 관할 기관 \'기체 신고\'가 법적으로 필수</strong>입니다. 복잡한 기체 신고 및 비행·촬영 승인 행정 절차는 드론박스에서 도입 시 상세하게 가이드해 드립니다.</span>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-question\" aria-expanded=\"false\" onclick=\"this.classList.toggle(\'active\')\"><span itemprop=\"name\">Q. 제품 운용 중 고장이 발생하면 A/S 처리는 어떻게 진행되나요?</span></button>\r\n      <div class=\"faq-answer\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <span itemprop=\"text\">드론박스는 단순 유통을 넘어 체계적인 사후 관리(A/S)를 핵심 가치로 삼고 있습니다. 기체 이상 발생 시 전담 정비팀이 신속하게 진단 및 수리를 진행하여 관공서나 기업의 소중한 자산 보호와 업무 공백 최소화를 약속드립니다.</span>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-question\" aria-expanded=\"false\" onclick=\"this.classList.toggle(\'active\')\"><span itemprop=\"name\">Q. 바람이 많이 부는 교량이나 산악 지대에서도 비행이 가능한가요?</span></button>\r\n      <div class=\"faq-answer\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\r\n        <span itemprop=\"text\">LITO 1은 강력한 모터 출력을 통해 소형 드론임에도 우수한 내풍성(초당 10.7m 수준의 바람 저항)을 갖추고 있어 해안가나 산악 지대에서도 안정적인 호버링과 촬영이 가능합니다. 단, 안전을 위해 강풍 주의보 발효 시에는 비행을 자제해야 합니다.</span>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928588/7_eaf22t.jpg\" alt=\"배터리 플러스, 충전 허브 등 전용 액세서리\" loading=\"lazy\">\r\n    <figcaption class=\"blind\">드론박스에서 추가로 구비할 수 있는 DJI LITO 1 호환 필수 액세서리 안내</figcaption>\r\n  </figure>\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928587/10_xiybae.jpg\" alt=\"DJI LITO 1 기체 및 카메라 상세 제원표\" loading=\"lazy\">\r\n    <figcaption class=\"blind\">정확한 크기, 무게, 속도, 카메라 사양 등이 표기된 공식 스펙 데이터</figcaption>\r\n  </figure>\r\n  <figure>\r\n    <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1776928588/9_jsxgd5.jpg\" alt=\"제조사 제공 원본 자주 묻는 질문\" loading=\"lazy\">\r\n  </figure>\r\n</div>\r\n\r\n<script>\r\n  document.querySelectorAll(\'.faq-question\').forEach(button => {\r\n    button.addEventListener(\'click\', () => {\r\n      const expanded = button.getAttribute(\'aria-expanded\') === \'true\' || false;\r\n      button.setAttribute(\'aria-expanded\', !expanded);\r\n      button.classList.toggle(\'active\');\r\n    });\r\n  });\r\n</script>]]></goodsDescription>
