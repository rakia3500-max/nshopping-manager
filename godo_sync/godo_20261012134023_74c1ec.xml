<goodsDescription><![CDATA[<style>\r\n    /* DJI Premium Dynamic Theme - Zenmuse H30 Series */\r\n    .dji-wrap { \r\n        width: 100%; max-width: 1000px; margin: 0 auto; \r\n        background-color: #000000; color: #ffffff; \r\n        font-family: \'Pretendard\', \'Malgun Gothic\', sans-serif; \r\n        word-break: keep-all; line-height: 1.6; overflow-x: hidden;\r\n    }\r\n\r\n    /* 1. Trust Badge */\r\n    .dji-badge { background: #111111; border-bottom: 1px solid #333333; padding: 25px 20px; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 20px; }\r\n    .dji-badge-title { font-size: 30px; font-weight: 900; letter-spacing: -1px; }\r\n    .dji-badge-sub { font-size: 16px; font-weight: 600; color: #888888; vertical-align: middle; margin-left: 8px; }\r\n    .dji-badge-desc { color: #bbbbbb; font-size: 14px; line-height: 1.5; max-width: 600px; }\r\n    .dji-badge-desc strong { color: #ffffff; font-size: 16px; }\r\n\r\n    /* 2. Hero Section */\r\n    .dji-hero-video { position: relative; width: 100%; height: 80vh; min-height: 600px; overflow: hidden; background-color: #111; }\r\n    .dji-hero-video video { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; }\r\n    .dji-hero-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; background: linear-gradient(to top, #000000 0%, transparent 50%); text-align: center; padding: 0 20px; }\r\n    .dji-hero-overlay img { height: 48px; margin-bottom: 20px; }\r\n    .dji-hero-sub { font-size: 20px; font-weight: 400; color: rgba(255,255,255,0.8); letter-spacing: 1px; margin-bottom: 10px; }\r\n    .dji-hero-title { font-size: 48px; font-weight: 900; letter-spacing: -1px; margin-bottom: 20px; color: #fff; }\r\n    .dji-hero-desc { color: #ccc; font-size: 18px; max-width: 800px; font-weight: 400; }\r\n\r\n    /* 3. Intro Block */\r\n    .dji-intro { padding: 80px 20px 60px; text-align: center; background: #080808; }\r\n    .dji-intro-title { font-size: 38px; font-weight: 900; margin-bottom: 20px; letter-spacing: -1px; }\r\n    .dji-intro-desc { color: #aaaaaa; font-size: 17px; max-width: 880px; margin: 0 auto; line-height: 1.7; }\r\n\r\n    /* 4. Table Styles (For Comparison & Specs - Readability Improved) */\r\n    .dji-plan-sec { padding: 0 20px 80px; background: #080808; border-bottom: 1px solid #222; }\r\n    .dji-specs-sec { padding: 80px 20px; background: #000; border-top: 1px solid #222; }\r\n    .dji-plan-title { font-size: 28px; font-weight: 800; text-align: center; margin-bottom: 30px; letter-spacing: -1px; color: #fff; }\r\n    .dji-table-wrap { overflow-x: auto; margin: 0 auto; max-width: 900px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }\r\n    \r\n    .dji-plan-table { width: 100%; min-width: 600px; border-collapse: collapse; font-size: 15px; text-align: center; background: #111; color: #f5f5f5; }\r\n    .dji-plan-table th, .dji-plan-table td { padding: 18px 15px; border: 1px solid #2a2a2a; color: #f5f5f5; }\r\n    .dji-plan-table th { background: #1a1a1a; color: #ffffff; font-weight: 800; font-size: 17px; border-bottom: 2px solid #333; }\r\n    .dji-plan-table th.section-head { background: #181818; color: #10b981; text-align: left; padding-left: 30px; font-size: 16px; border-bottom: 1px solid #333; }\r\n    .dji-plan-table td.feature-name { background: #0a0a0a; text-align: left; font-weight: 800; color: #ffffff; width: 30%; padding-left: 30px; }\r\n    .dji-plan-table th.highlight { color: #10b981; }\r\n    .dji-plan-table td .check { color: #10b981; font-weight: bold; font-size: 18px; }\r\n    .dji-plan-table td .cross { color: #999999; font-size: 15px; font-weight: bold; }\r\n    .dji-plan-table tr:hover td { background: #1a1a1a; }\r\n\r\n    /* 5. Modules Grid */\r\n    .dji-modules-sec { padding: 80px 20px; background: #000; }\r\n    .dji-modules-title { text-align: center; font-size: 36px; font-weight: 900; margin-bottom: 50px; }\r\n    .dji-modules-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }\r\n    .dji-module-card { background: #141414; border-radius: 12px; overflow: hidden; border: 1px solid #2a2a2a; transition: transform 0.3s ease; }\r\n    .dji-module-card:hover { transform: translateY(-5px); border-color: #555; }\r\n    .dji-module-card img { width: 100%; height: 250px; object-fit: cover; display: block; border-bottom: 1px solid #222; }\r\n    .dji-module-text { padding: 25px; }\r\n    .dji-module-text h3 { font-size: 22px; font-weight: 800; margin-bottom: 15px; color: #fff; }\r\n    .dji-module-text p { color: #ccc; font-size: 15px; line-height: 1.6; margin-bottom: 0; }\r\n    \r\n    .dji-module-card.full-width { grid-column: span 2; display: flex; flex-direction: row; align-items: center; }\r\n    .dji-module-card.full-width img { width: 50%; height: 100%; border-bottom: none; border-right: 1px solid #222; }\r\n    .dji-module-card.full-width .dji-module-text { width: 50%; padding: 40px; }\r\n\r\n    /* 6. Split Content */\r\n    .dji-split { display: flex; flex-wrap: wrap; align-items: center; padding: 80px 20px; gap: 50px; background: #0a0a0a; border-top: 1px solid #1a1a1a; }\r\n    .dji-split-reverse { flex-direction: row-reverse; background: #000; }\r\n    .dji-split-media { flex: 1 1 450px; overflow: hidden; border-radius: 16px; position: relative; }\r\n    .dji-split-media video, .dji-split-media img { width: 100%; display: block; border-radius: 16px; object-fit: cover; }\r\n    .dji-split-text { flex: 1 1 400px; }\r\n    .dji-split-text h4 { color: #10b981; font-size: 16px; margin-bottom: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }\r\n    .dji-split-text h2 { font-size: 32px; font-weight: 900; margin-bottom: 20px; line-height: 1.3; color: #fff; }\r\n    .dji-split-text p { color: #ccc; font-size: 16px; line-height: 1.7; margin-bottom: 20px; }\r\n    \r\n    /* 7. Double Cards */\r\n    .dji-double-cards { padding: 80px 20px; background: #000; border-top: 1px solid #222; }\r\n    .dji-double-cards-title { text-align: center; font-size: 36px; font-weight: 900; margin-bottom: 50px; color: #fff; }\r\n    .dji-dc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }\r\n    .dji-dc-item { background: #111; border-radius: 16px; overflow: hidden; }\r\n    .dji-dc-media video { width: 100%; display: block; }\r\n    .dji-dc-text { padding: 30px; }\r\n    .dji-dc-text h3 { font-size: 22px; font-weight: 800; color: #fff; margin-bottom: 15px; }\r\n    .dji-dc-text p { font-size: 15px; color: #ccc; line-height: 1.6; }\r\n\r\n    /* 8. Video Section */\r\n    .dji-video-sec { padding: 100px 20px; text-align: center; background: #080808; border-top: 1px solid #222; }\r\n    .dji-video-title { font-size: 36px; font-weight: 900; margin-bottom: 40px; color: #fff; }\r\n    .dji-video-wrap { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.6); max-width: 900px; margin: 0 auto; border: 1px solid #333; }\r\n    .dji-video-wrap iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\r\n\r\n    @media (max-width: 768px) {\r\n        .dji-modules-grid, .dji-dc-grid { grid-template-columns: 1fr; }\r\n        .dji-module-card.full-width { grid-column: span 1; flex-direction: column; }\r\n        .dji-module-card.full-width img { width: 100%; border-right: none; border-bottom: 1px solid #222; }\r\n        .dji-module-card.full-width .dji-module-text { width: 100%; padding: 25px; }\r\n        .dji-split { gap: 30px; padding: 60px 20px; }\r\n        .dji-split-text h2 { font-size: 28px; }\r\n        .dji-hero-title { font-size: 36px; }\r\n        .dji-plan-table td.feature-name { padding-left: 10px; width: 35%; }\r\n        .dji-plan-table th, .dji-plan-table td { padding: 12px 10px; font-size: 13px; }\r\n    }\r\n</style>\r\n\r\n<div class=\"dji-wrap\">\r\n\r\n    <div class=\"dji-badge\">\r\n        <div class=\"dji-badge-title\">DJI <span class=\"dji-badge-sub\">AUTHORIZED DEALER</span></div>\r\n        <div class=\"dji-badge-desc\">\r\n            <strong>DJI 공식 파트너 드론박스</strong><br>\r\n            본 온라인 공식 판매점에서 구입하신 제품은 DJI 코리아에서 제공하는 100% 정품입니다.\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-hero-video\">\r\n        <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://www-cdn.djiits.com/dps/dd6b0cb2e687d599861907d779558cdf.jpg\">\r\n            <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/783d28d4-fa8f-4355-b385-7cb83b7dbfe4.mp4\" type=\"video/mp4\">\r\n        </video>\r\n        <div class=\"dji-hero-overlay\">\r\n            <h3 class=\"dji-hero-sub\">플래그십 전천후 다중 센서 페이로드</h3>\r\n            <img src=\"https://www-cdn.djiits.com/dps/8c7f0eec78b169ae05e3c14fb80e5f6d.png\" alt=\"Zenmuse H30 Series\">\r\n            <h1 class=\"dji-hero-title\">Unparalleled Vision, Day or Night</h1>\r\n            <p class=\"dji-hero-desc\">주간 및 야간에도 다재다능한 성능을 발휘하는 압도적인 플래그십 솔루션</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-intro\">\r\n        <h2 class=\"dji-intro-title\">한계를 뛰어넘는 올인원 페이로드</h2>\r\n        <p class=\"dji-intro-desc\">\r\n            전천후, 다중 센서 플래그십 Zenmuse H30 시리즈는 광각 카메라, 줌 카메라, 적외선 열화상 카메라, 레이저 거리측정기, NIR 보조등의 5개 주요 모듈을 통합했습니다. 첨단 인텔리전트 알고리즘을 이용해 지각 및 이미지 기준에 변혁을 가져오며 주간 및 야간 비전의 한계를 뛰어넘습니다. 공공 안전, 전력 점검, 수원 보호, 삼림 관리를 포함하는 다양한 분야에서 완벽하게 적용됩니다.\r\n        </p>\r\n    </div>\r\n\r\n    <div class=\"dji-plan-sec\">\r\n        <h2 class=\"dji-plan-title\">Zenmuse H30 시리즈 라인업 비교</h2>\r\n        <div class=\"dji-table-wrap\">\r\n            <table class=\"dji-plan-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th style=\"width:30%;\">기능 및 센서 구성</th>\r\n                        <th>Zenmuse H30</th>\r\n                        <th class=\"highlight\">Zenmuse H30T (Thermal)</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    <tr><td class=\"feature-name\">40MP 줌 카메라 (최대 400x)</td><td><span class=\"check\">O</span></td><td><span class=\"check\">O</span></td></tr>\r\n                    <tr><td class=\"feature-name\">48MP 광각 카메라</td><td><span class=\"check\">O</span></td><td><span class=\"check\">O</span></td></tr>\r\n                    <tr><td class=\"feature-name\">최대 3000m 레이저 거리측정기</td><td><span class=\"check\">O</span></td><td><span class=\"check\">O</span></td></tr>\r\n                    <tr><td class=\"feature-name\">NIR 보조등 (야간투시용)</td><td><span class=\"check\">O</span></td><td><span class=\"check\">O</span></td></tr>\r\n                    <tr><td class=\"feature-name\">적외선 열화상 카메라 (-20~1600°C)</td><td><span class=\"cross\">X</span></td><td><span class=\"check\">O</span></td></tr>\r\n                    <tr><td class=\"feature-name\">풀 컬러 / 흑백 나이트 비전</td><td><span class=\"check\">O</span></td><td><span class=\"check\">O</span></td></tr>\r\n                    <tr><td class=\"feature-name\">IP54 방진방수 / -20~50°C 작동</td><td><span class=\"check\">O</span></td><td><span class=\"check\">O</span></td></tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-modules-sec\">\r\n        <h2 class=\"dji-modules-title\" style=\"color:#fff;\">5가지 핵심 통합 모듈</h2>\r\n        <div class=\"dji-modules-grid\">\r\n            <div class=\"dji-module-card\">\r\n                <img src=\"https://www-cdn.djiits.com/dps/98d9d9eacee0d221e4ead9d5b9346e86.jpg\" alt=\"줌 카메라\">\r\n                <div class=\"dji-module-text\">\r\n                    <h3>줌 카메라</h3>\r\n                    <p>- 최대 34x 광학 줌 및 400x 디지털 줌<br>- 40MP, 1/1.8\" CMOS 센서<br>- 동영상 해상도: 최대 3840×2160 @30fps</p>\r\n                </div>\r\n            </div>\r\n            <div class=\"dji-module-card\">\r\n                <img src=\"https://www-cdn.djiits.com/dps/20af7876eb0a8fb70f778e2bd6ec544c.jpg\" alt=\"광각 카메라\">\r\n                <div class=\"dji-module-text\">\r\n                    <h3>광각 카메라</h3>\r\n                    <p>- 환산 초점 거리: 24 mm, DFOV: 82.1°<br>- 48MP, 1/1.3\" CMOS 센서<br>- 동영상 해상도: 최대 3840×2160 @30fps</p>\r\n                </div>\r\n            </div>\r\n            <div class=\"dji-module-card\">\r\n                <img src=\"https://www-cdn.djiits.com/dps/5aa28e9e8f2e35f24ffb5ca381eb5479.jpg\" alt=\"레이저 거리측정기\">\r\n                <div class=\"dji-module-text\">\r\n                    <h3>레이저 거리측정기</h3>\r\n                    <p>- 측정 범위: 3~3000 m<br>- 측정 정확도: ≤500m (±0.2m+측정거리×0.15%), &gt;500m (±1.0m)</p>\r\n                </div>\r\n            </div>\r\n            <div class=\"dji-module-card\">\r\n                <img src=\"https://www-cdn.djiits.com/dps/26c82a0e0ecf84b59f0a45ae8df40b96.jpg\" alt=\"NIR 보조등\">\r\n                <div class=\"dji-module-text\">\r\n                    <h3>NIR 보조등</h3>\r\n                    <p>- 파장: 850 nm<br>- FOV: 4.6 ±0.6° (원형)<br>- 조명 범위: 100m 거리에서 약 8m 지름 원 (안전 등급 Class 1)</p>\r\n                </div>\r\n            </div>\r\n            <div class=\"dji-module-card full-width\">\r\n                <img src=\"https://www-cdn.djiits.com/dps/15675302037545e9e7cbf25b342854ac.jpg\" alt=\"적외선 열화상 카메라\">\r\n                <div class=\"dji-module-text\">\r\n                    <h3 style=\"color:#10b981;\">적외선 열화상 카메라 (H30T 전용)</h3>\r\n                    <p>- 환산 초점 거리: 52 mm, DFOV: 45.2°<br>- 비냉각식 산화바나듐(VOx) 마이크로볼로미터<br>- 사진/동영상 해상도: 1280×1024 @30fps<br>- 측정 온도: -20~1600°C 온도 측정 범위 지원 (IR ND 필터 장착 시)</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-split\">\r\n        <div class=\"dji-split-media\">\r\n            <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://www-cdn.djiits.com/dps/0ac91595e5cd52bebeb93724d1cbe2ee.jpg\">\r\n                <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/02902da5-3853-40b7-8bef-dea76e693ec0.mp4\" type=\"video/mp4\">\r\n            </video>\r\n        </div>\r\n        <div class=\"dji-split-text\">\r\n            <h4>Further and Clearer Vision</h4>\r\n            <h2>더 멀리, 더 선명하게<br>최대 400배 디지털 줌</h2>\r\n            <p>Zenmuse H30 시리즈는 40MP 고해상도 줌 카메라를 탑재하여 최대 34x 광학 줌과 무려 400x 디지털 줌을 지원합니다. 이전 세대보다 피사체를 더 멀리서 관찰하고, 미세한 디테일까지 정확하게 포착합니다.</p>\r\n            <p>DJI의 최신 이미지 안정화 알고리즘 덕분에 망원 환경에서도 영상 흔들림을 효과적으로 줄여 전선 점검 등의 정밀 작업에 탁월합니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-split dji-split-reverse\">\r\n        <div class=\"dji-split-media\">\r\n            <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://www-cdn.djiits.com/dps/2f52774268d4aa32b2f86223650d7557.jpg\">\r\n                <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/879f5df0-38c4-48ee-8d0f-da9bd4c4ff9d.mp4\" type=\"video/mp4\">\r\n            </video>\r\n        </div>\r\n        <div class=\"dji-split-text\">\r\n            <h4>Enhanced Night Vision</h4>\r\n            <h2>주야간을 가리지 않는<br>강화된 나이트 비전</h2>\r\n            <p><strong>풀 컬러 나이트 비전:</strong> 저조도 환경에서 줌/광각 카메라가 야간 촬영 모드로 전환되어 라이브 뷰와 녹화 품질을 높입니다.</p>\r\n            <p><strong>흑백 나이트 비전 &amp; NIR:</strong> 줌 카메라는 IR 필터를 제거해 그레이 스케일로 전환, 명암비를 높여 피사체 파악을 돕습니다. NIR 보조등을 켜면 야간 수색 구조 및 안전 관찰의 효율이 극대화됩니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-split\">\r\n        <div class=\"dji-split-media\">\r\n            <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://www-cdn.djiits.com/dps/d056f6e0dde0db6ba6c3d33189003057.jpg\">\r\n                <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/a2f2018c-0736-4365-95ae-3461570a2b00.mp4\" type=\"video/mp4\">\r\n            </video>\r\n        </div>\r\n        <div class=\"dji-split-text\">\r\n            <h4>More Powerful Infrared Performance</h4>\r\n            <h2>4배 향상된 해상도<br>압도적 열화상 카메라 (H30T)</h2>\r\n            <p>이전 세대 대비 4배 커진 1280×1024 해상도의 열화상 카메라를 탑재했습니다. 새로운 \'고해상도 모드\'는 온도 차가 작은 대상(사람, 동물 등)을 식별하는 데 매우 유용합니다.</p>\r\n            <p>IR ND 필터를 장착하면 최대 1600°C의 고온까지 측정 가능해져 대형 화재 및 고온 현장에서의 구조 및 진압 효율을 비약적으로 높여줍니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-double-cards\">\r\n        <h2 class=\"dji-double-cards-title\">더 스마트한 다중 시나리오 작업</h2>\r\n        <div class=\"dji-dc-grid\">\r\n            <div class=\"dji-dc-item\">\r\n                <div class=\"dji-dc-media\">\r\n                    <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://www-cdn.djiits.com/dps/ae18c7787974b8c8be2f7bc5ff9d5f10.jpg\">\r\n                        <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/8481c2ad-6434-4029-a1da-682c8fad8376.mp4\" type=\"video/mp4\">\r\n                    </video>\r\n                </div>\r\n                <div class=\"dji-dc-text\">\r\n                    <h3>스마트 촬영 (Smart Capture)</h3>\r\n                    <p>주변 조도와 다이내믹 레인지를 자동 평가해 밝고 어두운 부분의 트랜지션을 자연스럽게 처리하여 어떠한 악조건에서도 선명한 사진을 출력합니다.</p>\r\n                </div>\r\n            </div>\r\n            <div class=\"dji-dc-item\">\r\n                <div class=\"dji-dc-media\">\r\n                    <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://www-cdn.djiits.com/dps/2a880bf23dc7127a97768038aa8d5147.jpg\">\r\n                        <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/08273f31-50c9-4a82-af4d-2d200ecec6de.mp4\" type=\"video/mp4\">\r\n                    </video>\r\n                </div>\r\n                <div class=\"dji-dc-text\">\r\n                    <h3>전자 디헤이즈 (Dehazing)</h3>\r\n                    <p>스모그나 안개, 습도가 높은 대기 환경에서 이미지 선명도를 끌어올려 줍니다. 환경에 따라 높고 낮은 디헤이즈 레벨을 선택할 수 있습니다.</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-split dji-split-reverse\">\r\n        <div class=\"dji-split-media\">\r\n            <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://www-cdn.djiits.com/dps/79e5bfbbd28e2d1e66c206d7eb9d56c3.jpg\">\r\n                <source src=\"https://www-cdn.djiits.com/reactor/assets/_next/static/videos/1bf58c07-2093-4997-b970-99ab6e62b43a.mp4\" type=\"video/mp4\">\r\n            </video>\r\n        </div>\r\n        <div class=\"dji-split-text\">\r\n            <h4>Reliability &amp; Environment</h4>\r\n            <h2>극강의 보안성과 환경 적응성</h2>\r\n            <p><strong>정보 동기화 및 보안:</strong> 정식 촬영 10~30초 전부터 저장하는 Pre-REC 기능과 AES-256 전송 암호화, 원클릭 로그 삭제 기능을 지원합니다. DJI FlightHub 2와 클라우드 동기화로 완벽한 지상/공중 협업이 가능합니다.</p>\r\n            <p><strong>강력한 내구성:</strong> IP54 방진방수 등급을 획득하였으며, 영하 20°C부터 영상 50°C에 이르는 가혹한 온도 환경에서도 안정적으로 비행 및 임무 수행이 가능합니다.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-video-sec\">\r\n        <h2 class=\"dji-video-title\">DJI Zenmuse H30 Series 공식 소개 영상</h2>\r\n        <div class=\"dji-video-wrap\">\r\n            <iframe src=\"https://www.youtube.com/embed/a_ZEPqs_L-Y\" allowfullscreen=\"\"></iframe>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"dji-specs-sec\">\r\n        <h2 class=\"dji-plan-title\">상세 제원 비교 (Zenmuse H30 vs H30T)</h2>\r\n        <div class=\"dji-table-wrap\">\r\n            <table class=\"dji-plan-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th style=\"width:24%;\">스펙 분류</th>\r\n                        <th style=\"width:38%;\">Zenmuse H30</th>\r\n                        <th style=\"width:38%;\" class=\"highlight\">Zenmuse H30T (Thermal)</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    <tr><th colspan=\"3\" class=\"section-head\">일반 사양</th></tr>\r\n                    <tr><td class=\"feature-name\">방진방수 등급</td><td>IP54 (IEC60529 기준)</td><td>IP54 (IEC60529 기준)</td></tr>\r\n                    <tr><td class=\"feature-name\">작동 온도</td><td>-20°C ~ 50°C</td><td>-20°C ~ 50°C</td></tr>\r\n                    <tr><td class=\"feature-name\">무게 (약)</td><td>920g</td><td>920g</td></tr>\r\n\r\n                    <tr><th colspan=\"3\" class=\"section-head\">줌 카메라</th></tr>\r\n                    <tr><td class=\"feature-name\">센서</td><td>1/1.8\" CMOS (40 MP)</td><td>1/1.8\" CMOS (40 MP)</td></tr>\r\n                    <tr><td class=\"feature-name\">줌 비율</td><td>최대 34x 광학 / 400x 디지털</td><td>최대 34x 광학 / 400x 디지털</td></tr>\r\n                    <tr><td class=\"feature-name\">동영상 해상도</td><td>3840×2160 @30fps</td><td>3840×2160 @30fps</td></tr>\r\n\r\n                    <tr><th colspan=\"3\" class=\"section-head\">광각 카메라</th></tr>\r\n                    <tr><td class=\"feature-name\">센서</td><td>1/1.3\" CMOS (48 MP)</td><td>1/1.3\" CMOS (48 MP)</td></tr>\r\n                    <tr><td class=\"feature-name\">렌즈</td><td>DFOV: 82.1°, 24mm</td><td>DFOV: 82.1°, 24mm</td></tr>\r\n                    <tr><td class=\"feature-name\">동영상 해상도</td><td>3840×2160 @30fps</td><td>3840×2160 @30fps</td></tr>\r\n\r\n                    <tr><th colspan=\"3\" class=\"section-head\">적외선 열화상 카메라</th></tr>\r\n                    <tr><td class=\"feature-name\">센서 및 해상도</td><td><span class=\"cross\">미지원</span></td><td>비냉각식 VOx / 1280×1024 @30fps</td></tr>\r\n                    <tr><td class=\"feature-name\">렌즈</td><td><span class=\"cross\">미지원</span></td><td>DFOV: 45.2°, 52mm</td></tr>\r\n                    <tr><td class=\"feature-name\">온도 측정 범위</td><td><span class=\"cross\">미지원</span></td><td>-20°C ~ 1600°C (IR ND 필터 적용 시)</td></tr>\r\n\r\n                    <tr><th colspan=\"3\" class=\"section-head\">레이저 거리측정기 (LRF)</th></tr>\r\n                    <tr><td class=\"feature-name\">측정 범위</td><td>3m ~ 3000m</td><td>3m ~ 3000m</td></tr>\r\n                    <tr><td class=\"feature-name\">측정 정확도</td><td>≤500m: ±(0.2m + 0.15%)<br>&gt;500m: ±1.0m</td><td>≤500m: ±(0.2m + 0.15%)<br>&gt;500m: ±1.0m</td></tr>\r\n\r\n                    <tr><th colspan=\"3\" class=\"section-head\">NIR 보조등</th></tr>\r\n                    <tr><td class=\"feature-name\">파장 및 안전 등급</td><td>850 nm / Class 1</td><td>850 nm / Class 1</td></tr>\r\n                    <tr><td class=\"feature-name\">조명 범위 (100m 기준)</td><td>약 8m 지름 원</td><td>약 8m 지름 원</td></tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n</div>]]></goodsDescription>
