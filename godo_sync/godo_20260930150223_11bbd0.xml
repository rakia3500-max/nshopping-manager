osition: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }\r\n\r\n        /* AI 텍스트 섹션 공통 스타일 */\r\n        .ai-section { padding: 50px 20px; background-color: #1a1a1a; border-top: 1px solid #333; border-bottom: 1px solid #333; }\r\n        .ai-title { font-size: 24px; font-weight: 700; color: #ffffff; margin-bottom: 30px; border-left: 4px solid #0057ff; padding-left: 15px; }\r\n        \r\n        /* AI-1 추천 카드 */\r\n        .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }\r\n        .target-card { background: #222; padding: 25px; border-radius: 12px; border: 1px solid #333; }\r\n        .target-card h4 { margin: 0 0 15px 0; color: #0057ff; font-size: 18px; display: flex; align-items: center; gap: 8px; font-weight: 700; }\r\n        .target-card p { font-size: 15px; color: #eeeeee; margin: 0; word-break: keep-all; line-height: 1.6; }\r\n\r\n        /* AI-2 비교표 */\r\n        .compare-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 15px; text-align: center; color: #ffffff; }\r\n        .compare-table th, .compare-table td { padding: 16px; border: 1px solid #444; }\r\n        .compare-table th { background-color: #2a2a2a; color: #ffffff; font-weight: 700; }\r\n        .compare-table .highlight { color: #66a3ff; font-weight: 700; background-color: rgba(0, 87, 255, 0.1); }\r\n        .compare-summary { font-size: 15px; color: #eeeeee; background: #222; padding: 22px; border-radius: 8px; line-height: 1.7; }\r\n\r\n        /* AI-3 & AI-4 FAQ/가이드 */\r\n        .faq-item { background: #222; margin-bottom: 10px; border-radius: 8px; border: 1px solid #333; }\r\n        .faq-q { padding: 20px; font-size: 16px; font-weight: 700; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: #ffffff; }\r\n        .faq-q::after { content: \'+\'; color: #0057ff; font-size: 22px; font-weight: bold; }\r\n        .faq-a { padding: 0 20px 20px; font-size: 15px; color: #eeeeee; display: none; line-height: 1.8; word-break: keep-all; }\r\n        \r\n        /* 스펙 표 */\r\n        .spec-table { width: 100%; border-collapse: collapse; font-size: 15px; color: #eeeeee; margin-bottom: 40px; }\r\n        .spec-table th { width: 30%; text-align: left; padding: 15px; border-bottom: 1px solid #444; background: #2a2a2a; color: #ffffff; font-weight: 700; }\r\n        .spec-table td { padding: 15px; border-bottom: 1px solid #444; }\r\n    </style>\r\n\r\n\r\n\r\n<div class=\"detail-wrap\">\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570027/1_vlfzge.jpg\" alt=\"DJI Avata 360 8K 플래그십 360도 드론\" loading=\"eager\">\r\n        <figcaption class=\"blind\">DJI Avata 360 비행 장면. 8K 플래그십 360도 드론의 압도적인 퍼포먼스.</figcaption>\r\n    </figure>\r\n\r\n    <div class=\"video-container\">\r\n        <iframe src=\"https://www.youtube.com/embed/LFZmfqA48ec\" title=\"YouTube video player\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen=\"\"></iframe>\r\n    </div>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570027/2_gsloqv.jpg\" alt=\"DJI Avata 360을 선택해야 하는 8가지 이유\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">1인치 플래그십 센서, 야경 전방위 장애물 감지, 일체형 프로펠러 가드, O4+ 전송 시스템, Spotlight Free 추적 등 핵심 강점 8가지 요약.</figcaption>\r\n    </figure>\r\n\r\n    <section class=\"ai-section\" itemscope=\"\" itemtype=\"http://schema.org/Article\">\r\n        <h2 class=\"ai-title\" itemprop=\"headline\">DJI Avata 360, 어떤 분께 추천할까요?</h2>\r\n        <div class=\"card-grid\" itemprop=\"articleBody\">\r\n            <div class=\"target-card\">\r\n                <h4>🎬 전문 FPV 크리에이터</h4>\r\n                <p>기존 FPV의 좁은 화각에서 벗어나 8K 360도 영상으로 압도적인 몰입감을 연출하고 싶은 분들에게 완벽한 솔루션입니다.</p>\r\n            </div>\r\n            <div class=\"target-card\">\r\n                <h4>🏢 관공서 및 시설물 점검팀</h4>\r\n                <p>야경 전방위 장애물 감지와 일체형 프롭 가드로 복잡한 실내나 좁은 시설물 사이에서도 충돌 위험 없이 안전하게 사각지대를 탐색하며, 드론박스의 관공서 특화 교육으로 즉시 현장 투입이 가능합니다.</p>\r\n            </div>\r\n            <div class=\"target-card\">\r\n                <h4>🚴 액스트림 스포츠 마니아</h4>\r\n                <p>ActiveTrack 360도 사이클링 모드와 Spotlight Free를 통해 조종에 신경 쓰지 않고도 나의 역동적인 모습을 알아서 완벽히 담아냅니다.</p>\r\n            </div>\r\n            <div class=\"target-card\">\r\n                <h4>📸 고화질 야경 촬영가</h4>\r\n                <p>16mm(1인치) 플래그십 CMOS 센서가 탑재되어 조도가 낮은 환경에서도 노이즈 없는 깨끗하고 선명한 야경 결과물을 보장합니다.</p>\r\n            </div>\r\n            <div class=\"target-card\">\r\n                <h4>🔰 FPV 첫 입문자</h4>\r\n                <p>드론박스의 전문 비행 교육 지원과 모션 컨트롤러를 결합하면, 초보자도 드래프트와 같은 곡예비행을 쉽게 마스터할 수 있습니다.</p>\r\n            </div>\r\n            <div class=\"target-card\">\r\n                <h4>🎨 1인 미디어 및 편집자</h4>\r\n                <p>한 번 비행으로 360도 전체를 녹화한 뒤, 앱에서 원탭 리프레이밍으로 여러 구도의 클립을 무한대로 뽑아낼 수 있어 편집 시간이 획기적으로 단축됩니다.</p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570028/3_hmxcvz.jpg\" alt=\"16mm 1인치 플래그십 이미징 센서와 8K 360도 영상\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">1인치 센서(2.4um 픽셀, f/1.9 조리개), 8K 60fps HDR 영상 지원, 120MP 360도 사진 및 단일 렌즈 모드 전환 가능.</figcaption>\r\n    </figure>\r\n\r\n    <section class=\"ai-section\" itemscope=\"\" itemtype=\"http://schema.org/Article\">\r\n        <h2 class=\"ai-title\" itemprop=\"headline\">DJI Avata 360 vs Avata 2 핵심 비교</h2>\r\n        <table class=\"compare-table\" itemprop=\"articleBody\">\r\n            <thead>\r\n                <tr>\r\n                    <th>비교 항목</th>\r\n                    <th>DJI Avata 2</th>\r\n                    <th class=\"highlight\">DJI Avata 360 (New)</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                <tr>\r\n                    <td>카메라 시야</td>\r\n                    <td>155° 초광각</td>\r\n                    <td class=\"highlight\">360° 전방위 + 단일렌즈 전환</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>이미지 센서</td>\r\n                    <td>1/1.3인치 CMOS</td>\r\n                    <td class=\"highlight\">1인치 플래그십 CMOS</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>최대 해상도</td>\r\n                    <td>4K/60fps HDR</td>\r\n                    <td class=\"highlight\">8K/60fps HDR 360°</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>장애물 감지</td>\r\n                    <td>하향 및 후방</td>\r\n                    <td class=\"highlight\">야경 전방위 (360° 모드)</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>최대 전송 거리</td>\r\n                    <td>13 km (O4)</td>\r\n                    <td class=\"highlight\">20 km (O4+)</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>추적 기능</td>\r\n                    <td>지원 안함</td>\r\n                    <td class=\"highlight\">ActiveTrack 360° &amp; Spotlight Free</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>사진 해상도</td>\r\n                    <td>12 MP</td>\r\n                    <td class=\"highlight\">120 MP (360° 사진)</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>내장 스토리지</td>\r\n                    <td>46 GB</td>\r\n                    <td class=\"highlight\">42 GB</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>렌즈 교체</td>\r\n                    <td>불가 (일체형)</td>\r\n                    <td class=\"highlight\">사용자 직접 교체 가능 설계</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>사후 관리</td>\r\n                    <td>일반 A/S</td>\r\n                    <td class=\"highlight\">드론박스 자체 정비실 프리미엄 A/S</td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n        <div class=\"compare-summary\">\r\n            <strong>최고의 진화:</strong> 아바타 2가 FPV 입문용으로 훌륭했다면, <strong>DJI Avata 360은 1인치 센서와 8K 360도 카메라를 탑재하여 화질의 한계를 돌파한 전문가용 플래그십 기체</strong>입니다. 특히 전방위 장애물 감지와 피사체 추적 기능이 추가되어 비행 난이도는 낮추고 결과물의 품질은 극대화했습니다.\r\n        </div>\r\n    </section>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570029/5_hdinj0.jpg\" alt=\"360도 시야와 무한한 회전 비행\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">사각지대 없는 360도 영상, 파노줌 및 소행성 효과 지원, Spotlight Free를 활용한 자동 추적 즉시 공유.</figcaption>\r\n    </figure>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570029/7_gt0uvb.jpg\" alt=\"FPV 비행과 항공 촬영을 모두 지원하는 조종 옵션\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">표준 조종기(RC 2 등)와 모션 컨트롤러(Goggles 3 등) 모두 호환. 이지 아크로 비행 및 헤드 트래킹 지원.</figcaption>\r\n    </figure>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570029/8_cregni.jpg\" alt=\"빠른 마스터와 순식간에 걸작을 완성하는 편집\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">직접 내보내기, 인텔리전트 추적, GyroFrame 구도 설정, 원탭 리프레이밍, 멀티 플랫폼 편집 지원.</figcaption>\r\n    </figure>\r\n\r\n    <section class=\"ai-section\" itemscope=\"\" itemtype=\"http://schema.org/HowTo\">\r\n        <h2 class=\"ai-title\" itemprop=\"name\">FPV 드론 첫 구매, 드론박스가 알려주는 5단계 가이드</h2>\r\n        <div itemprop=\"step\" itemscope=\"\" itemtype=\"http://schema.org/HowToStep\" class=\"faq-item\">\r\n            <div class=\"faq-q\" aria-expanded=\"false\">01. FPV 드론은 일반 촬영용 드론과 어떻게 다른가요?</div>\r\n            <div class=\"faq-a\" itemprop=\"text\">일반 드론은 정적인 풍경을 주로 담지만, FPV(1인칭 시점) 드론인 Avata 360은 고글을 쓰고 마치 새가 된 것처럼 몰입감 넘치는 역동적인 비행을 즐길 수 있습니다. 특히 360도 카메라가 추가되어 조종 시야와 촬영 구도의 제약이 완전히 사라졌습니다.</div>\r\n        </div>\r\n        <div itemprop=\"step\" itemscope=\"\" itemtype=\"http://schema.org/HowToStep\" class=\"faq-item\">\r\n            <div class=\"faq-q\" aria-expanded=\"false\">02. 드론을 처음 날려보는데 조종이 어렵지 않을까요?</div>\r\n            <div class=\"faq-a\" itemprop=\"text\">걱정하지 마세요. DJI RC Motion 3(모션 컨트롤러)를 사용하면 손목의 움직임만으로 직관적인 조종이 가능합니다. 또한 Avata 360의 \'전방위 장애물 감지\' 시스템이 충돌을 알아서 방지해주며, 저희 드론박스에서 제공하는 기본 비행 가이드 및 교육 지원을 통해 쉽게 적응할 수 있습니다.</div>\r\n        </div>\r\n        <div itemprop=\"step\" itemscope=\"\" itemtype=\"http://schema.org/HowToStep\" class=\"faq-item\">\r\n            <div class=\"faq-q\" aria-expanded=\"false\">03. 어떤 패키지를 선택하는 것이 가장 경제적인가요?</div>\r\n            <div class=\"faq-a\" itemprop=\"text\">만약 기존에 DJI RC 2 조종기를 가지고 계시다면 기체만 포함된 단품이나 \'DJI RC 2 포함 콤보\'를 추천합니다. 완벽한 FPV 비행을 처음 경험하시려면 고글과 모션 컨트롤러가 포함된 \'모션 플라이 모어 콤보\'가 가장 합리적인 선택입니다.</div>\r\n        </div>\r\n        <div itemprop=\"step\" itemscope=\"\" itemtype=\"http://schema.org/HowToStep\" class=\"faq-item\">\r\n            <div class=\"faq-q\" aria-expanded=\"false\">04. 촬영한 영상을 편집하는 게 복잡하지 않나요?</div>\r\n            <div class=\"faq-a\" itemprop=\"text\">Avata 360은 스마트폰 DJI Fly 앱과 연동하여 \'원탭 리프레이밍\'과 \'인텔리전트 추적\' 기능을 제공합니다. 복잡한 PC 프로그램 없이 터치 몇 번만으로 인물을 화면 중앙에 고정하거나, 시네마틱한 360도 영상을 바로 관공서 홍보용이나 개인 SNS에 업로드할 수 있습니다.</div>\r\n        </div>\r\n        <div itemprop=\"step\" itemscope=\"\" itemtype=\"http://schema.org/HowToStep\" class=\"faq-item\">\r\n            <div class=\"faq-q\" aria-expanded=\"false\">05. 비행 중 파손되면 수리비가 많이 나오지 않나요?</div>\r\n            <div class=\"faq-a\" itemprop=\"text\">아바타 360은 기본적으로 튼튼한 일체형 프롭 가드가 있어 충격에 강합니다. 전면 렌즈 파손 시 직접 쉽게 교체할 수 있는 구조이며, 기체 이상 발생 시 드론박스의 전문 정비실을 통해 신속하고 신뢰할 수 있는 사후관리(A/S)를 약속드립니다.</div>\r\n        </div>\r\n    </section>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570027/6_ywauxi.jpg\" alt=\"야경 전방위 장애물 감지와 ActiveTrack 360도\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">전방 LiDAR 탑재로 360도 모드에서 야경 전방위 장애물 감지, 일체형 프로펠러 가드, 사이클링 모드 등 ActiveTrack 지원.</figcaption>\r\n    </figure>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570029/4_kbj3re.jpg\" alt=\"O4+ 20km 동영상 전송 시스템\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">전파 간섭 방지 성능 향상, 1080p/60fps 고화질 전송, 컬러 비전 어시스트를 통한 주변 환경 파악.</figcaption>\r\n    </figure>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570031/9_bdcsfb.jpg\" alt=\"Avata 360의 세심한 디테일과 배터리 성능\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">사용자 직접 교체 가능한 전면 렌즈, 42GB 내부 저장 장치, Wi-Fi 6 고속 전송(100MB/s), 최대 23분 비행시간.</figcaption>\r\n    </figure>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570029/11_kg0wzr.jpg\" alt=\"DJI Avata 360 패키지별 구성품 안내\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">DJI Avata 360 단품, 플라이 모어 콤보(RC2), 모션 플라이 모어 콤보(Motion 3, Goggles N3) 패키지 간 배터리, 조종기 등 포함 내역 표.</figcaption>\r\n    </figure>\r\n\r\n    <section class=\"ai-section\" itemscope=\"\" itemtype=\"http://schema.org/FAQPage\">\r\n        <h2 class=\"ai-title\">드론박스 고객센터(A/S) FAQ</h2>\r\n        \r\n        <div itemprop=\"mainEntity\" itemscope=\"\" itemtype=\"http://schema.org/Question\" class=\"faq-item\">\r\n            <div class=\"faq-q\" aria-expanded=\"false\" itemprop=\"name\">드론을 구매하면 기체 등록을 해야 하나요?</div>\r\n            <div class=\"faq-a\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"http://schema.org/Answer\">\r\n                <span itemprop=\"text\">DJI Avata 360은 최대 이륙 중량이 250g을 초과하는 기체이므로 항공안전법에 따라 드론원스톱 민원포털을 통한 \'기체 신고\'가 필수입니다. 드론박스에서 기업 및 관공서 구매 시 원활한 등록 절차 안내를 지원해 드립니다.</span>\r\n            </div>\r\n        </div>\r\n        <div itemprop=\"mainEntity\" itemscope=\"\" itemtype=\"http://schema.org/Question\" class=\"faq-item\">\r\n            <div class=\"faq-q\" aria-expanded=\"false\" itemprop=\"name\">기업이나 관공서 세금계산서 발행 및 후불 결제가 가능한가요?</div>\r\n            <div class=\"faq-a\" itemscope=\"\" itemprop=\"acceptedAnswer\" itemtype=\"http://schema.org/Answer\">\r\n                <span itemprop=\"text\">네, 드론박스는 B2B 및 B2G 전문 기업입니다. 세금계산서 정식 발행은 물론, 관공서 및 군부대의 경우 예산 집행 일정에 맞춘 견적서 제공 및 결제 시스템을 완벽하게 지원합니다.</span>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <figure class=\"img-box\">\r\n        <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1774570029/10_eniunt.jpg\" alt=\"DJI Avata 360 필수 액세서리\" loading=\"lazy\">\r\n        <figcaption class=\"blind\">교체 렌즈, 렌즈 교체 툴 키트, 충전 허브(3개 동시 충전), 인텔리전트 플라이트 배터리, 프로펠러 등 액세서리 안내.</figcaption>\r\n    </figure>\r\n\r\n    <section class=\"ai-section\">\r\n        <h2 class=\"ai-title\">DJI Avata 360 주요 스펙</h2>\r\n        <table class=\"spec-table\">\r\n            <tbody>\r\n                <tr><th><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">센서 및 화질</span></th><td><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">16mm(1\") 플래그십 CMOS / 8K 60fps HDR / 120MP 360° 사진</span></td></tr><tr><th><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">장애물 감지</span></th><td><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">전방 LiDAR 탑재 / 360° 모드 야경 전방위 감지 지원</span></td></tr><tr><th><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">최대 비행시간</span></th><td><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">약 23분 (테스트 환경 기준)</span></td></tr><tr><th><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">동영상 전송</span></th><td><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">DJI O4+ (최대 20km, FCC 기준) / 1080p 60fps 전송</span></td></tr><tr><th><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">저장 장치</span></th><td><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">42GB 내부 스토리지 내장 / Wi-Fi 6 고속 전송 (100MB/s)</span></td></tr><tr><th><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">호환 기기</span></th><td><span style=\"color: rgb(255, 255, 255); font-size: 11pt;\">DJI Goggles 3, Goggles N3, RC Motion 3, RC 2, FPV 조종기 3 등</span></td></tr>\r\n            </tbody>\r\n        </table>\r\n        <p style=\"color: #eeeeee; font-size: 13px;\">* 상기 스펙 및 비행 시간은 테스트 환경에 따라 실제와 다를 수 있으며, 비행 전 항상 현지 법률 및 규정을 준수하십시오. 드론박스의 프리미엄 케어를 통해 더욱 안전하게 운용하세요.</p>\r\n    </section>\r\n\r\n</div>\r\n\r\n<script>\r\n    // FAQ 아코디언 동작 스크립트\r\n    document.querySelectorAll(\'.faq-q\').forEach(item => {\r\n        item.addEventListener(\'click\', event => {\r\n            const answer = item.nextElementSibling;\r\n            const isExpanded = item.getAttribute(\'aria-expanded\') === \'true\';\r\n            \r\n            // 다른 아코디언 닫기\r\n            document.querySelectorAll(\'.faq-a\').forEach(a => a.style.display = \'none\');\r\n            document.querySelectorAll(\'.faq-q\').forEach(q => q.setAttribute(\'aria-expanded\', \'false\'));\r\n            \r\n            // 현재 클릭한 항목 토글\r\n            if (!isExpanded) {\r\n                answer.style.display = \'block\';\r\n                item.setAttribute(\'aria-expanded\', \'true\');\r\n            }\r\n        });\r\n    });\r\n</script>]]></goodsDescription>
