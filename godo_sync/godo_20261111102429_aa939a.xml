<style>\r\n    /* DJI Premium Dynamic Theme - GodoMall Version (Merged) */\r\n    .dji-wrap { \r\n        width: 100%;\r\n        max-width: 1000px; /* 전체 최대 폭 고정 */\r\n        margin: 0 auto; \r\n        background-color: #000000; \r\n        color: #ffffff; \r\n        font-family: \'Pretendard\', \'Malgun Gothic\', sans-serif; \r\n        word-break: keep-all; \r\n        line-height: 1.6;\r\n        overflow-x: hidden;\r\n    }\r\n\r\n    /* 1. Trust Badge */\r\n    .dji-badge { \r\n        background: #111111; \r\n        border-bottom: 1px solid #333333; \r\n        padding: 25px 20px; \r\n        display: flex; \r\n        align-items: center; \r\n        justify-content: center; \r\n        flex-wrap: wrap; \r\n        gap: 20px; \r\n    }\r\n    .dji-badge-title { font-size: 30px; font-weight: 900; letter-spacing: -1px; }\r\n    .dji-badge-sub { font-size: 16px; font-weight: 600; color: #888888; vertical-align: middle; margin-left: 8px; }\r\n    .dji-badge-desc { color: #bbbbbb; font-size: 14px; line-height: 1.5; max-width: 600px; }\r\n    .dji-badge-desc strong { color: #ffffff; font-size: 16px; }\r\n\r\n    /* 2. Hero Video Section (프리미엄 배경 영상) */\r\n    .dji-hero-video {\r\n        position: relative;\r\n        width: 100%;\r\n        height: 80vh;\r\n        min-height: 600px;\r\n        overflow: hidden;\r\n        background-color: #111;\r\n    }\r\n    .dji-hero-video video {\r\n        width: 100%;\r\n        height: 100%;\r\n        object-fit: cover;\r\n        opacity: 0.7;\r\n    }\r\n    .dji-hero-overlay {\r\n        position: absolute;\r\n        top: 0; left: 0; width: 100%; height: 100%;\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: center;\r\n        align-items: center;\r\n        background: linear-gradient(to top, #000000 0%, transparent 50%);\r\n        text-align: center;\r\n        padding: 0 20px;\r\n        animation: fadeInUp 1.5s ease-out forwards;\r\n    }\r\n    .dji-hero-title { font-size: 56px; font-weight: 900; letter-spacing: -2px; margin-bottom: 10px; text-shadow: 0 4px 20px rgba(0,0,0,0.8); }\r\n    .dji-hero-sub { font-size: 24px; font-weight: 600; color: #10b981; letter-spacing: 1px; margin-bottom: 30px; }\r\n\r\n    /* 3. Title & Intro */\r\n    .dji-intro { padding: 80px 20px 40px 20px; text-align: center; }\r\n    .dji-intro-sub { color: #10b981; font-size: 18px; font-weight: 700; margin-bottom: 10px; letter-spacing: 1px; }\r\n    .dji-intro-title { font-size: 42px; font-weight: 900; margin-bottom: 20px; letter-spacing: -1px; }\r\n    .dji-intro-desc { color: #aaaaaa; font-size: 17px; max-width: 700px; margin: 0 auto; }\r\n\r\n    /* 4. Core Features Grid (프리미엄 호버 애니메이션 적용) */\r\n    .dji-features { \r\n        display: grid; \r\n        grid-template-columns: repeat(4, 1fr); \r\n        gap: 20px; \r\n        padding: 0 20px 80px 20px; \r\n    }\r\n    .dji-feature-card { \r\n        background: #141414; \r\n        padding: 40px 20px; \r\n        border-radius: 12px; \r\n        border: 1px solid #2a2a2a; \r\n        text-align: center; \r\n        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);\r\n        box-shadow: 0 10px 30px rgba(0,0,0,0.5);\r\n    }\r\n    .dji-feature-card:hover { \r\n        transform: translateY(-15px); \r\n        border-color: #10b981; \r\n        box-shadow: 0 20px 40px rgba(16, 185, 129, 0.15);\r\n        background: #1a1a1a;\r\n    }\r\n    .dji-feature-icon { font-size: 38px; margin-bottom: 20px; }\r\n    .dji-feature-title { font-size: 19px; font-weight: 800; margin-bottom: 12px; color: #ffffff; }\r\n    .dji-feature-desc { color: #999999; font-size: 15px; margin: 0; }\r\n\r\n    /* 5. Split Content (좌우 분할 설명 영역) */\r\n    .dji-split {\r\n        display: flex;\r\n        flex-wrap: wrap;\r\n        align-items: center;\r\n        padding: 80px 20px;\r\n        gap: 50px;\r\n        border-top: 1px solid #222222;\r\n    }\r\n    .dji-split-img { flex: 1 1 400px; overflow: hidden; border-radius