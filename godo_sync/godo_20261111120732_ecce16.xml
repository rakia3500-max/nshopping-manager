<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<style>\r\n    /* DJI NEO 2 Light Clean Theme */\r\n    .neo2-wrapper {\r\n        width: 100%; \r\n        max-width: 100%; \r\n        margin: 0 auto;\r\n        background-color: #ffffff; /* 화이트 배경 */\r\n        color: #1d1d1f; /* 진한 다크 그레이 텍스트 */\r\n        font-family: \'Pretendard\', \'Malgun Gothic\', sans-serif;\r\n        line-height: 1.6;\r\n        word-break: keep-all;\r\n        box-sizing: border-box; \r\n    }\r\n\r\n    /* 공통 섹션 스타일 */\r\n    .neo2-section {\r\n        padding: 60px 20px; \r\n        border-bottom: 1px solid #f0f0f0; /* 연한 구분선 */\r\n        max-width: 1000px; \r\n        margin: 0 auto; \r\n        text-align: center;\r\n    }\r\n\r\n    /* 텍스트 스타일 */\r\n    .neo2-highlight { color: #007AFF; } /* DJI Blue */\r\n    .neo2-green { color: #7CB342; } /* 이미지의 그린 포인트 컬러 */\r\n    \r\n    .neo2-title {\r\n        font-size: 36px;\r\n        font-weight: 800;\r\n        margin-bottom: 15px;\r\n        letter-spacing: -1px;\r\n        line-height: 1.3;\r\n        color: #000;\r\n    }\r\n    \r\n    .neo2-subtitle {\r\n        font-size: 18px;\r\n        font-weight: 700;\r\n        margin-bottom: 10px;\r\n        color: #007AFF;\r\n        text-transform: uppercase;\r\n        letter-spacing: 1px;\r\n    }\r\n\r\n    .neo2-desc {\r\n        font-size: 17px;\r\n        color: #666;\r\n        margin-bottom: 30px;\r\n        max-width: 800px;\r\n        margin-left: auto;\r\n        margin-right: auto;\r\n    }\r\n\r\n    /* 유튜브 반응형 컨테이너 */\r\n    .neo2-video-container {\r\n        position: relative;\r\n        padding-bottom: 56.25%; \r\n        height: 0;\r\n        overflow: hidden;\r\n        max-width: 100%;\r\n        background: #000;\r\n        border-radius: 16px;\r\n        margin-top: 30px;\r\n        box-shadow: 0 10px 30px rgba(0,0,0,0.1);\r\n    }\r\n    .neo2-video-container iframe {\r\n        position: absolute;\r\n        top: 0;\r\n        left: 0;\r\n        width: 100%;\r\n        height: 100%;\r\n        border: 0;\r\n    }\r\n\r\n    /* 이미지 스타일 */\r\n    .neo2-full-img {\r\n        width: 100%;\r\n        height: auto;\r\n        border-radius: 16px;\r\n        margin-top: 20px;\r\n        display: block;\r\n        /* 그림자 제거하여 깔끔하게 (이미지 자체 배경이 흰색인 경우 자연스럽게) */\r\n    }\r\n\r\n    /* 구성품 표 스타일 (4단 구성) */\r\n    .neo2-table-wrapper {\r\n        overflow-x: auto; /* 모바일 가로 스크롤 */\r\n        margin-top: 30px;\r\n        border-radius: 12px;\r\n        border: 1px solid #e0e0e0;\r\n    }\r\n\r\n    .neo2-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 13px;\r\n        background: #fff;\r\n        min-width: 600px; /* 표 깨짐 방지 최소 너비 */\r\n    }\r\n    \r\n    .neo2-table th {\r\n        background-color: #f5f5f7;\r\n        color: #000;\r\n        padding: 15px 10px;\r\n        border-bottom: 1px solid #ddd;\r\n        font-size: 14px;\r\n        font-weight: bold;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .neo2-table td {\r\n        padding: 12px 10px;\r\n        border-bottom: 1px solid #eee;\r\n        color: #333;\r\n        text-align: center;\r\n        border-right: 1px solid #f0f0f0;\r\n    }\r\n\r\n    .neo2-table td:first-child { \r\n        text-align: left; \r\n        padding-left: 20px; \r\n        font-weight: 600; \r\n        color: #000; \r\n        background-color: #fafafa;\r\n        border-right: 1px solid #ddd; \r\n    }\r\n    \r\n    .neo2-table td:last-child {\r\n        border-right: none;\r\n    }\r\n\r\n    /* 모바일 반응형 */\r\n    @media screen and (max-width: 768px) {\r\n        .neo2-section { padding: 40px 15px; }\r\n        .neo2-title { font-size: 26px; }\r\n        .neo2-subtitle { font-size: 15px; }\r\n        .neo2-desc { font-size: 15px; }\r\n    }\r\n</style>\r\n\r\n\r\n\r\n<div class=\"neo2-wrapper\">\r\n\r\n    <section class=\"neo2-section\" style=\"border-bottom: none; padding-bottom: 0;\">\r\n        <h3 class=\"neo2-subtitle\">DJI NEO 2</h3>\r\n        <h1 class=\"neo2-title\">나만의 플라잉 카메라맨</h1>\r\n        <p class=\"neo2-desc\">손바닥 위에서 시작되는 놀라운 비행 경험.</p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/dji%20neo2/1.jpg\" class=\"neo2-full-img\" alt=\"01_메인비주얼\">\r\n    </section>\r\n\r\n    <section class=\"neo2-section\">\r\n        <h2 class=\"neo2-title\">영상으로 만나는 <span class=\"neo2-highlight\">Neo 2</span></h2>\r\n        <div class=\"neo2-video-container\">\r\n            <iframe src=\"https://www.youtube.com/embed/1mXwci-_uWc?rel=0&amp;modestbranding=1\" title=\"DJI Neo 2 Introduction\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\">\r\n            </iframe>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"neo2-section\">\r\n        <h2 class=\"neo2-title\">DJI Neo 2를 선택해야 하는<br>6가지 이유</h2>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/dji%20neo2/2.jpg\" class=\"neo2-full-img\" alt=\"02_6가지특징\">\r\n    </section>\r\n\r\n    <section class=\"neo2-section\">\r\n        <h3 class=\"neo2-subtitle\">SAFETY &amp; CONTROL</h3>\r\n        <h2 class=\"neo2-title\">안전하고 손쉽게, <br>자신 있게 비행하세요</h2>\r\n        <p class=\"neo2-desc\">\r\n            전방위 장애물 감지 시스템과 풀 커버 프로펠러 가드로<br>\r\n            초보자도 안심하고 비행할 수 있습니다.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/dji%20neo2/3.jpg\" class=\"neo2-full-img\" alt=\"03_안전기능\">\r\n    </section>\r\n\r\n    <section class=\"neo2-section\">\r\n        <h3 class=\"neo2-subtitle\">INTELLIGENT FLIGHT</h3>\r\n        <h2 class=\"neo2-title\">빠르고 안정적이며 <br>간편한 촬영</h2>\r\n        <p class=\"neo2-desc\">\r\n            향상된 ActiveTrack으로 당신의 움직임을 놓치지 않고 따라갑니다.<br>\r\n            실내외 어디서든 안정적인 호버링을 경험하세요.\r\n        </p>\r\n        <img src=\"http://dronetr7262.godomall.com/data/goods/260115/dji%20neo2/4.jpg\" class=\"neo2-full-img\" alt=\"04_트래