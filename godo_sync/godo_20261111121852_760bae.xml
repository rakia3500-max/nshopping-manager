 #888; }\r\n.faq-item.open .faq-icon { transform: rotate(45deg); color: #111; }\r\n.faq-ans { display: none; padding: 0 0 14px; font-size: 13px; color: #444; line-height: 1.8; }\r\n.faq-item.open .faq-ans { display: block; }\r\n\r\n/* 스펙표 */\r\n.spec-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 0 -16px; padding: 0 16px; }\r\n.spec-table { width: 100%; border-collapse: collapse; font-size: 12px; min-width: 360px; }\r\n.spec-table th { background: #f7f8fa; border: 1px solid #e0e0e0; padding: 8px 10px; text-align: left; font-weight: 600; color: #333; width: 38%; vertical-align: top; word-break: keep-all; }\r\n.spec-table td { border: 1px solid #e0e0e0; padding: 8px 10px; color: #222; line-height: 1.6; vertical-align: top; word-break: break-all; }\r\n.spec-table .cat-row th { background: #111; color: #fff; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; }\r\n.spec-table .cat-row th[colspan] { width: auto; }\r\n.spec-section { margin-bottom: 24px; }\r\n\r\n/* 반응형 */\r\n@media (max-width: 768px) {\r\n  .ai-section { padding: 40px 14px; }\r\n  .ai-section-title { font-size: 18px; }\r\n  .recommend-grid { grid-template-columns: 1fr 1fr; gap: 10px; }\r\n}\r\n@media (max-width: 480px) {\r\n  .ai-section { padding: 32px 12px; }\r\n  .ai-section-title { font-size: 16px; }\r\n  .recommend-card { padding: 12px 10px; }\r\n  .recommend-card .icon { font-size: 20px; }\r\n  .recommend-card .target-name { font-size: 11px; }\r\n  .recommend-card .target-desc { font-size: 11px; }\r\n  .compare-table { font-size: 11px; min-width: 460px; }\r\n  .compare-table th, .compare-table td { padding: 7px 6px; }\r\n  .howto-q { font-size: 13px; }\r\n  .howto-a { font-size: 12px; }\r\n  .faq-btn { font-size: 13px; padding: 13px 0; }\r\n  .faq-ans { font-size: 12px; }\r\n  .spec-table { font-size: 11px; }\r\n  .spec-table th, .spec-table td { padding: 7px 8px; }\r\n}\r\n@media (max-width: 360px) {\r\n  .recommend-grid { grid-template-columns: 1fr; }\r\n}\r\n</style>\r\n\r\n\r\n\r\n<!-- 01 · 히어로샷 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797621/%EA%B7%B8%EB%A6%BC1_dfgzn3.jpg\" alt=\"DJI Mavic 4 Pro 히어로샷 – 트리플 렌즈 플래그십 카메라 드론 설원 비행\" loading=\"eager\" width=\"860\" height=\"1075\">\r\n  <figcaption class=\"blind\">DJI Mavic 4 Pro 제품 비행 이미지. 설원 배경에서 비행 중인 Mavic 4 Pro와 트리플 렌즈 플래그십 카메라 드론 문구.</figcaption>\r\n</figure>\r\n\r\n<!-- 02 · 핵심 요약 7가지 이유 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797622/%EA%B7%B8%EB%A6%BC2_g8g4ml.jpg\" alt=\"DJI Mavic 4 Pro 선택해야 하는 7가지 이유 – 100MP Hasselblad, 대형 CMOS 듀얼 망원, 인피니티 짐벌, 0.1럭스 야경 전방향 감지, 최대 51분 비행, 30km O4+ 전송, 플래그십 조종기\" loading=\"lazy\" width=\"860\" height=\"2150\">\r\n  <figcaption class=\"blind\">Mavic 4 Pro 선택해야 하는 7가지 이유: 100MP Hasselblad 카메라(6K/60fps HDR), 대형 CMOS 듀얼 망원 카메라(12mm 1/1.3인치·1/1.5인치), 인피니티 짐벌(다이내믹한 카메라 움직임), 0.1럭스 야경급 전방향 장애물 감지, 최대 비행시간 51분, 30km 10-bit 영상 전송(O4+), 전문 항공 사진을 위한 플래그십 조종기(17.8cm 회전 디스플레이·접이식 조종 스틱).</figcaption>\r\n</figure>\r\n\r\n<hr class=\"section-divider\">\r\n\r\n<!-- AI-1 · 이런 분께 추천 (02번 직후) -->\r\n<section class=\"ai-section\" itemscope=\"\" itemtype=\"https://schema.org/Article\">\r\n  <meta itemprop=\"name\" content=\"DJI Mavic 4 Pro 추천 대상 가이드\">\r\n  <meta itemprop=\"description\" content=\"DJI Mavic 4 Pro가 꼭 필요한 6가지 타깃 시나리오를 소개합니다.\">\r\n  <meta itemprop=\"keywords\" content=\"드론 추천, 항공 촬영 드론, 촬영용 드론, Mavic 4 Pro 추천\">\r\n  <span class=\"section-badge\">AI-1 · 이런 분께 추천</span>\r\n  <h2 class=\"ai-section-title\">DJI Mavic 4 Pro, 이런 분께 딱 맞습니다</h2>\r\n  <p class=\"ai-section-sub\">100MP Hasselblad · 6K/60fps HDR · 51분 비행 · 30km DJI O4+ · 360° 인피니티 짐벌</p>\r\n  <div class=\"recommend-grid\" itemprop=\"articleBody\">\r\n    <div class=\"recommend-card\">\r\n      <span class=\"icon\">🎬</span>\r\n      <p class=\"target-name\">프로 영상 크리에이터</p>\r\n      <p class=\"target-desc\">6K/60fps HDR 동영상과 10-bit D-Log M으로 영화 같은 색감을 구현합니다. All-I 인코딩으로 후반 편집 워크플로를 크게 단축할 수 있습니다.</p>\r\n    </div>\r\n    <div class=\"recommend-card\">\r\n      <span class=\"icon\">📸</span>\r\n      <p class=\"target-name\">항공 사진 전문가</p>\r\n      <p class=\"target-desc\">4/3인치 CMOS Hasselblad로 100MP RAW 사진을 촬영합니다. 26·70·168mm 3가지 초점 거리로 다양한 피사체를 최고 화질로 담습니다.</p>\r\n    </div>\r\n    <div class=\"recommend-card\">\r\n      <span class=\"icon\">🏔️</span>\r\n      <p class=\"target-name\">익스트림·탐험 촬영자</p>\r\n      <p class=\"target-desc\">51분 비행·41km 범위로 외딴 장소도 커버합니다. 0.1럭스 야경급 전방향 감지로 어두운 환경에서도 안전하게 비행합니다.</p>\r\n    </div>\r\n    <div class=\"recommend-card\">\r\n      <span class=\"icon\">🏙️</span>\r\n      <p class=\"target-name\">부동산·건축 촬영</p>\r\n      <p class=\"target-desc\">168mm 망원으로 건물 디테일을 안전한 거리에서 촬영합니다. 360° 인피니티 짐벌과 70° 상향 촬영으로 독특한 건축 앵글을 자유롭게 포착합니다.</p>\r\n    </div>\r\n    <div class=\"recommend-card\">\r\n      <span class=\"icon\">🎭</span>\r\n      <p class=\"target-name\">영화·광고 제작팀</p>\r\n      <p class=\"target-desc\">ActiveTrack 360°로 어두운 환경에서도 영화 같은 트래킹이 가능합니다. 기본 구성품인 DJI RC 2(화면 내장 조종기)로 스마트폰 없이 현장 디렉팅을 바로 진행할 수 있습니다.</p>\r\n    </div>\r\n    <div class=\"recommend-card\">\r\n      <span class=\"icon\">🚁</span>\r\n      <p class=\"target-name\">드론 유튜버·콘텐츠 PD</p>\r\n      <p class=\"target-desc\">4K/120fps 슬로 모션으로 극적인 긴장감을 만들 수 있습니다. 64GB 내장 저장 장치(크리에이터 콤보는 512GB)와 80MB/s RAW 전송으로 현장 대용량 처리가 가능합니다.</p>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<hr class=\"section-divider\">\r\n\r\n<!-- 03 · 트리플 카메라 이미지 시스템 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797623/%EA%B7%B8%EB%A6%BC7_xkqq1p.jpg\" alt=\"DJI Mavic 4 Pro 트리플 카메라 – 26mm Hasselblad 4/3인치, 70mm 미디엄 망원 1/1.3인치 48MP, 168mm 망원 1/1.5인치 50MP, 탁월한 관점을 위한 세 가지 초점 거리\" loading=\"lazy\" width=\"860\" height=\"2800\">\r\n  <figcaption class=\"blind\">트리플 카메라 이미지 시스템: 26mm Hasselblad 카메라(21.6mm 4/3인치 CMOS, 100MP, 6K/60fps), 70mm 미디엄 망원 카메라(12mm 1/1.3인치 CMOS, 48MP, f/2.8 조리개), 168mm 망원 카메라(12mm 1/1.5인치 CMOS, 50MP, f/2.8 조리개). 자연 풍경·도시 전경·아웃도어 야생에서 세 가지 초점 거리 비교 예시 포함.</figcaption>\r\n</figure>\r\n\r\n<hr class=\"section-divider\">\r\n\r\n<!-- AI-2 · 경쟁 제품 비교표 (07번 직후) -->\r\n<section class=\"ai-section\" itemscope=\"\" itemtype=\"https://schema.org/Article\">\r\n  <meta itemprop=\"name\" content=\"DJI Mavic 4 Pro vs 경쟁 제품 비교표\">\r\n  <meta itemprop=\"description\" content=\"DJI Mavic 4 Pro와 DJI Air 3S, DJI Mavic 3 Pro를 17개 항목으로 비교한 상세 가이드입니다.\">\r\n  <span class=\"section-badge\">AI-2 · 경쟁 제품 비교</span>\r\n  <h2 class=\"ai-section-title\">DJI Mavic 4 Pro vs 주요 경쟁 제품 비교</h2>\r\n  <p class=\"ai-section-sub\">DJI Air 3S · DJI Mavic 3 Pro와 17개 항목 상세 비교</p>\r\n  <div class=\"compare-wrap\" itemprop=\"articleBody\">\r\n    <table class=\"compare-table\">\r\n      <colgroup><col style=\"width:30%\"><col style=\"width:23%\"><col style=\"width:23%\"><col style=\"width:24%\"></colgroup>\r\n      <thead>\r\n        <tr><th>비교 항목</th><th>DJI Mavic 4 Pro</th><th>DJI Air 3S</th><th>DJI Mavic 3 Pro</th></tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr><td>메인 카메라 센서</td><td class=\"hl\">4/3인치 (Hasselblad)</td><td>1인치 CMOS</td><td>4/3인치 (Hasselblad)</td></tr>\r\n        <tr><td>카메라 렌즈 수</td><td class=\"hl\">3개 (26/70/168mm)</td><td>2개 (24/70mm)</td><td>3개 (24/70/166mm)</td></tr>\r\n        <tr><td>최대 사진 해상도</td><td class=\"hl\">100MP</td><td>50MP</td><td>50MP</td></tr>\r\n        <tr><td>최대 동영상 해상도</td><td class=\"hl\">6K/60fps HDR</td><td>6K/30fps</td><td>5.1K/50fps</td></tr>\r\n        <tr><td>슬로 모션</td><td class=\"hl\">4K/120fps</td><td>4K/120fps</td><td>4K/60fps</td></tr>\r\n        <tr><td>색상 심도</td><td class=\"hl\">10-bit D-Log M · All-I</td><td>10-bit D-Log M</td><td>10-bit D-Log M</td></tr>\r\n        <tr><td>짐벌 회전 범위</td><td class=\"hl\">360° 인피니티 짐벌</td><td>-90°~+35°</td><td>-90°~+35°</td></tr>\r\n        <tr><td>상향 촬영</td><td class=\"hl\">70° 상향 가능</td><td class=\"no\">불가</td><td class=\"no\">불가</td></tr>\r\n        <tr><td>최대 비행시간</td><td class=\"hl\">51분</td><td>45분</td><td>43분</td></tr>\r\n        <tr><td>최대 비행 범위</td><td class=\"hl\">41km</td><td>32km</td><td>28km</td></tr>\r\n        <tr><td>영상 전송 시스템</td><td class=\"hl\">DJI O4+ (30km 10-bit HDR)</td><td>DJI O4+ (20km)</td><td>DJI O3+ (15km)</td></tr>\r\n        <tr><td>야간 장애물 감지</td><td class=\"hl ok\">0.1럭스 전방향 LiDAR</td><td class=\"no\">제한적</td><td class=\"no\">전방 기본</td></tr>\r\n        <tr><td>ActiveTrack</td><td class=\"ok\">ActiveTrack 360°</td><td class=\"ok\">ActiveTrack 360°</td><td class=\"ok\">ActiveTrack 5.0</td></tr>\r\n        <tr><td>내장 저장 용량</td><td class=\"hl\">64GB (크리에이터 512GB)</td><td>없음</td><td>없음</td></tr>\r\n        <tr><td>병렬 충전 허브</td><td class=\"hl\">콤보 구성품 (단품 미포함)</td><td class=\"no\">미포함</td><td class=\"no\">미포함</td></tr>\r\n        <tr><td>조종기</td><td class=\"hl\">DJI RC 2 (이 상품) · RC Pro 2는 크리에이터 콤보</td><td>DJI RC 2</td><td>DJI RC Pro</td></tr>\r\n        <tr><td>RAW 전송 속도</td><td class=\"hl\">80MB/s</td><td>—</td><td>—</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n  <p class=\"compare-summary\">DJI Mavic 4 Pro는 360° 인피니티 짐벌과 70° 상향 촬영이라는 전례 없는 기능으로 경쟁 제품과 확실히 차별화됩니다. 51분 비행시간과 41km 비행 범위는 Air 3S 대비 각각 13%·28% 더 길며, 0.1럭스 야경급 전방향 LiDAR 장애물 감지는 소비자 드론 중 독보적인 플래그십 기능입니다.</p>\r\n</section>\r\n\r\n<hr class=\"section-divider\">\r\n\r\n<!-- 04 · 프로급 비디오 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797623/%EA%B7%B8%EB%A6%BC8_meik3f.jpg\" alt=\"DJI Mavic 4 Pro 프로급 비디오 – 6K/60fps HDR, 4K/120fps 슬로 모션, 10-bit D-Log All-I 인코딩\" loading=\"lazy\" width=\"860\" height=\"2365\">\r\n  <figcaption class=\"blind\">프로급 비디오: 6K/60fps HDR(약 16스톱 다이내믹 레인지), 미디엄 망원 4K/60fps HDR(14스톱), 망원 4K/60fps HDR(13스톱). 4K/120fps 슬로 모션 동영상(Hasselblad 메인·미디엄 망원 카메라, 망원 4K/100fps). 10비트 D-Log &amp; All-I 인코딩으로 10억 가지 컬러 캡처 지원.</figcaption>\r\n</figure>\r\n\r\n<!-- 05 · 인피니티 짐벌 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797622/%EA%B7%B8%EB%A6%BC6_fnrjri.jpg\" alt=\"DJI Mavic 4 Pro 360° 인피니티 짐벌 – 360° 회전, 70° 상향 촬영, 프라임 빌드로 보이지 않는 것을 포착\" loading=\"lazy\" width=\"860\" height=\"2150\">\r\n  <figcaption class=\"blind\">프라임 빌드로 보이지 않는 것을 포착: 360° 회전 인피니티 짐벌(혁신적인 짐벌 구조로 70° 상향 촬영 가능, 360° 회전으로 유연하고 중력을 거스르는 항공 스토리텔링). 360° 회전: 유연하고 중력을 거스르는 움직임. 70° 상향 촬영: 대담하고 역동적인 시각으로 산과 건축의 경이로움을 포착.</figcaption>\r\n</figure>\r\n\r\n<!-- 06 · 안전·추적 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797622/%EA%B7%B8%EB%A6%BC4_c21xd8.jpg\" alt=\"DJI Mavic 4 Pro 안전 비행 – ActiveTrack 360°, 0.1럭스 야경급 전방향 장애물 감지, 야간 RTH, 비 GPS RTH\" loading=\"lazy\" width=\"860\" height=\"2800\">\r\n  <figcaption class=\"blind\">선명한 비전, 부드러운 비행: ActiveTrack 360°(황혼·도시 조명 같은 어두운 환경에서도 영화 같은 트래킹, 차량 추적 최대 200미터). 0.1럭스 야경급 전방향 비전으로 모든 방향을 감지(고성능 저조도 센서 6개·듀얼 프로세서, 전방향 LiDAR로 장애물 자동 회피). 야간 RTH(저조도에서도 건물 같은 높은 장애물 감지 후 안전 귀환). 비 GPS RTH(위성 신호 없는 위치에서도 안전 복귀).</figcaption>\r\n</figure>\r\n\r\n<!-- 07 · 비행 성능 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797622/%EA%B7%B8%EB%A6%BC5_gtnarj.jpg\" alt=\"DJI Mavic 4 Pro 비행 성능 – 최대 비행시간 51분, 비행 범위 41km, DJI O4+ 30km 10-bit HDR 전송\" loading=\"lazy\" width=\"860\" height=\"2000\">\r\n  <figcaption class=\"blind\">연결된 채로, 더 긴 비행: 최대 비행시간 51분(장소 탐색·카메라 움직임·타임랩스 녹화에 충분). 비행 범위 비교: Mavic 4 Pro 41km, Air 3S 32km, Mavic 3 Pro 28km. DJI O4+ 10비트 HDR 동영상 전송(최대 30km 초장거리, 도시 구역 간섭 환경에서 연결 안정성).</figcaption>\r\n</figure>\r\n\r\n<hr class=\"section-divider\">\r\n\r\n<!-- AI-3 · 입문자 구매 가이드 (05번 직후) -->\r\n<section class=\"ai-section\" itemscope=\"\" itemtype=\"https://schema.org/HowTo\">\r\n  <meta itemprop=\"name\" content=\"DJI Mavic 4 Pro 입문자 구매 가이드 5단계\">\r\n  <meta itemprop=\"description\" content=\"드론이 처음인 분을 위한 DJI Mavic 4 Pro 구매 전 필수 확인 가이드입니다.\">\r\n  <meta itemprop=\"totalTime\" content=\"PT5M\">\r\n  <span class=\"section-badge\">AI-3 · 입문자 구매 가이드</span>\r\n  <h2 class=\"ai-section-title\">드론 처음이신가요? 구매 전 꼭 읽어보세요</h2>\r\n  <p class=\"ai-section-sub\">DJI Mavic 4 Pro 구매 결정에 도움이 되는 5가지 핵심 질문</p>\r\n  <ol class=\"howto-list\" itemprop=\"step\">\r\n    <li class=\"howto-item\" itemscope=\"\" itemtype=\"https://schema.org/HowToStep\">\r\n      <div class=\"howto-num\">1</div>\r\n      <div>\r\n        <p class=\"howto-q\" itemprop=\"name\">드론을 구매하면 바로 날릴 수 있나요? 자격증이 필요한가요?</p>\r\n        <p class=\"howto-a\" itemprop=\"text\">Mavic 4 Pro는 249g을 초과하므로 한국에서 초경량비행장치 신고 및 비행 승인이 필요할 수 있습니다. 사업 목적이라면 4종 이상 자격증이 필요하며, DJI Fly 앱에서 비행 가능 구역을 사전 확인하는 것을 권장합니다.</p>\r\n      </div>\r\n    </li>\r\n    <li class=\"howto-item\" itemscope=\"\" itemtype=\"https://schema.org/HowToStep\">\r\n      <div class=\"howto-num\">2</div>\r\n      <div>\r\n        <p class=\"howto-q\" itemprop=\"name\">어떤 패키지를 선택해야 하나요? 단품과 콤보의 차이는?</p>\r\n        <p class=\"howto-a\" itemprop=\"text\">단품은 처음 드론을 접하거나 간단한 촬영 목적에 적합합니다. 플라이 모어 콤보는 배터리 추가와 병렬 충전 허브가 포함되어 장시간 촬영에 유용합니다. 512GB 크리에이터 콤보는 All-I 4:2:2 10비트 인코딩과 대용량 내장 저장 장치가 필요한 전문가에게 권장합니다.</p>\r\n      </div>\r\n    </li>\r\n    <li class=\"howto-item\" itemscope=\"\" itemtype=\"https://schema.org/HowToStep\">\r\n      <div class=\"howto-num\">3</div>\r\n      <div>\r\n        <p class=\"howto-q\" itemprop=\"name\">카메라 3개 중 어떤 것을 주로 사용하게 되나요?</p>\r\n        <p class=\"howto-a\" itemprop=\"text\">26mm Hasselblad 메인 카메라를 가장 많이 사용하게 됩니다. 인물·야생 동물 등 가까이 다가가기 어려운 피사체에는 70mm, 원거리 건축물 디테일에는 168mm를 사용합니다. 세 카메라 모두 10비트 색상 프로파일을 지원해 후보정 호환성이 일관됩니다.</p>\r\n      </div>\r\n    </li>\r\n    <li class=\"howto-item\" itemscope=\"\" itemtype=\"https://schema.org/HowToStep\">\r\n      <div class=\"howto-num\">4</div>\r\n      <div>\r\n        <p class=\"howto-q\" itemprop=\"name\">초보자도 안전하게 날릴 수 있나요?</p>\r\n        <p class=\"howto-a\" itemprop=\"text\">고성능 저조도 센서 6개와 전방향 LiDAR로 어두운 환경에서도 장애물을 자동 회피합니다. 야간 RTH와 비 GPS RTH 기능이 있어 다양한 환경에서 안전하게 복귀합니다. 첫 비행은 넓은 개활지에서 연습하기를 권장합니다.</p>\r\n      </div>\r\n    </li>\r\n    <li class=\"howto-item\" itemscope=\"\" itemtype=\"https://schema.org/HowToStep\">\r\n      <div class=\"howto-num\">5</div>\r\n      <div>\r\n        <p class=\"howto-q\" itemprop=\"name\">DJI RC Pro 2와 일반 조종기 중 어떤 것이 더 좋은가요?</p>\r\n        <p class=\"howto-a\" itemprop=\"text\">DJI RC Pro 2는 스마트폰 없이도 단독으로 사용 가능한 통합 조종기입니다. 7인치 고휘도 미니 LED 화면으로 직사광선 아래에서도 화면 확인이 쉽고, 접이식 디자인으로 현장 출동이 빠릅니다. 이 상품(단품)에는 DJI RC 2가 들어 있습니다. RC Pro 2는 크리에이터 콤보에 포함되며, 따로 구매할 수도 있습니다.</p>\r\n      </div>\r\n    </li>\r\n  </ol>\r\n</section>\r\n\r\n<hr class=\"section-divider\">\r\n\r\n<!-- 08 · 운용 효율 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797622/%EA%B7%B8%EB%A6%BC3_jlhvhd.jpg\" alt=\"DJI Mavic 4 Pro 운용 효율 – 빠른 가동, 병렬 충전 허브 90분 3개 충전, 64GB·512GB 내장 메모리, 80MB/s RAW 전송\" loading=\"lazy\" width=\"860\" height=\"2800\">\r\n  <figcaption class=\"blind\">간단하고 효율적으로: 빠른 가동·더 빠른 준비(펼쳐서 전원 켜면 즉시 비행 준비, DJI RC Pro 2 조종기 확장). 효율적인 병렬 충전으로 창의력 높이기(DJI Mavic 240W 전원 어댑터·병렬 충전 허브 90분에 배터리 3개 완충, Air 3S 약 180분·Mavic 3 Pro 약 210분 대비 압도적으로 빠름). 내장 저장 장치로 바로 시작(64GB eMMC 표준·512GB UFS 크리에이터 버전, All-I 4:2:2 인코딩). 100MP RAW 초고속 전송(DJI Fly 앱 또는 데이터 케이블로 80MB/s 전송).</figcaption>\r\n</figure>\r\n\r\n<!-- 09 · 액세서리 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797623/%EA%B7%B8%EB%A6%BC9_uyzvnu.jpg\" alt=\"DJI Mavic 4 Pro 별매 액세서리 – RC Pro 2 조종기, 인텔리전트 플라이트 배터리, 병렬 충전 허브, 240W 전원 어댑터\" loading=\"lazy\" width=\"860\" height=\"2150\">\r\n  <figcaption class=\"blind\">별매 액세서리 — 내 장비로 직접 디렉팅: DJI RC Pro 2 조종기(접이식 통합 디자인, 7인치 고휘도 미니 LED 화면, DJI Mic 시리즈 직접 호환). DJI Mavic 4 Pro 인텔리전트 플라이트 배터리(최대 51분 비행). DJI Mavic 4 Pro 병렬 충전 허브(240W 어댑터와 함께 배터리 1개 51분·3개 동시 90분 충전). DJI Mavic 240W 전원 어댑터(배터리·조종기 동시 고속 충전, USB-C 포트 모바일 기기 충전).</figcaption>\r\n</figure>\r\n\r\n<hr class=\"section-divider\">\r\n\r\n<!-- AI-4 · 확장 FAQ (09번 직후) -->\r\n<section class=\"ai-section\">\r\n  <span class=\"section-badge\">AI-4 · 확장 FAQ</span>\r\n  <h2 class=\"ai-section-title\">구매 전 자주 묻는 질문</h2>\r\n  <p class=\"ai-section-sub\">제품 기본 FAQ에서 다루지 않은 추가 질문 9개</p>\r\n  <div itemscope=\"\" itemtype=\"https://schema.org/FAQPage\">\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-btn\" aria-expanded=\"false\" onclick=\"toggleFaq(this)\"><span itemprop=\"name\">DJI Mavic 4 Pro 배터리를 비행기에 가지고 탈 수 있나요?</span><span class=\"faq-icon\">+</span></button>\r\n      <div class=\"faq-ans\" itemprop=\"acceptedAnswer\" itemscope=\"\" itemtype=\"https://schema.org/Answer\"><span itemprop=\"text\">인텔리전트 플라이트 배터리는 약 96.48Wh로 100Wh 이하 조건에 해당합니다. 기내 수하물로 반입 가능하나 항공사마다 허용 개수 제한이 있을 수 있으므로 출발 전 해당 항공사 리튬이온 배터리 정책을 반드시 확인하세요.</span></div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-btn\" aria-expanded=\"false\" onclick=\"toggleFaq(this)\"><span itemprop=\"name\">해외 여행지에서 DJI Mavic 4 Pro를 날릴 수 있나요?</span><span class=\"faq-icon\">+</span></button>\r\n      <div class=\"faq-ans\" itemprop=\"acceptedAnswer\" itemscope=\"\" itemtype=\"https://schema.org/Answer\"><span itemprop=\"text\">국가마다 드론 비행 규정이 다르므로 방문 국가의 항공 당국 규정을 사전에 확인해야 합니다. 일부 국가에서는 드론 등록, 조종사 자격증, 비행 허가가 필요하며 DJI Fly 앱에서 비행 제한 구역을 확인할 수 있습니다.</span></div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-btn\" aria-expanded=\"false\" onclick=\"toggleFaq(this)\"><span itemprop=\"name\">DJI Mavic 4 Pro의 A/S 보증 기간은 어떻게 되나요?</span><span class=\"faq-icon\">+</span></button>\r\n      <div class=\"faq-ans\" itemprop=\"acceptedAnswer\" itemscope=\"\" itemtype=\"https://schema.org/Answer\"><span itemprop=\"text\">구매일로부터 1년간 제조사 보증이 제공됩니다. DJI Care Refresh 가입 시 충돌·추락·수몰 사고에 대해 연 2회까지 교환 서비스를 받을 수 있습니다. 드론박스 구매 시 정품 인증서가 발급됩니다.</span></div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-btn\" aria-expanded=\"false\" onclick=\"toggleFaq(this)\"><span itemprop=\"name\">바람이 강한 날에도 안전하게 비행할 수 있나요?</span><span class=\"faq-icon\">+</span></button>\r\n      <div class=\"faq-ans\" itemprop=\"acceptedAnswer\" itemscope=\"\" itemtype=\"https://schema.org/Answer\"><span itemprop=\"text\">최대 내풍 속도는 약 12m/s(4~5급 바람)입니다. 강한 바람에서는 배터리 소모가 빨라져 실제 비행시간이 짧아집니다. DJI Fly 앱의 기상 알림을 확인하고 비행 전 현지 풍속을 체크하세요.</span></div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-btn\" aria-expanded=\"false\" onclick=\"toggleFaq(this)\"><span itemprop=\"name\">인피니티 짐벌 360° 회전은 영상 촬영 중에도 작동하나요?</span><span class=\"faq-icon\">+</span></button>\r\n      <div class=\"faq-ans\" itemprop=\"acceptedAnswer\" itemscope=\"\" itemtype=\"https://schema.org/Answer\"><span itemprop=\"text\">네, 영상 녹화 중에도 360° 회전이 가능합니다. 혁신적인 짐벌 구조로 중력을 거스르는 자유로운 움직임으로 항공 스토리텔링을 새롭게 구상할 수 있습니다. 전용 촬영 모드에서 지원됩니다.</span></div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-btn\" aria-expanded=\"false\" onclick=\"toggleFaq(this)\"><span itemprop=\"name\">DJI Mavic 4 Pro는 비가 오는 날에도 날릴 수 있나요?</span><span class=\"faq-icon\">+</span></button>\r\n      <div class=\"faq-ans\" itemprop=\"acceptedAnswer\" itemscope=\"\" itemtype=\"https://schema.org/Answer\"><span itemprop=\"text\">공식 방수·방진 등급이 명시되어 있지 않습니다. 강우·강설·안개 등 습한 환경에서의 비행은 기체 손상의 원인이 될 수 있으므로 권장하지 않습니다. 부득이하게 습한 환경에서 비행한 경우 기체를 완전히 건조한 후 보관하세요.</span></div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-btn\" aria-expanded=\"false\" onclick=\"toggleFaq(this)\"><span itemprop=\"name\">스마트폰 없이 DJI RC Pro 2만으로 비행할 수 있나요?</span><span class=\"faq-icon\">+</span></button>\r\n      <div class=\"faq-ans\" itemprop=\"acceptedAnswer\" itemscope=\"\" itemtype=\"https://schema.org/Answer\"><span itemprop=\"text\">네, DJI RC Pro 2는 스마트폰 없이 단독으로 사용 가능한 통합 조종기입니다(크리에이터 콤보 구성품·별매). 이 상품에 들어 있는 DJI RC 2도 화면 내장형이라 스마트폰 없이 비행할 수 있습니다. 7인치 고휘도 미니 LED 내장 화면으로 실시간 영상 피드를 확인할 수 있으며, DJI Fly 앱이 조종기에 내장되어 있습니다.</span></div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-btn\" aria-expanded=\"false\" onclick=\"toggleFaq(this)\"><span itemprop=\"name\">병렬 충전 허브로 배터리 3개를 충전하면 얼마나 걸리나요?</span><span class=\"faq-icon\">+</span></button>\r\n      <div class=\"faq-ans\" itemprop=\"acceptedAnswer\" itemscope=\"\" itemtype=\"https://schema.org/Answer\"><span itemprop=\"text\">240W 전원 어댑터와 함께 사용 시 배터리 1개는 약 51분, 3개 동시는 약 90분이 소요됩니다. Air 3S 약 180분, Mavic 3 Pro 약 210분과 비교해 획기적으로 빠른 충전 속도입니다.</span></div>\r\n    </div>\r\n\r\n    <div class=\"faq-item\" itemscope=\"\" itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\r\n      <button class=\"faq-btn\" aria-expanded=\"false\" onclick=\"toggleFaq(this)\"><span itemprop=\"name\">ActiveTrack 360°로 어떤 피사체를 추적할 수 있나요?</span><span class=\"faq-icon\">+</span></button>\r\n      <div class=\"faq-ans\" itemprop=\"acceptedAnswer\" itemscope=\"\" itemtype=\"https://schema.org/Answer\"><span itemprop=\"text\">사람, 차량, 반려동물을 자동으로 인식하고 추적합니다. 어두운 환경과 피사체가 부분적으로 가려진 상황에서도 포커스를 유지하며, 차량은 최대 200미터까지 감지합니다.</span></div>\r\n    </div>\r\n\r\n  </div>\r\n</section>\r\n\r\n<hr class=\"section-divider\">\r\n\r\n<!-- 10 · 주의사항 -->\r\n<figure class=\"img-section\">\r\n  <img src=\"https://res.cloudinary.com/dpchtcord/image/upload/v1773797623/%EA%B7%B8%EB%A6%BC10_hysmu3.jpg\" alt=\"DJI Mavic 4 Pro 사용 주의사항 및 법규 안내\" loading=\"lazy\" width=\"860\" height=\"3200\">\r\n  <figcaption class=\"blind\">DJI Mavic 4 Pro 사용 시 주의사항: 현지 법률·규정 준수 의무, 비행 전 자격증 및 공역 허가 취득, 