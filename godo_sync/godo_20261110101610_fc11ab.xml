<table style='border-collapse:collapse; width:100%;'>
<tr><th style='padding:10px 14px; border:1px solid #E3E6EB; font-size:15px; text-align:left; background:#F7F8FA; width:34%;'>호환 기종</th><td style='padding:10px 14px; border:1px solid #E3E6EB; font-size:15px; text-align:left;'>DJI Zenmuse H30T 카메라</td></tr>
<tr><th style='padding:10px 14px; border:1px solid #E3E6EB; font-size:15px; text-align:left; background:#F7F8FA; width:34%;'>필터 종류</th><td style='padding:10px 14px; border:1px solid #E3E6EB; font-size:15px; text-align:left;'>ND (Neutral Density) 필터</td></tr>
